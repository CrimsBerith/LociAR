{
  "sourceLanguage" : "en",
  "strings" : {
    "GeospatialAccuracy" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR, AR postlarını harita ve cadde üzerinde tam doğrulukla yerleştirebilmek için geçici hassas konum iznine ihtiyaç duyar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR needs temporary precise location to place AR posts accurately on the map and the street."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR benötigt vorübergehend den genauen Standort, um AR-Posts präzise auf der Karte und auf der Straße zu platzieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR necesita temporalmente tu ubicación precisa para colocar las publicaciones AR con exactitud en el mapa y en la calle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR a besoin de votre position précise de façon temporaire pour placer les publications RA avec exactitude sur la carte et dans la rue."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LociAR precisa da localização precisa temporariamente para posicionar as publicações de RA com exatidão no mapa e na rua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR нужен временный доступ к точному местоположению, чтобы точно размещать AR-посты на карте и на улице."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج LociAR إلى إذن مؤقت بالموقع الدقيق لوضع منشورات الواقع المعزز بدقة على الخريطة وفي الشارع."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AR पोस्ट को मैप और सड़क पर सटीक रूप से रखने के लिए LociAR को अस्थायी रूप से सटीक स्थान की अनुमति चाहिए।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মানচিত্রে ও রাস্তায় AR পোস্ট নির্ভুলভাবে স্থাপন করতে LociAR-এর সাময়িকভাবে নির্ভুল অবস্থানের অনুমতি প্রয়োজন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociARは、AR投稿をマップや通りの上に正確に配置するために、一時的に正確な位置情報を必要とします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR 需要临时使用精确位置，以便将 AR 帖子准确放置在地图和街道上。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR, gerçek yüzeyleri algılamak ve postları sabitlemek için kamerayı kullanır. Görsel özellik verileri Google ARCore ile güvenli biçimde işlenir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR uses the camera to detect real surfaces and pin posts to them. Visual feature data is processed securely by Google ARCore."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR nutzt die Kamera, um echte Flächen zu erkennen und Posts daran zu verankern. Visuelle Merkmalsdaten werden sicher von Google ARCore verarbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR usa la cámara para detectar superficies reales y fijar publicaciones en ellas. Los datos de rasgos visuales se procesan de forma segura con Google ARCore."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR utilise la caméra pour détecter les surfaces réelles et y fixer des publications. Les données de caractéristiques visuelles sont traitées de manière sécurisée par Google ARCore."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LociAR usa a câmera para detectar superfícies reais e fixar publicações nelas. Os dados de características visuais são processados com segurança pelo Google ARCore."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR использует камеру, чтобы распознавать реальные поверхности и закреплять на них посты. Данные визуальных признаков безопасно обрабатываются Google ARCore."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم LociAR الكاميرا لاكتشاف الأسطح الحقيقية وتثبيت المنشورات عليها. تتم معالجة بيانات الملامح المرئية بأمان عبر Google ARCore."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR असली सतहें पहचानने और उन पर पोस्ट पिन करने के लिए कैमरे का इस्तेमाल करता है। दृश्य विशेषता डेटा Google ARCore द्वारा सुरक्षित रूप से प्रोसेस किया जाता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR বাস্তব পৃষ্ঠ শনাক্ত করতে এবং সেখানে পোস্ট পিন করতে ক্যামেরা ব্যবহার করে। দৃশ্যমান বৈশিষ্ট্যের ডেটা Google ARCore নিরাপদে প্রক্রিয়া করে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociARは、実際の面を検出して投稿を固定するためにカメラを使用します。視覚的な特徴データはGoogle ARCoreで安全に処理されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR 使用相机检测真实表面并将帖子固定在上面。视觉特征数据由 Google ARCore 安全处理。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR, ayrı onayınla kampanya alanına gelince veya son paylaştığın konum alanından çıkınca uygulama kapalıyken de teklif hatırlatmak için alanları izler. Tek konum ölçümü teklifi doğrular; yönetici konumuna eklenmez. Yakındaki işletme notları için de alanlar izlenir. Yakın alanlarda hassas GPS en fazla iki dakika çalışır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With your separate consent, LociAR monitors areas to remind you of offers on arrival or when leaving your last shared location area, even with the app closed. A single fix verifies the offer; it is not added to the administrator location snapshot. Areas are also monitored for nearby business notes. Precise GPS runs near a location for at most two minutes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit deiner gesonderten Zustimmung überwacht LociAR Gebiete, um bei Ankunft oder beim Verlassen deines zuletzt geteilten Standorts auch bei geschlossener App an Angebote zu erinnern. Ein einzelner Standort prüft das Angebot und wird nicht zum Administratorstandort hinzugefügt. Gebiete werden auch für Geschäftsnotizen in der Nähe überwacht. Präzises GPS läuft in der Nähe eines Orts höchstens zwei Minuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con tu consentimiento separado, LociAR vigila zonas para recordar ofertas al llegar o salir de tu última ubicación compartida, incluso con la app cerrada. Una medición verifica la oferta y no se añade a la ubicación del administrador. También se vigilan zonas para las notas de negocios cercanos. El GPS preciso funciona cerca del lugar hasta dos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec votre consentement distinct, LociAR surveille des zones pour rappeler des offres à l’arrivée ou en quittant votre dernière position partagée, même lorsque l’app est fermée. Une mesure vérifie l’offre sans être ajoutée à la position des administrateurs. Des zones sont aussi surveillées pour les notes des commerces proches. Le GPS précis fonctionne à proximité pendant deux minutes maximum."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com seu consentimento separado, o LociAR monitora áreas para lembrar ofertas ao chegar ou sair da última localização compartilhada, mesmo com o app fechado. Uma medição verifica a oferta e não é adicionada à localização do administrador. Áreas também são monitoradas para notas de estabelecimentos próximos. GPS preciso funciona perto do local por até dois minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С вашего отдельного согласия LociAR отслеживает зоны и напоминает о предложениях при прибытии или выходе из последней переданной зоны даже при закрытом приложении. Одно измерение проверяет предложение и не добавляется к геопозиции для администратора. Зоны также отслеживаются для заметок о заведениях поблизости. Точный GPS работает поблизости не более двух минут."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بموافقتك المنفصلة، يراقب LociAR مناطق لتذكيرك بالعروض عند الوصول أو مغادرة آخر موقع شاركته، حتى مع إغلاق التطبيق. تتحقق قراءة واحدة من العرض ولا تُضاف إلى موقع المسؤول. تُراقب المناطق أيضًا لملاحظات المنشآت القريبة. يعمل GPS الدقيق قرب الموقع حتى دقيقتين."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी अलग सहमति से, LociAR ऐप बंद होने पर भी पहुँचने या अंतिम साझा स्थान का क्षेत्र छोड़ने पर ऑफ़र याद दिलाने के लिए क्षेत्रों पर नज़र रखता है। एक स्थान माप ऑफ़र की जाँच करता है; व्यवस्थापक के स्थान रिकॉर्ड में नहीं जुड़ता। पास के व्यवसायों के नोट के लिए भी क्षेत्र देखे जाते हैं। स्थान के पास सटीक GPS अधिकतम दो मिनट चलता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার আলাদা সম্মতিতে, অ্যাপ বন্ধ থাকলেও পৌঁছালে বা শেষ শেয়ার করা অবস্থানের এলাকা ছাড়লে অফার মনে করাতে LociAR এলাকা পর্যবেক্ষণ করে। একটি অবস্থান মাপ দিয়ে অফার যাচাই হয়; প্রশাসকের অবস্থান রেকর্ডে যোগ হয় না। কাছের ব্যবসার নোটের জন্যও এলাকা পর্যবেক্ষণ হয়। স্থানের কাছে নির্ভুল GPS সর্বোচ্চ দুই মিনিট চলে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別途同意すると、LociARはアプリを閉じていても到着時や最後に共有した位置の周辺を離れた際にオファーを通知するためエリアを監視します。1回の位置測定でオファーを確認し、管理者向けの位置記録には追加しません。 近くの店舗のメモのためにもエリアを監視します。 場所の近くでは精密GPSを最長2分間使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经你另行同意，LociAR 会监测区域，即使应用关闭，也会在到达或离开最后共享位置的周边时提醒优惠。仅用一次位置测量验证优惠，不会添加到管理员的位置记录。 也会监测区域以提醒附近商家的留言。 靠近位置时，精确GPS最多运行两分钟。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR, yakındaki AR içeriklerini listelemek ve Google ARCore Geospatial ile doğru konumda görüntülemek için konumunuzu kullanır. Ayrı onayınla uygulama açıkken konumun yetkili yöneticilerle de paylaşılır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR uses your location to list nearby AR content and show it in the right place with Google ARCore Geospatial. With your separate consent, your location is also shared with authorized administrators while the app is open."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR nutzt deinen Standort, um AR-Inhalte in der Nähe aufzulisten und sie mit Google ARCore Geospatial am richtigen Ort anzuzeigen. Mit deiner gesonderten Zustimmung wird dein Standort bei geöffneter App auch mit berechtigten Administratoren geteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR usa tu ubicación para mostrar el contenido AR cercano y situarlo en el lugar correcto con Google ARCore Geospatial. Con tu consentimiento separado, tu ubicación también se comparte con administradores autorizados mientras la app está abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR utilise votre position pour lister les contenus RA à proximité et les afficher au bon endroit avec Google ARCore Geospatial. Avec votre consentement distinct, votre position est aussi partagée avec les administrateurs autorisés lorsque l’app est ouverte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LociAR usa sua localização para listar conteúdos de RA próximos e exibi-los no lugar certo com o Google ARCore Geospatial. Com seu consentimento separado, sua localização também é compartilhada com administradores autorizados enquanto o app está aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR использует ваше местоположение, чтобы показывать AR-контент поблизости и размещать его в нужном месте с помощью Google ARCore Geospatial. С вашего отдельного согласия местоположение также передаётся уполномоченным администраторам, пока приложение открыто."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم LociAR موقعك لعرض محتوى الواقع المعزز القريب وإظهاره في المكان الصحيح باستخدام Google ARCore Geospatial. بموافقتك المنفصلة، يُشارك موقعك أيضًا مع المسؤولين المخوّلين عندما يكون التطبيق مفتوحًا."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR आस-पास की AR सामग्री दिखाने और Google ARCore Geospatial से उसे सही जगह पर दिखाने के लिए आपके स्थान का इस्तेमाल करता है। आपकी अलग सहमति से, ऐप खुला होने पर आपका स्थान अधिकृत व्यवस्थापकों के साथ भी साझा होता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR কাছাকাছি AR কনটেন্ট দেখাতে এবং Google ARCore Geospatial দিয়ে সঠিক জায়গায় প্রদর্শন করতে আপনার অবস্থান ব্যবহার করে। আপনার আলাদা সম্মতিতে, অ্যাপ খোলা থাকলে অবস্থান অনুমোদিত প্রশাসকদের সঙ্গেও শেয়ার করা হয়।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociARは、近くのARコンテンツを一覧表示し、Google ARCore Geospatialで正しい場所に表示するために位置情報を使用します。 別途同意すると、アプリを開いている間、位置情報が権限のある管理者にも共有されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR 使用你的位置列出附近的 AR 内容，并通过 Google ARCore Geospatial 将其显示在正确的位置。 另行同意后，应用打开时也会与获授权的管理员共享你的位置。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}

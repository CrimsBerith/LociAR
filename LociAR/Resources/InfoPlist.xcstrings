  "strings" : {
    "GeospatialAccuracy" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR, AR postlarını harita ve cadde üzerinde tam doğrulukla yerleştirebilmek için geçici hassas konum iznine ihtiyaç duyar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR needs temporary precise location to place AR posts accurately on the map and the street."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR benötigt vorübergehend den genauen Standort, um AR-Posts präzise auf der Karte und auf der Straße zu platzieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR necesita temporalmente tu ubicación precisa para colocar las publicaciones AR con exactitud en el mapa y en la calle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR a besoin de votre position précise de façon temporaire pour placer les publications RA avec exactitude sur la carte et dans la rue."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LociAR precisa da localização precisa temporariamente para posicionar as publicações de RA com exatidão no mapa e na rua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR нужен временный доступ к точному местоположению, чтобы точно размещать AR-посты на карте и на улице."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج LociAR إلى إذن مؤقت بالموقع الدقيق لوضع منشورات الواقع المعزز بدقة على الخريطة وفي الشارع."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AR पोस्ट को मैप और सड़क पर सटीक रूप से रखने के लिए LociAR को अस्थायी रूप से सटीक स्थान की अनुमति चाहिए।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মানচিত্রে ও রাস্তায় AR পোস্ট নির্ভুলভাবে স্থাপন করতে LociAR-এর সাময়িকভাবে নির্ভুল অবস্থানের অনুমতি প্রয়োজন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociARは、AR投稿をマップや通りの上に正確に配置するために、一時的に正確な位置情報を必要とします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR 需要临时使用精确位置，以便将 AR 帖子准确放置在地图和街道上。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR, gerçek yüzeyleri algılamak ve postları sabitlemek için kamerayı kullanır. Görsel özellik verileri Google ARCore ile güvenli biçimde işlenir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR uses the camera to detect real surfaces and pin posts to them. Visual feature data is processed securely by Google ARCore."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR nutzt die Kamera, um echte Flächen zu erkennen und Posts daran zu verankern. Visuelle Merkmalsdaten werden sicher von Google ARCore verarbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR usa la cámara para detectar superficies reales y fijar publicaciones en ellas. Los datos de rasgos visuales se procesan de forma segura con Google ARCore."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR utilise la caméra pour détecter les surfaces réelles et y fixer des publications. Les données de caractéristiques visuelles sont traitées de manière sécurisée par Google ARCore."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LociAR usa a câmera para detectar superfícies reais e fixar publicações nelas. Os dados de características visuais são processados com segurança pelo Google ARCore."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR использует камеру, чтобы распознавать реальные поверхности и закреплять на них посты. Данные визуальных признаков безопасно обрабатываются Google ARCore."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم LociAR الكاميرا لاكتشاف الأسطح الحقيقية وتثبيت المنشورات عليها. تتم معالجة بيانات الملامح المرئية بأمان عبر Google ARCore."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR असली सतहें पहचानने और उन पर पोस्ट पिन करने के लिए कैमरे का इस्तेमाल करता है। दृश्य विशेषता डेटा Google ARCore द्वारा सुरक्षित रूप से प्रोसेस किया जाता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR বাস্তব পৃষ্ঠ শনাক্ত করতে এবং সেখানে পোস্ট পিন করতে ক্যামেরা ব্যবহার করে। দৃশ্যমান বৈশিষ্ট্যের ডেটা Google ARCore নিরাপদে প্রক্রিয়া করে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociARは、実際の面を検出して投稿を固定するためにカメラを使用します。視覚的な特徴データはGoogle ARCoreで安全に処理されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR 使用相机检测真实表面并将帖子固定在上面。视觉特征数据由 Google ARCore 安全处理。"
          }
        }
      }
    },

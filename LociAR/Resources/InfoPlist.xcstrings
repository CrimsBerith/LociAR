        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociARは、近くのARコンテンツを一覧表示し、Google ARCore Geospatialで正しい場所に表示するために位置情報を使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR 使用你的位置列出附近的 AR 内容，并通过 Google ARCore Geospatial 将其显示在正确的位置。"

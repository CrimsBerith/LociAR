        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша учетная запись создана. Нажмите ссылку подтверждения в своем электронном письме, затем войдите в систему."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إنشاء حسابك. اضغط على رابط التحقق الموجود في بريدك الإلكتروني، ثم قم بتسجيل الدخول."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका अकाउंट बन गया है. अपने ईमेल में सत्यापन लिंक पर टैप करें, फिर साइन इन करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অ্যাকাউন্ট তৈরি করা হয়েছে. আপনার ইমেলে যাচাইকরণ লিঙ্কটি আলতো চাপুন, তারপর সাইন ইন করুন৷"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントが作成されました。メール内の確認リンクをタップして、サインインします。"
          }
        },

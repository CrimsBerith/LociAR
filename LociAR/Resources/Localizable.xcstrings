    "Bu yazarın anonim notları yalnız senin için gizlenir. Yazarın kimliği gösterilmez." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن ترى بعد الآن ملاحظات هذا الكاتب المجهولة. لن تُعرض لك هوية الكاتب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি আর এই লেখকের বেনামী নোট দেখবেন না। লেখক কে, তা আপনাকে দেখানো হবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du siehst die anonymen Notizen dieser Person nicht mehr. Wer sie verfasst hat, wird dir nicht angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will no longer see this author’s anonymous notes. Who the author is stays hidden from you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no verás las notas anónimas de este autor. No se te mostrará quién es."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne verras plus les notes anonymes de cet auteur. Son identité ne t’est pas révélée."

    "İnternet bağlantısı yok. Post cihazda sıraya alındı ve bağlantı geri geldiğinde yeniden denenecek." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnternet bağlantısı yok. Post cihazda sıraya alındı ve bağlantı geri geldiğinde yeniden denenecek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no internet connection. The post is queued on the device and will be tried again when the connection is restored."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es besteht keine Internetverbindung. Der Beitrag wird auf dem Gerät in die Warteschlange gestellt und es wird erneut versucht, wenn die Verbindung wiederhergestellt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay conexión a Internet. La publicación está en cola en el dispositivo y se intentará nuevamente cuando se restablezca la conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a pas de connexion Internet. La publication est mise en file d'attente sur l'appareil et sera réessayée lorsque la connexion sera rétablie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há conexão com a Internet. A postagem está na fila do dispositivo e será tentada novamente quando a conexão for restaurada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет подключения к Интернету. Публикация помещена в очередь на устройстве и будет повторена, когда соединение будет восстановлено."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد اتصال بالإنترنت. يتم وضع المنشور في قائمة الانتظار على الجهاز وستتم تجربته مرة أخرى عند استعادة الاتصال."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई इंटरनेट कनेक्शन नहीं है. पोस्ट डिवाइस पर कतारबद्ध है और कनेक्शन बहाल होने पर फिर से प्रयास किया जाएगा।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারনেট সংযোগ নেই। পোস্টটি ডিভাইসে সারিবদ্ধ আছে এবং সংযোগ পুনরুদ্ধার করা হলে আবার চেষ্টা করা হবে৷"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネット接続がありません。投稿はデバイスのキューに入れられ、接続が復元されたときに再試行されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有互联网连接。该帖子在设备上排队，并在连接恢复后再次尝试。"
          }
        }
      }
    },

    "Paylaşırken baktığın duvara dön. Telefonu yavaşça çevir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşırken baktığın duvara dön. Telefonu yavaşça çevir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn to the wall you faced when sharing. Turn the phone slowly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreh dich zu der Wand, auf die du beim Teilen geschaut hast. Dreh das Telefon langsam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gírate hacia la pared que mirabas al compartir. Gira el teléfono despacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tournez-vous vers le mur que vous regardiez en partageant. Tournez lentement le téléphone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vire-se para a parede que você olhava ao compartilhar. Gire o telefone devagar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повернитесь к стене, на которую вы смотрели при публикации. Поворачивайте телефон медленно."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استدر نحو الجدار الذي كنت تنظر إليه عند المشاركة. أدر الهاتف ببطء."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शेयर करते समय आप जिस दीवार की ओर देख रहे थे, उसकी ओर मुड़ें। फ़ोन को धीरे-धीरे घुमाएँ।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শেয়ার করার সময় যে দেয়ালের দিকে তাকিয়ে ছিলেন সেদিকে ঘুরুন। ফোনটি ধীরে ঘোরান।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有したときに向いていた壁の方を向いてください。電話をゆっくり回してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转向你分享时面对的墙面。请缓慢转动手机。"
          }
        }
      }
    },
    "Paylaşırken baktığın yöne %lld° sağa dön." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşırken baktığın yöne %lld° sağa dön."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn %lld° right toward the direction you faced when sharing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreh dich %lld° nach rechts in die Richtung, in die du beim Teilen geschaut hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira %lld° a la derecha hacia la dirección que mirabas al compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tournez de %lld° vers la droite, vers la direction que vous regardiez en partageant."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vire %lld° à direita, na direção que você olhava ao compartilhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повернитесь на %lld° вправо — туда, куда вы смотрели при публикации."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استدر %lld° إلى اليمين نحو الاتجاه الذي كنت تنظر إليه عند المشاركة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शेयर करते समय आप जिस दिशा में देख रहे थे, उस ओर %lld° दाईं ओर मुड़ें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শেয়ার করার সময় যেদিকে তাকিয়ে ছিলেন সেদিকে %lld° ডানে ঘুরুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有したときに向いていた方向へ右に%lld°回ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向右转 %lld°，朝向你分享时面对的方向。"
          }
        }
      }
    },
    "Paylaşırken baktığın yöne %lld° sola dön." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

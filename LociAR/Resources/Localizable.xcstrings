    "Biraz daha tara veya açıkça yaklaşık yerleştirmeyi seç." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بمسح المزيد أو اختر موضعًا تقريبيًا بشكل صريح."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আরও কিছু স্ক্যান করুন বা স্পষ্টভাবে আনুমানিক স্থান নির্বাচন করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannen Sie noch mehr oder wählen Sie explizit eine ungefähre Platzierung aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan some more or explicitly choose approximate placement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanee un poco más o elija explícitamente la ubicación aproximada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez-en davantage ou choisissez explicitement un emplacement approximatif."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ और स्कैन करें या स्पष्ट रूप से अनुमानित प्लेसमेंट चुनें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さらにスキャンするか、おおよその配置を明示的に選択します。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोफ़ाइल अपडेट नहीं की जा सकी। कनेक्शन जाँचें और फिर से प्रयास करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールを更新できませんでした。接続を確認して再試行してください。"

    "Yüzey haritası çok büyük. Daha küçük bir alanı tarayıp yeniden sabitle.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzey haritası çok büyük. Daha küçük bir alanı tarayıp yeniden sabitle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The surface map is too large. Scan a smaller area and pin again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表面地图很大。扫描较小的区域并再次固定。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सतह का नक्शा बहुत बड़ा है. एक छोटे क्षेत्र को स्कैन करें और फिर से पिन करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mapa de superficie es enorme. Escanee un área más pequeña y vuelva a fijar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte de surface est immense. Scannez une zone plus petite et épinglez à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخريطة السطحية ضخمة. قم بمسح منطقة أصغر وقم بتثبيتها مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পৃষ্ঠ মানচিত্র বিশাল. একটি ছোট এলাকা স্ক্যান করুন এবং আবার পিন করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapa de superfície é enorme. Digitalize uma área menor e fixe novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта поверхности огромна. Отсканируйте меньшую область и закрепите снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Oberflächenkarte ist riesig. Scannen Sie einen kleineren Bereich und pinnen Sie ihn erneut an."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表面マップが大きすぎます。より狭い範囲をスキャンして、もう一度固定してください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

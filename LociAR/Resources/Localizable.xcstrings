    "Beğendiğin veya kaydettiğin postları detayından bu koleksiyona ekleyebilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beğendiğin veya kaydettiğin postları detayından bu koleksiyona ekleyebilirsin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can add posts you liked or saved to this collection from their detail page."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posts, die dir gefallen oder die du gespeichert hast, kannst du in ihrer Detailansicht zu dieser Sammlung hinzufügen."
          }
        },
        "es" : {

    "Notlar ücretsizdir. Destek göndermek görünürlüğü veya sıralamayı değiştirmez." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notlar ücretsizdir. Destek göndermek görünürlüğü veya sıralamayı değiştirmez."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes are free. Sending support does not change visibility or ranking."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen sind kostenlos. Unterstützung verändert weder Sichtbarkeit noch Rangfolge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas son gratuitas. El apoyo no cambia la visibilidad ni la clasificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes sont gratuites. Le soutien ne modifie ni la visibilité ni le classement."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notas são gratuitas. O apoio não altera a visibilidade nem a classificação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заметки бесплатны. Поддержка не влияет на видимость или рейтинг."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملاحظات مجانية. إرسال الدعم لا يغيّر الظهور أو الترتيب."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट मुफ़्त हैं। सहायता भेजने से दृश्यता या रैंकिंग नहीं बदलती।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নোট বিনামূল্যে পড়া যায়। সহায়তা পাঠালে দৃশ্যমানতা বা ক্রম বদলায় না।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノートは無料です。支援しても表示範囲や順位は変わりません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笔记免费阅读。发送支持不会改变可见范围或排名。"
          }
        }
      }
    },

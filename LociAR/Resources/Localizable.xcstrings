            "value" : "প্রতিটি অ্যাকাউন্ট সর্বোচ্চ 3টি কোড দিতে পারে। প্রতিটি কোড একবারই ব্যবহার করা যায়।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各アカウントが配布できるコードは最大 3 つです。各コードは 1 回のみ使用できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个账号最多可发放 3 个邀请码。每个邀请码只能使用一次。"
          }
        }
      }
    },

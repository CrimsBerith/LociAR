    "Yüzey kaydı sınırlı da olsa kullanılabilir. Daha sağlam kilit için telefonu yavaş gezdir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüzey kaydı sınırlı da olsa kullanılabilir. Daha sağlam kilit için telefonu yavaş gezdir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The surface record is limited but usable. For a sturdier lock, move the phone slowly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flächenaufzeichnung ist eingeschränkt, aber nutzbar. Für eine stabilere Verankerung bewege das Telefon langsam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de superficie es limitado pero utilizable. Para un anclaje más firme, mueve el teléfono despacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement de la surface est limité mais utilisable. Pour un ancrage plus solide, déplacez lentement le téléphone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registro de superfície é limitado, mas utilizável. Para uma ancoragem mais firme, mova o telefone devagar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись поверхности ограничена, но пригодна. Для более надёжной привязки медленно двигайте телефон."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجل السطح محدود لكنه قابل للاستخدام. لتثبيت أقوى، حرّك الهاتف ببطء."

    "Yalnız seçtiğin platforma ait geçerli paylaşım bağlantısı kabul edilir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnız seçtiğin platforma ait geçerli paylaşım bağlantısı kabul edilir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only valid sharing links belonging to the platform you choose will be accepted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden nur gültige Freigabelinks akzeptiert, die zu der von Ihnen gewählten Plattform gehören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se aceptarán enlaces para compartir válidos que pertenezcan a la plataforma que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les liens de partage valides appartenant à la plateforme que vous choisissez seront acceptés."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente serão aceitos links de compartilhamento válidos pertencentes à plataforma que você escolher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут приняты только действительные ссылки для обмена, принадлежащие выбранной вами платформе."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم قبول روابط المشاركة الصالحة الخاصة بالمنصة التي تختارها فقط."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके द्वारा चुने गए प्लेटफ़ॉर्म से संबंधित केवल वैध साझाकरण लिंक ही स्वीकार किए जाएंगे।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধুমাত্র আপনার বেছে নেওয়া প্ল্যাটফর্মের বৈধ শেয়ারিং লিঙ্ক গ্রহণ করা হবে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したプラットフォームに属する有効な共有リンクのみが受け入れられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅接受属于您选择的平台的有效共享链接。"
          }
        }
      }
    },
    "Yalnız tahmini yüzey bulundu. Fiziksel kilit için düzlemi taramaya devam edin veya yaklaşık yerleştirmeyi açıkça seçin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnız tahmini yüzey bulundu. Fiziksel kilit için düzlemi taramaya devam edin veya yaklaşık yerleştirmeyi açıkça seçin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only an estimated surface was found. Keep scanning for a physical surface lock or explicitly choose approximate placement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde nur eine geschätzte Oberfläche gefunden. Scannen Sie weiter, um den Inhalt auf einer physischen Oberfläche zu verankern, oder wählen Sie ausdrücklich eine ungefähre Platzierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se encontró una superficie estimada. Sigue escaneando para fijar el contenido a una superficie física o elige explícitamente un posicionamiento aproximado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule une surface estimée a été trouvée. Continuez à scanner pour ancrer le contenu à une surface physique ou choisissez explicitement un placement approximatif."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só foi encontrada uma superfície estimada. Continue a varredura para fixar o conteúdo numa superfície física ou escolha explicitamente um posicionamento aproximado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдена только приблизительная поверхность. Продолжайте сканирование для закрепления на физической поверхности или явно выберите приблизительное размещение."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم العثور على سطح تقديري فقط. استمر في المسح لتثبيت المحتوى على سطح حقيقي أو اختر موضعًا تقريبيًا بشكل صريح."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल अनुमानित सतह ही मिली। भौतिक सतह लॉक के लिए स्कैनिंग करते रहें या स्पष्ट रूप से अनुमानित स्थान चुनें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধুমাত্র একটি আনুমানিক পৃষ্ঠ পাওয়া গেছে. ফিজিক্যাল সারফেস লকের জন্য স্ক্যান করতে থাকুন বা স্পষ্টভাবে আনুমানিক প্লেসমেন্ট বেছে নিন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推定された表面のみが見つかりました。物理的な表面ロックのスキャンを続けるか、おおよその配置を明示的に選択します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅找到估算的表面。请继续扫描以将内容固定到实际表面，或明确选择近似放置。"
          }
        }
      }
    },

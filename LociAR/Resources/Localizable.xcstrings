    "Notların varsayılan olarak anonimdir. İstersen kullanıcı adını gösterebilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكون ملاحظاتك مجهولة افتراضيًا. يمكنك اختيار إظهار اسم المستخدم."

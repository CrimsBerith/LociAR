          }
        }
      }
    },
    "LociAR geçici olarak durduruldu. Post cihazda sıraya alındı ve hizmet açıldığında yayınlanacak." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR geçici olarak durduruldu. Post cihazda sıraya alındı ve hizmet açıldığında yayınlanacak."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR is temporarily paused. Your post is queued on this device and will be published when the service is back."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR ist vorübergehend pausiert. Dein Post wartet auf dem Gerät und wird veröffentlicht, sobald der Dienst wieder läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR está pausado temporalmente. Tu publicación quedó en cola en el dispositivo y se publicará cuando el servicio vuelva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR est temporairement suspendu. Votre publication est en file d’attente sur l’appareil et sera publiée au retour du service."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LociAR está pausado temporariamente. Sua publicação ficou na fila no dispositivo e será publicada quando o serviço voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR временно приостановлен. Ваш пост поставлен в очередь на устройстве и будет опубликован, когда сервис заработает."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إيقاف LociAR مؤقتًا. وُضع منشورك في قائمة الانتظار على الجهاز وسيُنشر عند عودة الخدمة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR अस्थायी रूप से रुका हुआ है। आपकी पोस्ट डिवाइस पर कतार में है और सेवा वापस आने पर प्रकाशित होगी।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR সাময়িকভাবে বন্ধ আছে। আপনার পোস্ট ডিভাইসে সারিতে রাখা হয়েছে এবং পরিষেবা ফিরলে প্রকাশিত হবে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociARは一時停止中です。投稿はデバイスで待機しており、サービス再開時に公開されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LociAR 已暂时暂停。你的帖子已在设备上排队，服务恢复后将发布。"
          }
        }
      }
    },

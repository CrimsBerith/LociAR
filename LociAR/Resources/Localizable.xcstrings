    "Konumuna göre kampanya ve teklif bildirimleri al. Bu tercih isteğe bağlıdır." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konumuna göre kampanya ve teklif bildirimleri al. Bu tercih isteğe bağlıdır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get campaign and offer notifications based on your location. This is optional."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte standortbezogene Mitteilungen zu Aktionen und Angeboten. Dies ist freiwillig."
          }
        },
        "es" : {
          "stringUnit" : {

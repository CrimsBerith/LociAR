    "Kimlik doğrulama iptal edildi. Hesabın silinmedi." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimlik doğrulama iptal edildi. Hesabın silinmedi."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verification was cancelled. Your account was not deleted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bestätigung wurde abgebrochen. Dein Konto wurde nicht gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se canceló la verificación. La cuenta no se ha eliminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérification a été annulée. Votre compte n’a pas été supprimé."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A verificação foi cancelada. Sua conta não foi excluída."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтверждение отменено. Аккаунт не удалён."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُلغي التحقّق. لم يُحذف حسابك."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सत्यापन रद्द कर दिया गया। आपका खाता नहीं मिटाया गया।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যাচাই বাতিল করা হয়েছে। আপনার অ্যাকাউন্ট মুছে যায়নি।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認がキャンセルされました。アカウントは削除されていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "验证已取消。账号未被删除。"
          }
        }
      }
    },
    "Kimlik doğrulanamadı. Hesabın silinmedi; bilgilerini kontrol et." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimlik doğrulanamadı. Hesabın silinmedi; bilgilerini kontrol et."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not verify your identity. Your account was not deleted; check your credentials."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Identität konnte nicht bestätigt werden. Dein Konto wurde nicht gelöscht; prüfe deine Zugangsdaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar tu identidad. La cuenta no se ha eliminado; comprueba tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre identité n’a pas pu être vérifiée. Votre compte n’a pas été supprimé ; vérifiez vos identifiants."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar sua identidade. Sua conta não foi excluída; confira suas credenciais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подтвердить личность. Аккаунт не удалён; проверьте данные."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التحقّق من هويتك. لم يُحذف حسابك؛ تحقّق من بياناتك."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहचान सत्यापित नहीं हो सकी। खाता नहीं मिटाया गया; अपने विवरण जाँचें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিচয় যাচাই করা যায়নি। অ্যাকাউন্ট মুছে যায়নি; লগইনের তথ্য পরীক্ষা করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本人確認ができませんでした。アカウントは削除されていません。ログイン情報を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法验证身份。账号未被删除，请检查登录信息。"
          }
        }
      }
    },

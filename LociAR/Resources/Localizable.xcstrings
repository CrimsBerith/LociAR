    "Cihaz test modunda yeni aktivite bulunmuyor.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz test modunda yeni aktivite bulunmuyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no new activity in device test mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备测试模式下没有新动态。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस परीक्षण मोड में कोई नई गतिविधि नहीं है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay actividad nueva en el modo de prueba del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune nouvelle activité en mode de test de l’appareil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أنشطة جديدة في وضع اختبار الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইস পরীক্ষার মোডে নতুন কোনো কার্যকলাপ নেই।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há novas atividades no modo de teste do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В режиме тестирования устройства нет новой активности."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Gerätetestmodus gibt es keine neuen Aktivitäten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイステストモードでは新しいアクティビティはありません。"
          }
        }
      }
    },
    "Aktiviteler için sunucu bağlantısı gerekiyor.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviteler için sunucu bağlantısı gerekiyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A server connection is required for activity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看动态需要连接服务器。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गतिविधि के लिए सर्वर से कनेक्शन आवश्यक है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita una conexión al servidor para ver la actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une connexion au serveur est nécessaire pour les activités."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم الاتصال بالخادم لعرض الأنشطة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্যকলাপ দেখতে সার্ভারের সংযোগ প্রয়োজন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária uma conexão com o servidor para ver as atividades."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для просмотра активности нужно подключение к серверу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Aktivitäten ist eine Verbindung zum Server erforderlich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティビティの表示にはサーバーへの接続が必要です。"
          }
        }
      }
    },
    "Okundu bilgisi kaydedilemedi. Bağlantını kontrol edip tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okundu bilgisi kaydedilemedi. Bağlantını kontrol edip tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save read status. Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存已读状态。请检查连接后重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़े जाने की स्थिति सहेजी नहीं जा सकी। कनेक्शन जाँचें और फिर प्रयास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el estado de lectura. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer l’état de lecture. Vérifiez votre connexion et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ حالة القراءة. تحقّق من اتصالك وحاول مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পড়ার অবস্থা সংরক্ষণ করা যায়নি। সংযোগ পরীক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o estado de leitura. Verifique a conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить статус прочтения. Проверьте подключение и повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Lesestatus konnte nicht gespeichert werden. Prüfe die Verbindung und versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既読状態を保存できませんでした。接続を確認して再試行してください。"
          }
        }
      }
    },
    "Aktiviteler şu anda yüklenemiyor. Biraz sonra tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviteler şu anda yüklenemiyor. Biraz sonra tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity cannot be loaded right now. Try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法加载动态。请稍后重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी गतिविधियाँ लोड नहीं हो सकतीं। कुछ देर बाद फिर प्रयास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actividad no se puede cargar ahora. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les activités ne peuvent pas être chargées pour le moment. Réessayez bientôt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذّر تحميل الأنشطة حاليًا. حاول مجددًا بعد قليل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন কার্যকলাপ লোড করা যাচ্ছে না। কিছুক্ষণ পরে আবার চেষ্টা করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível carregar as atividades agora. Tente novamente em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удаётся загрузить активность. Повторите попытку позже."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitäten können gerade nicht geladen werden. Versuche es gleich noch einmal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在アクティビティを読み込めません。しばらくしてから再試行してください。"
          }
        }
      }
    },
    "Postun beğenildi.": {

        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن إكمال تسجيل الدخول باستخدام Apple في الوقت الحالي. حاول ثانية."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple के साथ साइन इन करना इस समय पूरा नहीं किया जा सका. पुनः प्रयास करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপলের সাথে সাইন ইন করা এই সময়ে সম্পূর্ণ করা যায়নি। আবার চেষ্টা করুন"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現時点では Apple でのサインインを完了できませんでした。もう一度やり直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法完成 Apple 登录。再试一次。"
          }
        }
      }
    },
    "Apple oturum izni geri alınamadı, hesabın silinmedi. Biraz sonra tekrar dene." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple oturum izni geri alınamadı, hesabın silinmedi. Biraz sonra tekrar dene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple access could not be revoked. Your account was not deleted. Try again shortly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Apple-Zugriff konnte nicht widerrufen werden. Dein Konto wurde nicht gelöscht. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo revocar el acceso de Apple. La cuenta no se ha eliminado. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès Apple n’a pas pu être révoqué. Votre compte n’a pas été supprimé. Réessayez bientôt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível revogar o acesso da Apple. Sua conta não foi excluída. Tente novamente em breve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось отозвать доступ Apple. Аккаунт не удалён. Повторите попытку позже."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إلغاء إذن Apple. لم يُحذف حسابك. حاول مجددًا بعد قليل."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple की अनुमति वापस नहीं ली जा सकी। आपका खाता नहीं मिटाया गया। कुछ देर बाद फिर प्रयास करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-এর অনুমতি বাতিল করা যায়নি। আপনার অ্যাকাউন্ট মুছে যায়নি। কিছুক্ষণ পরে আবার চেষ্টা করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleのアクセス権を取り消せませんでした。アカウントは削除されていません。しばらくしてから再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法撤销 Apple 授权，账号未被删除。请稍后重试。"
          }
        }
      }
    },
    "Arka planda paylaşılmaz. Kapatınca paylaşılan son konum silinir; notlarının konumu ve iOS konum izni değişmez." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka planda paylaşılmaz. Kapatınca paylaşılan son konum silinir; notlarının konumu ve iOS konum izni değişmez."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location is not shared in the background. Turning this off deletes the last shared location; your notes’ locations and iOS location permission stay the same."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Hintergrund wird kein Standort geteilt. Beim Ausschalten wird der zuletzt geteilte Standort gelöscht; die Standorte deiner Notizen und die iOS-Standortberechtigung bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación no se comparte en segundo plano. Al desactivar esta opción se elimina la última ubicación compartida; las ubicaciones de tus notas y el permiso de ubicación de iOS no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position n’est pas partagée en arrière-plan. Désactiver cette option supprime la dernière position partagée ; les emplacements de vos notes et l’autorisation de localisation iOS restent inchangés."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização não é compartilhada em segundo plano. Desativar esta opção exclui a última localização compartilhada; os locais das notas e a permissão de localização do iOS não mudam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В фоне местоположение не передаётся. Отключение удаляет последнее переданное местоположение; координаты заметок и разрешение геолокации iOS не меняются."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتم مشاركة الموقع في الخلفية. يؤدي إيقاف هذا الخيار إلى حذف آخر موقع تمت مشاركته؛ ولا تتغير مواقع ملاحظاتك أو إذن الموقع في iOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकग्राउंड में लोकेशन साझा नहीं होती। इसे बंद करने पर आखिरी साझा लोकेशन मिटती है; आपके नोटों की जगह और iOS की लोकेशन अनुमति नहीं बदलती।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যাকগ্রাউন্ডে অবস্থান শেয়ার হয় না। এটি বন্ধ করলে শেষ শেয়ার করা অবস্থান মুছে যায়; নোটের অবস্থান ও iOS-এর অবস্থানের অনুমতি বদলায় না।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドでは位置情報を共有しません。オフにすると最後に共有した位置情報が削除されます。ノートの場所とiOSの位置情報権限は変わりません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会在后台分享位置。关闭后将删除上次分享的位置；笔记位置和 iOS 定位权限保持不变。"
          }
        }
      }
    },
    "Arka planda varış bildirimi için konum iznini Her zaman olarak ayarla." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {

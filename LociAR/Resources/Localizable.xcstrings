        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉग इन करने में विफल। अपना ईमेल और पासवर्ड जांचें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar sesión. Verifique su correo electrónico y contraseña."

    "Gizlilik politikasını ve topluluk kurallarını okudum, kabul ediyorum. Sakıncalı içerik ve kötüye kullanıma sıfır tolerans uygulanır." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizlilik politikasını ve topluluk kurallarını okudum, kabul ediyorum. Sakıncalı içerik ve kötüye kullanıma sıfır tolerans uygulanır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have read and accept the privacy policy and community rules. Objectionable content and abuse are not tolerated."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe die Datenschutzerklärung und die Community-Regeln gelesen und akzeptiere sie. Anstößige Inhalte und Missbrauch werden nicht toleriert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He leído y acepto la política de privacidad y las normas de la comunidad. No se tolera el contenido inapropiado ni el abuso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai lu et j’accepte la politique de confidentialité et les règles de la communauté. Aucun contenu inapproprié ni abus n’est toléré."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li e aceito a política de privacidade e as regras da comunidade. Conteúdo impróprio e abuso não são tolerados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я прочитал(а) и принимаю политику конфиденциальности и правила сообщества. Недопустимый контент и злоупотребления не допускаются."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرأت سياسة الخصوصية وقواعد المجتمع وأوافق عليها. لا تسامح مطلقًا مع المحتوى المسيء وإساءة الاستخدام."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैंने गोपनीयता नीति और समुदाय नियम पढ़ लिए हैं और उन्हें स्वीकार करता/करती हूँ। आपत्तिजनक सामग्री और दुरुपयोग बिल्कुल बर्दाश्त नहीं किए जाते।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমি গোপনীয়তা নীতি ও কমিউনিটি নিয়ম পড়েছি এবং মেনে নিচ্ছি। আপত্তিকর কনটেন্ট ও অপব্যবহার একেবারেই সহ্য করা হয় না।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシーポリシーとコミュニティルールを読み、同意します。不適切なコンテンツや迷惑行為は一切容認されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我已阅读并接受隐私政策和社区规则。对不良内容和滥用行为零容忍。"
          }
        }
      }
    },

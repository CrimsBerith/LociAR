        }
      }
    },
    "Düşüncelerini ve favori sosyal medya bağlantılarını (Spotify, YouTube, Instagram...) gerçek duvarlara ve mekânlara AR yüzey kilitleme ile sabitle." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşüncelerini ve favori sosyal medya bağlantılarını (Spotify, YouTube, Instagram...) gerçek duvarlara ve mekânlara AR yüzey kilitleme ile sabitle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pin your thoughts and favorite social links (Spotify, YouTube, Instagram...) to real walls and places with AR surface locking."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hefte deine Gedanken und Lieblingslinks (Spotify, YouTube, Instagram...) mit AR-Flächenverankerung an echte Wände und Orte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija tus ideas y tus enlaces sociales favoritos (Spotify, YouTube, Instagram...) en paredes y lugares reales con el anclaje de superficies AR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épinglez vos idées et vos liens sociaux favoris (Spotify, YouTube, Instagram...) sur de vrais murs et lieux grâce à l’ancrage de surface en RA."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixe seus pensamentos e seus links sociais favoritos (Spotify, YouTube, Instagram...) em paredes e lugares reais com a ancoragem de superfícies em RA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрепляйте мысли и любимые ссылки (Spotify, YouTube, Instagram...) на реальных стенах и в реальных местах с помощью AR-привязки к поверхности."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت أفكارك وروابطك المفضلة على وسائل التواصل (Spotify وYouTube وInstagram...) على جدران وأماكن حقيقية بتثبيت الأسطح بالواقع المعزز."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AR सतह लॉकिंग से अपने विचार और पसंदीदा सोशल लिंक (Spotify, YouTube, Instagram...) असली दीवारों और जगहों पर पिन करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AR পৃষ্ঠ লকিং দিয়ে আপনার ভাবনা ও প্রিয় সোশ্যাল লিংক (Spotify, YouTube, Instagram...) বাস্তব দেয়াল ও জায়গায় পিন করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AR面ロックで、考えやお気に入りのソーシャルリンク（Spotify、YouTube、Instagramなど）を実際の壁や場所に固定しましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "借助 AR 表面锁定，把你的想法和喜爱的社交链接（Spotify、YouTube、Instagram...）固定在真实的墙面和地点上。"
          }
        }
      }
    },

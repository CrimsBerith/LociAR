    "Veri paylaşımı güncellenemedi. Bağlantını kontrol edip tekrar dene." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veri paylaşımı güncellenemedi. Bağlantını kontrol edip tekrar dene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data sharing could not be updated. Check your connection and try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datenfreigabe konnte nicht aktualisiert werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo actualizar el uso compartido de datos. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partage de données n’a pas pu être mis à jour. Vérifiez votre connexion et réessayez."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível atualizar o compartilhamento de dados. Verifique sua conexão e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось обновить передачу данных. Проверьте соединение и повторите попытку."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحديث مشاركة البيانات. تحقّق من اتصالك وحاول مجددًا."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेटा साझाकरण अपडेट नहीं हो सका। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডেটা শেয়ারিং আপডেট করা যায়নি। সংযোগ পরীক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データ共有を更新できませんでした。接続を確認して再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法更新数据共享设置。请检查连接后重试。"
          }
        }
      }
    },

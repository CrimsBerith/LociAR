            "value" : "Скан становится четким; Медленно перемещайте телефон."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصبح المسح واضحا. حرك الهاتف ببطء."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कैन स्पष्ट हो जाता है; फोन को धीरे-धीरे हिलाएं."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্যান পরিষ্কার হয়ে যায়; ফোনটা আস্তে আস্তে নাড়ান।"
          }
        },
        "ja" : {
          "stringUnit" : {

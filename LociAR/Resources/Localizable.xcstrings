    "Apple oturum izni geri alınamadı, hesabın silinmedi. Biraz sonra tekrar dene." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple oturum izni geri alınamadı, hesabın silinmedi. Biraz sonra tekrar dene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple access could not be revoked. Your account was not deleted. Try again shortly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Apple-Zugriff konnte nicht widerrufen werden. Dein Konto wurde nicht gelöscht. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo revocar el acceso de Apple. La cuenta no se ha eliminado. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès Apple n’a pas pu être révoqué. Votre compte n’a pas été supprimé. Réessayez bientôt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível revogar o acesso da Apple. Sua conta não foi excluída. Tente novamente em breve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось отозвать доступ Apple. Аккаунт не удалён. Повторите попытку позже."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إلغاء إذن Apple. لم يُحذف حسابك. حاول مجددًا بعد قليل."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple की अनुमति वापस नहीं ली जा सकी। आपका खाता नहीं मिटाया गया। कुछ देर बाद फिर प्रयास करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-এর অনুমতি বাতিল করা যায়নি। আপনার অ্যাকাউন্ট মুছে যায়নি। কিছুক্ষণ পরে আবার চেষ্টা করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleのアクセス権を取り消せませんでした。アカウントは削除されていません。しばらくしてから再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法撤销 Apple 授权，账号未被删除。请稍后重试。"

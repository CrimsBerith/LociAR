    "Yüzey kilitli. Yeniden açılabilir kayıt için telefonu yüzeyin çevresinde yavaşça gezdir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçerik yüzeye sabitlendi. Burada yeniden açılabilmesi için telefonu yüzeyin çevresinde yavaşça gezdir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content is anchored to the surface. Slowly move the phone around the surface to save a map for reopening here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容已固定到表面。请在表面周围缓慢移动手机，保存地图以便在此重新打开。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामग्री सतह पर स्थिर है। यहीं दोबारा खोलने के लिए मानचित्र सहेजने हेतु फ़ोन को सतह के चारों ओर धीरे-धीरे घुमाएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido está anclado a la superficie. Mueve el teléfono lentamente alrededor de ella para guardar un mapa y poder abrirlo aquí de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu est ancré à la surface. Déplacez lentement le téléphone autour de celle-ci pour enregistrer une carte et pouvoir le rouvrir ici."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تثبيت المحتوى على السطح. حرك الهاتف ببطء حول السطح لحفظ خريطة تتيح فتحه هنا مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিষয়বস্তু পৃষ্ঠে স্থির করা হয়েছে। এখানে আবার খুলতে মানচিত্র সংরক্ষণ করার জন্য পৃষ্ঠের চারপাশে ফোনটি ধীরে ধীরে সরান।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo está fixado à superfície. Mova o telefone lentamente ao redor dela para salvar um mapa e poder abri-lo aqui novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое закреплено на поверхности. Медленно перемещайте телефон вокруг поверхности, чтобы сохранить карту для повторного открытия здесь."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt ist auf der Oberfläche verankert. Bewegen Sie das Telefon langsam um die Oberfläche, um eine Karte zum erneuten Öffnen an dieser Stelle zu speichern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツは表面に固定されています。ここで再び開けるようにマップを保存するため、表面の周囲でスマートフォンをゆっくり動かしてください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

    "Konum alınamadı. Yeni pin oluşturabilir veya tekrar deneyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum alınamadı. Yeni pin oluşturabilir veya tekrar deneyebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location could not be obtained. You can create a new pin or try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取位置。您可以创建新的位置标记或重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान प्राप्त नहीं हो सका. आप एक नया पिन बना सकते हैं या पुनः प्रयास कर सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener la ubicación. Puedes crear un pin nuevo o intentarlo nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement n'a pas pu être obtenu. Vous pouvez créer une nouvelle épingle ou réessayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الحصول على الموقع. يمكنك إنشاء دبوس جديد أو المحاولة مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান পাওয়া যায়নি. আপনি একটি নতুন পিন তৈরি করতে পারেন বা আবার চেষ্টা করতে পারেন৷"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter a localização. Você pode criar um novo pin ou tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить местоположение. Вы можете создать новую метку или повторить попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort konnte nicht ermittelt werden. Sie können einen neuen Pin erstellen oder es erneut versuchen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報を取得できませんでした。新しいピンを作成するか、もう一度試してください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Konum aranıyor. Açık bir alanda kısa süre bekleyin.": {

    "Fiziksel AR yüzey kaydı eksik. Yüzeyi yeniden tarayıp kesin kilit oluşturun.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiziksel AR yüzey kaydı eksik. Yüzeyi yeniden tarayıp kesin kilit oluşturun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The physical AR surface map is missing. Rescan the surface to establish a physical lock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "物理 AR 表面地图丢失。重新扫描表面以建立物理锁。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भौतिक AR सतह मानचित्र गायब है। भौतिक लॉक स्थापित करने के लिए सतह को दोबारा स्कैन करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el mapa físico de la superficie AR. Vuelva a escanear la superficie para establecer un bloqueo físico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte physique de la surface AR est manquante. Analysez à nouveau la surface pour établir un verrou physique."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خريطة سطح الواقع المعزز مفقودة. أعد مسح السطح لتثبيت المحتوى عليه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাস্তব AR পৃষ্ঠের মানচিত্র নেই। পৃষ্ঠে স্থির করতে আবার স্ক্যান করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapa físico da superfície AR está faltando. Digitalize novamente a superfície para estabelecer um bloqueio físico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Физическая карта поверхности AR отсутствует. Повторно просканируйте поверхность, чтобы установить физическую блокировку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die AR-Karte der physischen Oberfläche fehlt. Scannen Sie die Oberfläche erneut, um den Inhalt fest darauf zu verankern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物理的な AR サーフェス マップがありません。表面を再スキャンして物理的なロックを確立します。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

    "Kartı açmak için kamerayı dokulu bir duvar, masa veya zemin üzerinde yavaşça gezdir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartı açmak için kamerayı dokulu bir duvar, masa veya zemin üzerinde yavaşça gezdir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To open the card, slowly move the camera over a textured wall, table or floor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege die Kamera langsam über eine strukturierte Wand, einen Tisch oder Boden, um die Karte zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para abrir la tarjeta, mueve la cámara despacio sobre una pared, mesa o suelo con textura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour ouvrir la carte, déplacez lentement la caméra sur un mur, une table ou un sol texturé."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para abrir o cartão, mova a câmera devagar sobre uma parede, mesa ou piso com textura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы открыть карточку, медленно ведите камерой по текстурированной стене, столу или полу."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لفتح البطاقة، حرّك الكاميرا ببطء فوق جدار أو طاولة أو أرضية ذات تفاصيل."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड खोलने के लिए कैमरे को बनावट वाली दीवार, मेज़ या फ़र्श पर धीरे-धीरे घुमाएँ।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কার্ডটি খুলতে ক্যামেরাটি টেক্সচারযুক্ত দেয়াল, টেবিল বা মেঝের ওপর ধীরে সরান।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードを開くには、模様のある壁、テーブル、床の上でカメラをゆっくり動かしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要打开卡片，请在有纹理的墙面、桌面或地面上缓慢移动相机。"
          }
        }
      }
    },

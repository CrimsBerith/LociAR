    "Post yayınlandı. Keşfet ve profilinde görünür.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Post yayınlandı. Keşfet ve profilinde görünür."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The post is published. It appears in Discover and your profile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该帖子已发布。它会出现在“探索”和您的个人资料中。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट प्रकाशित हो गई है। यह खोजें अनुभाग और आपकी प्रोफ़ाइल में दिखाई देती है।"
          }
        },
        "es": {

    "Koleksiyon oluşturulamadı. Biraz sonra tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koleksiyon oluşturulamadı. Biraz sonra tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The collection could not be created. Try again in a little while."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建收藏集。请稍后重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संग्रह नहीं बनाया जा सका. थोड़ी देर में पुनः प्रयास करें."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear la colección. Vuelve a intentarlo dentro de un rato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La collection n'a pas pu être créée. Réessayez dans quelques instants."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إنشاء المجموعة. حاول مرة أخرى بعد قليل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংগ্রহ তৈরি করা যায়নি. কিছুক্ষণের মধ্যে আবার চেষ্টা করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar a coleção. Tente novamente daqui a pouco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать коллекцию. Повторите попытку через некоторое время."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sammlung konnte nicht erstellt werden. Versuchen Sie es später noch einmal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクションを作成できませんでした。しばらくしてからもう一度お試しください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

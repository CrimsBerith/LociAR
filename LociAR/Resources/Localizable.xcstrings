    "Notlar ücretsizdir. Destek göndermek görünürlüğü veya sıralamayı değiştirmez." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملاحظات مجانية. إرسال الدعم لا يغيّر الظهور أو الترتيب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নোট বিনামূল্যে পড়া যায়। সহায়তা পাঠালে দৃশ্যমানতা বা ক্রম বদলায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen sind kostenlos. Unterstützung verändert weder Sichtbarkeit noch Rangfolge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes are free. Sending support does not change visibility or ranking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas son gratuitas. El apoyo no cambia la visibilidad ni la clasificación."

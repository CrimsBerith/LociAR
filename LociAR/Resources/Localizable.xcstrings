          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Background App Refresh in iOS Settings for location notifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la actualización en segundo plano en los ajustes de iOS para recibir notificaciones de ubicación."

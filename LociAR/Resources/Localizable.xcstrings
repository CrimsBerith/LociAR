        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার পোস্ট ও সোশ্যাল ডেটা সার্ভার থেকে মুছে ফেলা হয়। এটি ফেরানো যায় না।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿とソーシャルデータはサーバーから削除されます。この操作は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的帖子和社交数据将从服务器删除。此操作无法撤销。"
          }
        }
      }
    },
    "Postu aynı yüzeyde yeniden açabilmek için telefonu çevrede yavaşça gezdir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postu aynı yüzeyde yeniden açabilmek için telefonu çevrede yavaşça gezdir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To reopen the post on the same surface, slowly move the phone around."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege das Telefon langsam umher, damit sich der Post auf derselben Fläche wieder öffnen lässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para volver a abrir la publicación en la misma superficie, mueve el teléfono despacio por el entorno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour rouvrir la publication sur la même surface, déplacez lentement le téléphone autour de vous."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para reabrir a publicação na mesma superfície, mova o telefone devagar pelo ambiente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы пост снова открылся на той же поверхности, медленно поводите телефоном вокруг."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لإعادة فتح المنشور على السطح نفسه، حرّك الهاتف ببطء في المكان."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट को उसी सतह पर फिर से खोलने के लिए फ़ोन को आस-पास धीरे-धीरे घुमाएँ।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একই পৃষ্ঠে পোস্টটি আবার খুলতে ফোনটি চারপাশে ধীরে সরান।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ面で投稿をもう一度開けるように、周囲で電話をゆっくり動かしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了能在同一表面重新打开帖子，请在周围缓慢移动手机。"
          }
        }
      }
    },

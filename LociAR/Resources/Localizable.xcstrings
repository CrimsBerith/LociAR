        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অবস্থান ±%lld মি। পিনটি ঠিক আপনার জায়গায় রাখুন, তারপর আবার এখানে পোস্ট করুন চাপুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

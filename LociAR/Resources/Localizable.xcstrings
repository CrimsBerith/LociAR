    "Biraz daha tara veya açıkça yaklaşık yerleştirmeyi seç." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biraz daha tara veya açıkça yaklaşık yerleştirmeyi seç."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan some more or explicitly choose approximate placement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannen Sie noch mehr oder wählen Sie explizit eine ungefähre Platzierung aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanee un poco más o elija explícitamente la ubicación aproximada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez-en davantage ou choisissez explicitement un emplacement approximatif."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitalize um pouco mais ou escolha explicitamente o posicionamento aproximado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте еще или явно выберите приблизительное размещение."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بمسح المزيد أو اختر موضعًا تقريبيًا بشكل صريح."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ और स्कैन करें या स्पष्ट रूप से अनुमानित प्लेसमेंट चुनें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আরও কিছু স্ক্যান করুন বা স্পষ্টভাবে আনুমানিক স্থান নির্বাচন করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さらにスキャンするか、おおよその配置を明示的に選択します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描更多或明确选择大致位置。"
          }
        }
      }
    },

        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सतह मानचित्र में सीमित विवरण है लेकिन यह प्रयोग योग्य है। मजबूत लॉक के लिए फोन को धीरे-धीरे घुमाएं।"

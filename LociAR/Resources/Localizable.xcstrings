    "Yayınlamak için geçerli GPS konumu gerekiyor. Konum iznini açıp tekrar deneyin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطلوب موقع GPS صالح للنشر. قم بتمكين الوصول إلى الموقع وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রকাশ করার জন্য একটি বৈধ GPS অবস্থান প্রয়োজন৷ অবস্থান অ্যাক্সেস সক্ষম করুন এবং আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Veröffentlichung ist ein gültiger GPS-Standort erforderlich. Aktivieren Sie den Standortzugriff und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A valid GPS location is required to publish. Enable location access and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere una ubicación GPS válida para publicar. Habilite el acceso a la ubicación e inténtelo nuevamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

      }
    },
    "Notların ve sosyal verilerin sunucudan silinir. Bu işlem geri alınamaz." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notların ve sosyal verilerin sunucudan silinir. Bu işlem geri alınamaz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your notes and social data will be deleted from the server. This cannot be undone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Notizen und sozialen Daten werden vom Server gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus notas y datos sociales se eliminarán del servidor. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos notes et données sociales seront supprimées du serveur. Cette action est irréversible."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas notas e dados sociais serão excluídos do servidor. Esta ação não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши заметки и социальные данные будут удалены с сервера. Это действие нельзя отменить."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف ملاحظاتك وبياناتك الاجتماعية من الخادم. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",

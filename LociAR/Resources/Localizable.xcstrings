    "Buraya yazacağın yorum @%@ adınla görünür ve notun sana ait olduğunu belli eder." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buraya yazacağın yorum @%@ adınla görünür ve notun sana ait olduğunu belli eder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A comment you write here appears as @%@ and shows that the note is yours."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kommentar, den du hier schreibst, erscheint als @%@ und zeigt, dass die Notiz von dir ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un comentario que escribas aquí aparece como @%@ y muestra que la nota es tuya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un commentaire écrit ici apparaît sous @%@ et montre que la note est la tienne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um comentário escrito aqui aparece como @%@ e mostra que a nota é sua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комментарий здесь будет подписан @%@ и покажет, что заметка ваша."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر التعليق الذي تكتبه هنا باسم @%@ ويكشف أن الملاحظة لك."

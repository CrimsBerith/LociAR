    "Kartı açmak için kamerayı dokulu bir duvar, masa veya zemin üzerinde yavaşça gezdir." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرك الكاميرا ببطء عبر جدار أو طاولة أو أرضية مزخرفة لفتح البطاقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কার্ড খুলতে একটি টেক্সচার্ড দেয়াল, টেবিল বা মেঝে জুড়ে ধীরে ধীরে ক্যামেরা সরান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegen Sie die Kamera langsam über eine strukturierte Wand, einen Tisch oder einen Boden, um die Karte zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move the camera slowly across a textured wall, table, or floor to open the card."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve la cámara lentamente sobre una pared, mesa o suelo con textura para abrir la tarjeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez lentement la caméra sur un mur, une table ou un sol texturé pour ouvrir la carte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड खोलने के लिए कैमरे को बनावट वाली दीवार, टेबल या फर्श पर धीरे-धीरे ले जाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テクスチャのある壁、テーブル、床の上でカメラをゆっくりと移動して、カードを開きます。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mova a câmera lentamente sobre uma parede, mesa ou chão texturizado para abrir o cartão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленно перемещайте камеру вдоль стены, стола или пола с выраженной текстурой, чтобы открыть карточку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartı açmak için kamerayı dokulu bir duvar, masa veya zemin üzerinde yavaşça gezdir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将相机对准有纹理的墙壁、桌面或地面并缓慢移动，以打开卡片。"
          }
        }
      }
    },
    "Kartlar, Apple Pay ve diğer uygun yöntemler ödeme sayfasında gösterilir." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر البطاقات وApple Pay وطرق الدفع الأخرى المتاحة عند الدفع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কার্ড, Apple Pay ও অন্যান্য উপলব্ধ পদ্ধতি পেমেন্ট পৃষ্ঠায় দেখানো হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten, Apple Pay und weitere verfügbare Methoden werden beim Bezahlen angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards, Apple Pay and other eligible methods are shown at checkout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas, Apple Pay y otros métodos disponibles se muestran al pagar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes, Apple Pay et les autres moyens disponibles sont proposés lors du paiement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्ड, Apple Pay और अन्य उपलब्ध तरीके भुगतान पेज पर दिखेंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード、Apple Payなど利用可能な方法が決済ページに表示されます。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartões, Apple Pay e outros métodos disponíveis são exibidos no pagamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карты, Apple Pay и другие доступные способы будут показаны при оплате."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartlar, Apple Pay ve diğer uygun yöntemler ödeme sayfasında gösterilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "银行卡、Apple Pay和其他可用方式将在结账页面显示。"
          }
        }
      }
    },

    "Şifre yenileme bağlantısını gönderdik. Bağlantı LociAR’da yeni şifre ekranını açacak." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şifre yenileme bağlantısını gönderdik. Bağlantı LociAR’da yeni şifre ekranını açacak."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We sent a password reset link. It will open the new password screen in LociAR."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben dir einen Link zum Zurücksetzen gesendet. Er öffnet in LociAR den Bildschirm für ein neues Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te enviamos un enlace para restablecer la contraseña. Abrirá en LociAR la pantalla de nueva contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons envoyé un lien de réinitialisation. Il ouvrira l’écran de nouveau mot de passe dans LociAR."

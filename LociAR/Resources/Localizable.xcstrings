    "Sosyal medya bağlantısı geçersiz. Paylaşım bağlantısını uygulamadan tekrar kopyala.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sosyal medya bağlantısı geçersiz. Paylaşım bağlantısını uygulamadan tekrar kopyala."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Social media link is invalid. Copy the share link from the app again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "社交媒体链接无效。再次从应用程序复制共享链接。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोशल मीडिया लिंक अमान्य है. ऐप से शेयर लिंक को दोबारा कॉपी करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace de la red social no es válido. Copie el enlace para compartir de la aplicación nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien vers les réseaux sociaux n'est pas valide. Copiez à nouveau le lien de partage depuis l'application."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رابط وسائل التواصل الاجتماعي غير صالح. انسخ رابط المشاركة من التطبيق مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সামাজিক মিডিয়া লিঙ্ক অবৈধ. আবার অ্যাপ থেকে শেয়ার লিঙ্ক কপি করুন."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O link da mídia social é inválido. Copie o link de compartilhamento do aplicativo novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка на социальную сеть недействительна. Скопируйте ссылку общего доступа из приложения еще раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Social-Media-Link ist ungültig. Kopieren Sie den Freigabelink erneut aus der App."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソーシャルメディアのリンクが無効です。アプリから共有リンクを再度コピーします。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."

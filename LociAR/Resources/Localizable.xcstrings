    "Profilin henüz hazırlanıyor. Post birazdan otomatik olarak yeniden denenecek.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilin henüz hazırlanıyor. Post birazdan otomatik olarak yeniden denenecek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile is just being prepared. The post will be retried automatically in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的个人资料正在准备中。该帖子将稍后自动重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी प्रोफ़ाइल अभी तैयार की जा रही है. पोस्ट एक क्षण में स्वचालित रूप से पुन: प्रयासित हो जाएगी."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perfil recién se está preparando. La publicación se volverá a intentar automáticamente en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre profil est en cours de préparation. La publication sera réessayée automatiquement dans un instant."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ إعداد ملفك الشخصي. ستتم إعادة محاولة النشر تلقائيًا بعد قليل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার প্রোফাইল শুধু প্রস্তুত করা হচ্ছে. পোস্টটি এক মুহূর্তের মধ্যে স্বয়ংক্রিয়ভাবে পুনরায় চেষ্টা করা হবে।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu perfil está apenas sendo preparado. A postagem será repetida automaticamente em alguns instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш профиль только готовится. Публикация будет автоматически повторена через мгновение."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Profil wird gerade vorbereitet. Der Beitrag wird in Kürze automatisch wiederholt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのプロフィールは現在準備中です。投稿はすぐに自動的に再試行されます。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

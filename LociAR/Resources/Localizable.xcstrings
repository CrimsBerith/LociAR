    "İnternet bağlantısı yok. Post cihazda sıraya alındı ve bağlantı geri geldiğinde yeniden denenecek." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnternet bağlantısı yok. Post cihazda sıraya alındı ve bağlantı geri geldiğinde yeniden denenecek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No internet connection. The post is queued on this device and will be retried when the connection is back."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Internetverbindung. Der Post wartet auf dem Gerät und wird erneut versucht, sobald die Verbindung zurück ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay conexión a internet. La publicación quedó en cola en el dispositivo y se reintentará cuando vuelva la conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de connexion Internet. La publication est en file d’attente sur l’appareil et sera relancée au retour de la connexion."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conexão com a internet. A publicação ficou na fila no dispositivo e será tentada de novo quando a conexão voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет подключения к интернету. Пост поставлен в очередь на устройстве и будет отправлен снова, когда подключение восстановится."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد اتصال بالإنترنت. وُضع المنشور في قائمة الانتظار على الجهاز وستُعاد محاولة نشره عند عودة الاتصال."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरनेट कनेक्शन नहीं है। पोस्ट डिवाइस पर कतार में है और कनेक्शन वापस आने पर फिर से कोशिश की जाएगी।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারনেট সংযোগ নেই। পোস্টটি ডিভাইসে সারিতে রাখা হয়েছে এবং সংযোগ ফিরলে আবার চেষ্টা করা হবে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネットに接続していません。投稿はデバイスで待機しており、接続が戻ると再試行されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有互联网连接。帖子已在设备上排队，连接恢复后将重试。"
          }
        }
      }
    },

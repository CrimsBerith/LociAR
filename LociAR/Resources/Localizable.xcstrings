    },
    "Bu kullanıcı adı başka biri tarafından kullanılıyor. Farklı bir ad dene.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kullanıcı adı başka biri tarafından kullanılıyor. Farklı bir ad dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This username is used by someone else. Try a different name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该用户名已被其他人使用。尝试使用不同的名称。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उपयोगकर्ता नाम किसी अन्य व्यक्ति द्वारा उपयोग किया जाता है. कोई भिन्न नाम आज़माएँ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nombre de usuario es utilizado por otra persona. Pruebe con un nombre diferente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nom d'utilisateur est utilisé par quelqu'un d'autre. Essayez un autre nom."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم استخدام اسم المستخدم هذا من قبل شخص آخر. جرّب اسمًا مختلفًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ব্যবহারকারীর নাম অন্য কেউ ব্যবহার করে। একটি ভিন্ন নাম চেষ্টা করুন."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nome de usuário é usado por outra pessoa. Experimente um nome diferente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это имя пользователя используется кем-то другим. Попробуйте другое имя."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Benutzername wird von einer anderen Person verwendet. Versuchen Sie es mit einem anderen Namen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このユーザー名は他の人によって使用されています。別の名前を試してください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

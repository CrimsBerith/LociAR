          "stringUnit": {
            "state": "translated",
            "value": "لقد تم إرسال تقريرك للمراجعة. شكرًا لك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রিপোর্ট পর্যালোচনার জন্য পাঠানো হয়েছে. ধন্যবাদ"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua denúncia foi enviada para análise. Obrigado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша жалоба отправлена на рассмотрение. Спасибо."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Meldung wurde zur Prüfung gesendet. Vielen Dank."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告を審査に送信しました。ありがとうございます。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Bildirimler 24 saat içinde incelenir. İçeriği görmek istemiyorsan kullanıcıyı engelleyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler 24 saat içinde incelenir. İçeriği görmek istemiyorsan kullanıcıyı engelleyebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports are reviewed within 24 hours. Block the user if you do not want to see their content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报将在 24 小时内审核。如果不想看到此用户的内容，可以屏蔽该用户。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "24 घंटे के भीतर रिपोर्ट की समीक्षा की जाती है। यदि आप उपयोगकर्ता की सामग्री नहीं देखना चाहते तो उसे ब्लॉक कर दें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las denuncias se revisan en un plazo de 24 horas. Bloquea al usuario si no quieres ver su contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signalements sont examinés sous 24 heures. Bloquez la personne si vous ne souhaitez pas voir son contenu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مراجعة التقارير خلال 24 ساعة. قم بحظر المستخدم إذا كنت لا تريد رؤية محتواه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিপোর্ট 24 ঘন্টার মধ্যে পর্যালোচনা করা হয়. আপনি যদি ব্যবহারকারীর বিষয়বস্তু দেখতে না চান তাহলে তাকে ব্লক করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As denúncias são analisadas em até 24 horas. Bloqueie o usuário se não quiser ver seu conteúdo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалобы рассматриваются в течение 24 часов. Заблокируйте пользователя, если не хотите видеть его контент."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldungen werden innerhalb von 24 Stunden geprüft. Blockieren Sie den Nutzer, wenn Sie seine Inhalte nicht sehen möchten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告は24時間以内に確認されます。コンテンツを見たくない場合は、そのユーザーをブロックしてください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Biraz daha tara veya açıkça yaklaşık yerleştirmeyi seç.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz daha tara veya açıkça yaklaşık yerleştirmeyi seç."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan some more or explicitly choose approximate placement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描更多或明确选择大致位置。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ और स्कैन करें या स्पष्ट रूप से अनुमानित प्लेसमेंट चुनें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanee un poco más o elija explícitamente la ubicación aproximada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez-en davantage ou choisissez explicitement un emplacement approximatif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بمسح المزيد أو اختر موضعًا تقريبيًا بشكل صريح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরও কিছু স্ক্যান করুন বা স্পষ্টভাবে আনুমানিক স্থান নির্বাচন করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitalize um pouco mais ou escolha explicitamente o posicionamento aproximado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте еще или явно выберите приблизительное размещение."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen Sie noch mehr oder wählen Sie explizit eine ungefähre Platzierung aus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらにスキャンするか、おおよその配置を明示的に選択します。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

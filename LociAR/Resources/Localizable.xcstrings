    "Beğeni, yorum ve takip bildirimleri burada görünür." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا إشعارات الإعجابات والتعليقات والمتابعة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লাইক, মন্তব্য ও অনুসরণের বিজ্ঞপ্তি এখানে দেখা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier erscheinen Benachrichtigungen zu Likes, Kommentaren und neuen Followern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Likes, comments and follow notifications appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen las notificaciones de Me gusta, comentarios y seguidores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications de mentions J’aime, de commentaires et de nouveaux abonnés apparaissent ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पसंद, टिप्पणियों और फ़ॉलो की सूचनाएँ यहाँ दिखाई देती हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「いいね」、コメント、フォローの通知がここに表示されます。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações de curtidas, comentários e seguidores aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появляются уведомления о лайках, комментариях и подписках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beğeni, yorum ve takip bildirimleri burada görünür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点赞、评论和关注通知会显示在这里。"
          }
        }
      }
    },
    "Beğeni, yorum, takip ve yönetici mesajı bildirimlerini al. Mesajlar kilit ekranında görünebilir." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصل على إشعارات الإعجابات والتعليقات والمتابعات ورسائل الإدارة. قد تظهر الرسائل على شاشة القفل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লাইক, মন্তব্য, অনুসরণ ও প্রশাসকের বার্তার বিজ্ঞপ্তি পান। বার্তা লক স্ক্রিনে দেখা যেতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte Mitteilungen zu Likes, Kommentaren, Followern und Admin-Nachrichten. Nachrichten können auf dem Sperrbildschirm erscheinen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get notifications for likes, comments, follows and admin messages. Messages may appear on your lock screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe notificaciones de Me gusta, comentarios, seguidores y mensajes del administrador. Los mensajes pueden aparecer en la pantalla de bloqueo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez des notifications de mentions J’aime, commentaires, abonnements et messages d’administration. Les messages peuvent apparaître sur l’écran verrouillé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइक, टिप्पणी, फ़ॉलो और व्यवस्थापक के संदेशों की सूचनाएँ पाएँ। संदेश लॉक स्क्रीन पर दिख सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いいね、コメント、フォロー、管理者メッセージの通知を受け取ります。メッセージはロック画面に表示されることがあります。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba notificações de curtidas, comentários, seguidores e mensagens de administradores. As mensagens podem aparecer na tela bloqueada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получайте уведомления о лайках, комментариях, подписчиках и сообщениях администрации. Сообщения могут появляться на экране блокировки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beğeni, yorum, takip ve yönetici mesajı bildirimlerini al. Mesajlar kilit ekranında görünebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接收点赞、评论、关注和管理员消息通知。消息可能显示在锁定屏幕上。"
          }
        }
      }
    },

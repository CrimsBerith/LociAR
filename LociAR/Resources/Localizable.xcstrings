        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर खाता अधिकतम 3 कोड दे सकता है। हर कोड सिर्फ़ एक बार इस्तेमाल हो सकता है।"
          }
        },
        "bn" : {
          "stringUnit" : {

    "Bağlantı gönderilemedi. E-posta adresini ve bağlantını kontrol et." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن إرسال الرابط. تحقق من عنوان بريدك الإلكتروني واتصالك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লিঙ্ক পাঠানো যায়নি. আপনার ইমেল ঠিকানা এবং সংযোগ পরীক্ষা করুন."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Link konnte nicht gesendet werden. Überprüfen Sie Ihre E-Mail-Adresse und Verbindung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The link could not be sent. Check your email address and connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo enviar el enlace. Verifique su dirección de correo electrónico y conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien n'a pas pu être envoyé. Vérifiez votre adresse e-mail et votre connexion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिंक नहीं भेजा जा सका. अपना ईमेल पता और कनेक्शन जांचें."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクを送信できませんでした。メールアドレスと接続を確認してください。"

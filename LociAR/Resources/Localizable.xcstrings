    "Konum doğruluğu yayın için yeterli değil (%lld m). Açık bir alanda birkaç saniye bekleyip tekrar dene." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دقة الموقع غير كافية للنشر (%lld م). انتظر بضع ثوانٍ في منطقة مفتوحة وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অবস্থান নির্ভুলতা প্রকাশ করার জন্য অপর্যাপ্ত (%lld m)। একটি খোলা জায়গায় কয়েক সেকেন্ড অপেক্ষা করুন এবং আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Standortgenauigkeit reicht für die Veröffentlichung nicht aus (%lld m). Warten Sie einige Sekunden in einem offenen Bereich und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location accuracy is insufficient to publish (%lld m). Wait a few seconds in an open area and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La precisión de la ubicación es insuficiente para publicar (%lld m). Espere unos segundos en un área abierta y vuelva a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La précision de la localisation est insuffisante pour publier (%lld m). Attendez quelques secondes dans une zone dégagée et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थान सटीकता प्रकाशित करने के लिए अपर्याप्त है (%lld m)। किसी खुले क्षेत्र में कुछ सेकंड रुकें और पुनः प्रयास करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置精度が公開するには不十分です (%lld m)。開けた場所で数秒待ってから、もう一度試してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A precisão da localização é insuficiente para publicar (%lld m). Aguarde alguns segundos em uma área aberta e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точность определения местоположения недостаточна для публикации (%lld м). Подождите несколько секунд на открытом месте и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum doğruluğu yayın için yeterli değil (%lld m). Açık bir alanda birkaç saniye bekleyip tekrar dene."

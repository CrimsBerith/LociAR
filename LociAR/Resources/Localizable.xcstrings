          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque compte peut donner jusqu'à 3 codes. Chaque code est à usage unique."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada conta pode distribuir até 3 códigos. Cada código pode ser usado uma vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый аккаунт может выдать до 3 кодов. Каждый код одноразовый."

    "Postlar şu anda yüklenemiyor. Bağlantını kontrol edip tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postlar şu anda yüklenemiyor. Bağlantını kontrol edip tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posts cannot be loaded right now. Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在无法加载帖子。检查您的连接并重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट अभी लोड नहीं की जा सकतीं. अपना कनेक्शन जांचें और पुनः प्रयास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones no se pueden cargar en este momento. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publications ne peuvent pas être chargées pour le moment. Vérifiez votre connexion et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تحميل المشاركات الآن. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পোস্ট এখন লোড করা যাবে না. আপনার সংযোগ পরীক্ষা করুন এবং আবার চেষ্টা করুন."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As postagens não podem ser carregadas no momento. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удалось загрузить публикации. Проверьте подключение и повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beiträge können derzeit nicht geladen werden. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在投稿を読み込むことができません。接続を確認して、もう一度試してください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenlik için hesabı silmeden önce yeniden doğrulama gerekiyor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For your security, verify your identity again before deleting your account."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige zu deiner Sicherheit erneut deine Identität, bevor du dein Konto löschst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por seguridad, vuelve a verificar tu identidad antes de eliminar la cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour votre sécurité, vérifiez à nouveau votre identité avant de supprimer votre compte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por segurança, verifique sua identidade novamente antes de excluir a conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для безопасности подтвердите личность ещё раз перед удалением аккаунта."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لأمانك، تحقّق من هويتك مجددًا قبل حذف حسابك."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सुरक्षा के लिए खाता मिटाने से पहले पहचान फिर से सत्यापित करना आवश्यक है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিরাপত্তার জন্য অ্যাকাউন্ট মুছে ফেলার আগে আবার পরিচয় যাচাই করতে হবে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全のため、アカウントを削除する前に再度本人確認が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为保障安全，删除账号前需要重新验证身份。"
          }
        }
      }
    },

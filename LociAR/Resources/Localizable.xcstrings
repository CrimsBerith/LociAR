        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La note en attente est en sécurité sur cet appareil. Vous pouvez réessayer de publier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",

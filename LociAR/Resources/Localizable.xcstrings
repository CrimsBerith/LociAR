    "Post zeminde. Nişanı yüzeye indir, ortala." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المنشور على الأرض. اخفض علامة التصويب إلى السطح وضعها في المنتصف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পোস্টটি মেঝেতে। জালিকাটিকে পৃষ্ঠের দিকে নিচু করুন এবং এটিকে কেন্দ্র করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Beitrag liegt auf dem Boden. Senken Sie das Fadenkreuz auf die Oberfläche und zentrieren Sie es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The post is on the floor. Lower the reticle to the surface and center it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La publicación está en el suelo. Baja la retícula a la superficie y céntrala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La publication est au sol. Abaissez le réticule vers la surface et centrez-le."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट फर्श पर है. रेटिकल को सतह पर नीचे लाएँ और उसे केन्द्रित करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポストは床にあります。レティクルを表面まで下げて中央に配置します。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A postagem está no chão. Abaixe o retículo até a superfície e centralize-o."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пост лежит на полу. Опустите сетку на поверхность и отцентрируйте ее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post zeminde. Nişanı yüzeye indir, ortala."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帖子在地板上。将十字线降低到表面并将其居中。"
          }
        }
      }
    },

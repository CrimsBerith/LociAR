    "Ödeme henüz doğrulanamadı. Tekrar ödeme yapmadan durumunu kontrol et." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödeme henüz doğrulanamadı. Tekrar ödeme yapmadan durumunu kontrol et."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your payment has not been verified yet. Check its status before paying again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Zahlung wurde noch nicht bestätigt. Prüfe den Status, bevor du erneut zahlst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pago aún no se ha verificado. Consulta su estado antes de volver a pagar."

        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платёж ещё не подтверждён. Проверьте статус перед повторной оплатой."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم التحقق من الدفع بعد. تحقّق من حالته قبل الدفع مجددًا."

        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other users cannot see your name. Your note and its location are shared immediately."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere sehen deinen Namen nicht. Deine Notiz und ihr Standort werden sofort geteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los demás usuarios no ven tu nombre. Tu nota y su ubicación se comparten al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autres utilisateurs ne voient pas votre nom. Votre note et son emplacement sont partagés immédiatement."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outros usuários não veem seu nome. Sua nota e o local são compartilhados imediatamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другие пользователи не видят ваше имя. Заметка и её местоположение публикуются сразу."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يرى المستخدمون الآخرون اسمك. تتم مشاركة ملاحظتك وموقعها فورًا."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरे उपयोगकर्ताओं को आपका नाम नहीं दिखता। आपका नोट और उसकी जगह तुरंत साझा होते हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অন্য ব্যবহারকারীরা আপনার নাম দেখতে পান না। আপনার নোট ও তার অবস্থান সঙ্গে সঙ্গে শেয়ার হয়।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のユーザーに名前は表示されません。ノートとその場所はすぐに共有されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他用户看不到你的姓名。笔记及其位置会立即分享。"
          }
        }
      }
    },

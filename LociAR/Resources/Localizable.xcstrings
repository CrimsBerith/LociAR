        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de teste do dispositivo está ativado. Os processos do servidor são mantidos locais até que a conexão seja restabelecida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим тестирования устройства включен. Серверные процессы остаются локальными до тех пор, пока соединение не будет восстановлено."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع اختبار الجهاز قيد التشغيل. يتم الاحتفاظ بعمليات الخادم محليًا حتى تتم إعادة تأسيس الاتصال."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिवाइस परीक्षण मोड चालू है. कनेक्शन पुनः स्थापित होने तक सर्वर प्रक्रियाओं को स्थानीय रखा जाता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিভাইস পরীক্ষা মোড চালু আছে। সংযোগ পুনঃস্থাপিত না হওয়া পর্যন্ত সার্ভার প্রক্রিয়া স্থানীয় রাখা হয়."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイステストモードがオンになっています。サーバー プロセスは、接続が再確立されるまでローカルに保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备测试模式已开启。服务器进程保持本地状态，直到重新建立连接。"
          }
        }
      }
    },

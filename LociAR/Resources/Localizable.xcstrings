    "Kullanıcı adı 3–30 karakter olmalı; yalnızca küçük harf, rakam, alt çizgi ve nokta içerebilir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcı adı 3–30 karakter olmalı; yalnızca küçük harf, rakam, alt çizgi ve nokta içerebilir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Username must be 3–30 characters; It can only contain lowercase letters, numbers, underscores, and periods."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Benutzername muss 3–30 Zeichen lang sein. Er darf nur Kleinbuchstaben, Zahlen, Unterstriche und Punkte enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de usuario debe tener entre 3 y 30 caracteres; Solo puede contener letras minúsculas, números, guiones bajos y puntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d'utilisateur doit comporter de 3 à 30 caractères ; Il ne peut contenir que des lettres minuscules, des chiffres, des traits de soulignement et des points."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome de usuário deve ter de 3 a 30 caracteres; Ele só pode conter letras minúsculas, números, sublinhados e pontos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя пользователя должно состоять из 3–30 символов; Он может содержать только строчные буквы, цифры, символы подчеркивания и точки."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يتكون اسم المستخدم من 3 إلى 30 حرفًا؛ يمكن أن يحتوي فقط على أحرف صغيرة وأرقام وشرطات سفلية ونقاط."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपयोगकर्ता नाम 3–30 अक्षरों का होना चाहिए। इसमें केवल छोटे अक्षर, अंक, अंडरस्कोर और बिंदु हो सकते हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যবহারকারীর নাম 3-30 অক্ষরের হতে হবে; এতে শুধুমাত্র ছোট হাতের অক্ষর, সংখ্যা, আন্ডারস্কোর এবং পিরিয়ড থাকতে পারে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザー名は 3 ～ 30 文字にする必要があります。小文字、数字、アンダースコア、ピリオドのみを含めることができます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户名必须为 3-30 个字符；它只能包含小写字母、数字、下划线和句点。"
          }
        }
      }
    },
    "Kullanıcı adını en fazla 30 günde bir değiştirebilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {

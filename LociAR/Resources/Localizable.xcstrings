    "Post cihaz test modunda saklandı. Canlı backend bağlandığında yayınlanabilir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post cihaz test modunda saklandı. Canlı backend bağlandığında yayınlanabilir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The post was saved in device test mode. It can be published once the live backend is connected."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Post wurde im Gerätetestmodus gespeichert. Er kann veröffentlicht werden, sobald das Live-Backend verbunden ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La publicación se guardó en el modo de prueba del dispositivo. Se podrá publicar cuando el backend esté conectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La publication a été enregistrée en mode test de l’appareil. Elle pourra être publiée une fois le serveur connecté."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A publicação foi salva no modo de teste do dispositivo. Ela poderá ser publicada quando o servidor estiver conectado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пост сохранён в тестовом режиме устройства. Его можно будет опубликовать после подключения сервера."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ المنشور في وضع اختبار الجهاز. يمكن نشره عند الاتصال بالخادم المباشر."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट डिवाइस परीक्षण मोड में सहेजी गई। लाइव सर्वर कनेक्ट होने पर इसे प्रकाशित किया जा सकता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পোস্টটি ডিভাইস পরীক্ষা মোডে সংরক্ষিত হয়েছে। লাইভ সার্ভার সংযুক্ত হলে প্রকাশ করা যাবে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿はデバイステストモードで保存されました。本番サーバーに接続すると公開できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帖子已保存在设备测试模式中。连接线上后端后即可发布。"
          }
        }
      }
    },
    "Post cihazda güvenle saklanamadı. Alanı boşaltıp tekrar deneyin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post cihazda güvenle saklanamadı. Alanı boşaltıp tekrar deneyin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The post couldn’t be saved safely on this device. Free up space and try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Post konnte nicht sicher auf dem Gerät gespeichert werden. Gib Speicher frei und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La publicación no se pudo guardar de forma segura en el dispositivo. Libera espacio e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La publication n’a pas pu être enregistrée en toute sécurité sur l’appareil. Libérez de l’espace et réessayez."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar a publicação com segurança no dispositivo. Libere espaço e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось надёжно сохранить пост на устройстве. Освободите место и повторите попытку."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر حفظ المنشور بأمان على الجهاز. أفرِغ بعض المساحة ثم حاول مرة أخرى."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट डिवाइस पर सुरक्षित रूप से सहेजी नहीं जा सकी। जगह खाली करें और फिर से कोशिश करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পোস্টটি ডিভাইসে নিরাপদে সংরক্ষণ করা যায়নি। জায়গা খালি করে আবার চেষ্টা করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿をデバイスに安全に保存できませんでした。空き容量を増やしてもう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

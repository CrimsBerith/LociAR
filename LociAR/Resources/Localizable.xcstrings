    "Bu bölge veya hesap için yayın sınırına ulaşıldı. Daha sonra tekrar deneyin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bölge veya hesap için yayın sınırına ulaşıldı. Daha sonra tekrar deneyin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The publishing limit for this area or account has been reached. Try again later."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Veröffentlichungslimit für diese Gegend oder dieses Konto ist erreicht. Versuche es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alcanzó el límite de publicaciones para esta zona o cuenta. Inténtalo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite de publication pour cette zone ou ce compte est atteinte. Réessayez plus tard."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O limite de publicações desta área ou conta foi atingido. Tente novamente mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достигнут лимит публикаций для этой области или аккаунта. Попробуйте позже."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم بلوغ حد النشر لهذه المنطقة أو هذا الحساب. حاول لاحقًا."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस क्षेत्र या खाते के लिए प्रकाशन सीमा पूरी हो गई है। बाद में फिर कोशिश करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই এলাকা বা অ্যাকাউন্টের প্রকাশের সীমা পূর্ণ হয়েছে। পরে আবার চেষ্টা করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエリアまたはアカウントの投稿上限に達しました。後でもう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该区域或账户的发布数量已达上限。请稍后重试。"
          }
        }
      }
    },

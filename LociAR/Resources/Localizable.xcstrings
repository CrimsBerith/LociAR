    "Şifre güncellenemedi. Kurtarma bağlantısını yeniden iste." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şifre güncellenemedi. Kurtarma bağlantısını yeniden iste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not update the password. Request a new reset link."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort konnte nicht aktualisiert werden. Fordern Sie einen neuen Link zum Zurücksetzen an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo actualizar la contraseña. Solicita un nuevo enlace para restablecerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de mettre à jour le mot de passe. Demandez un nouveau lien de réinitialisation."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível atualizar a senha. Solicite um novo link de redefinição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось обновить пароль. Запросите новую ссылку для сброса."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر تحديث كلمة المرور. اطلب رابط إعادة تعيين جديدًا."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासवर्ड अपडेट नहीं किया जा सका। नया रीसेट लिंक माँगें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পাসওয়ার্ড আপডেট করা যায়নি। নতুন রিসেট লিঙ্কের অনুরোধ করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードを更新できませんでした。新しい再設定リンクをリクエストしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法更新密码。请重新获取重置链接。"
          }
        }
      }
    },
    "Şifre yenileme bağlantısını gönderdik. Bağlantı LociAR’da yeni şifre ekranını açacak." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şifre yenileme bağlantısını gönderdik. Bağlantı LociAR’da yeni şifre ekranını açacak."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We have sent you the password reset link. The link will open the new password screen in LociAR."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben Ihnen den Link zum Zurücksetzen des Passworts gesendet. Der Link öffnet den neuen Passwortbildschirm in LociAR."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le hemos enviado el enlace para restablecer la contraseña. El enlace abrirá la pantalla de nueva contraseña en LociAR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous vous avons envoyé le lien de réinitialisation du mot de passe. Le lien ouvrira l’écran du nouveau mot de passe dans LociAR."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviamos a você o link de redefinição de senha. O link abrirá a tela de nova senha no LociAR."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы отправили вам ссылку для сброса пароля. Ссылка откроет экран нового пароля в LociAR."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد أرسلنا لك رابط إعادة تعيين كلمة المرور. سيفتح الرابط شاشة كلمة المرور الجديدة في LociAR."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमने आपको पासवर्ड रीसेट लिंक भेज दिया है। लिंक LociAR में नई पासवर्ड स्क्रीन खोलेगा।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমরা আপনাকে পাসওয়ার্ড রিসেট লিঙ্ক পাঠিয়েছি। লিঙ্কটি LociAR-এ নতুন পাসওয়ার্ড স্ক্রীন খুলবে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードリセットリンクを送信しました。リンクをクリックすると、LociAR の新しいパスワード画面が開きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们已向您发送了密码重置链接。该链接将在 LociAR 中打开新密码屏幕。"
          }
        }
      }
    },

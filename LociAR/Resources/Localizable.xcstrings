    "Kaydedilen postlar şu anda yüklenemiyor.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen postlar şu anda yüklenemiyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved posts cannot be loaded at this time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法加载已保存的帖子。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समय सहेजे गए पोस्ट लोड नहीं किए जा सकते."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones guardadas no se pueden cargar en este momento."
          }
        },
        "fr": {

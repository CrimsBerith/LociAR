    "Silme isteğiniz alındı. İşlem arka planda tamamlanacak." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم قبول طلب حذف حسابك. ستكتمل العملية في الخلفية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অ্যাকাউন্ট মুছে ফেলার অনুরোধ গ্রহণ করা হয়েছে। প্রক্রিয়াটি ব্যাকগ্রাউন্ডে সম্পন্ন হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Löschanfrage wurde angenommen. Der Vorgang wird im Hintergrund abgeschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your deletion request was accepted. It will finish in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha aceptado tu solicitud de eliminación. El proceso se completará en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre demande de suppression a été acceptée. Le traitement se terminera en arrière-plan."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका खाता मिटाने का अनुरोध स्वीकार कर लिया गया है। यह प्रक्रिया पृष्ठभूमि में पूरी होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

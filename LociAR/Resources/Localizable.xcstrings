    "İstersen AR ile bir yüzeye sabitle." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تثبيتها على سطح بالواقع المعزز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AR দিয়ে কোনো পৃষ্ঠে পিন করতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst sie mit AR an einer Oberfläche befestigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can pin it to a surface with AR."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes fijarla a una superficie con AR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez la fixer à une surface avec l’AR."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप इसे AR से किसी सतह पर पिन कर सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ARで表面に固定することもできます。"

    "Yaklaşık yerleştirme açık kullanıcı onayı olmadan reddedildi.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık yerleştirme açık kullanıcı onayı olmadan reddedildi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate placement was rejected because you have not explicitly confirmed it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近似放置被拒绝，因为您尚未明确确认。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमानित प्लेसमेंट अस्वीकार कर दिया गया क्योंकि आपने इसकी स्पष्ट रूप से पुष्टि नहीं की है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación aproximada fue rechazada porque no la confirmó explícitamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le placement approximatif a été refusé car vous ne l'avez pas explicitement confirmé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الموضع التقريبي لأنك لم تؤكده بشكل صريح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আনুমানিক প্লেসমেন্ট প্রত্যাখ্যান করা হয়েছে কারণ আপনি এটি স্পষ্টভাবে নিশ্চিত করেননি।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O posicionamento aproximado foi rejeitado porque você não o confirmou explicitamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приблизительное размещение было отклонено, поскольку вы не подтвердили его явным образом."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ungefähre Platzierung wurde abgelehnt, da Sie sie nicht ausdrücklich bestätigt haben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明示的に確認していないため、おおよその配置は拒否されました。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सतह रिकॉर्ड सीमित है लेकिन इस्तेमाल योग्य है। मज़बूत लॉक के लिए फ़ोन धीरे-धीरे हिलाएँ।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পৃষ্ঠ রেকর্ড সীমিত হলেও ব্যবহারযোগ্য। আরও শক্ত লকের জন্য ফোনটি ধীরে সরান।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面の記録は限定的ですが使用できます。よりしっかり固定するには、電話をゆっくり動かしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

            "value": "说明不能超过 220 个字符。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्शन 220 अक्षरों से अधिक नहीं हो सकता."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descripción no puede superar los 220 caracteres."

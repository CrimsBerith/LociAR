    "Paylaşırken baktığın duvara dön. Telefonu yavaşça çevir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşırken baktığın duvara dön. Telefonu yavaşça çevir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face the wall you were looking at when you posted. Slowly turn the phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面向您发帖时所看着的墙壁。慢慢转动手机。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस दीवार का सामना करें जिसे आप पोस्ट करते समय देख रहे थे। फोन को धीरे-धीरे घुमाएं."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mire hacia la pared que estaba mirando cuando publicó. Gira lentamente el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites face au mur que vous regardiez lorsque vous avez posté. Tournez lentement le téléphone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واجه الحائط الذي كنت تنظر إليه عندما نشرت. أدر الهاتف ببطء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি পোস্ট করার সময় যে দেয়ালের দিকে তাকিয়ে ছিলেন তার দিকে মুখ করুন। আস্তে আস্তে ফোনটা ঘুরিয়ে দাও।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique de frente para a parede que você estava olhando quando postou. Vire lentamente o telefone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернитесь к стене, на которую смотрели при размещении публикации. Медленно поворачивайте телефон."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie sich vor die Wand, auf die Sie geschaut haben, als Sie gepostet haben. Drehen Sie das Telefon langsam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿したときに見ていた壁に向かってください。ゆっくりと電話の向きを変えます。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось обновить профиль. Проверьте соединение и повторите попытку."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر تحديث ملفك الشخصي. تحقق من اتصالك وحاول مجددًا."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोफ़ाइल अपडेट नहीं की जा सकी। कनेक्शन जाँचें और फिर से प्रयास करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রোফাইল আপডেট করা যায়নি। সংযোগ পরীক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールを更新できませんでした。接続を確認して再試行してください。"

        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على السطح، لكن تعذر عرض المحتوى. حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পৃষ্ঠ পাওয়া গেছে, কিন্তু বিষয়বস্তু দেখানো যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A superfície foi encontrada, mas não foi possível mostrar o conteúdo. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверхность найдена, но не удалось отобразить содержимое. Попробуйте ещё раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Oberfläche wurde gefunden, aber der Inhalt konnte nicht angezeigt werden. Versuchen Sie es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",

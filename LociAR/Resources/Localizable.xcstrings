    "Çeviri cihazında yapılır. Desteklenmeyen dillerde orijinal metin gösterilir." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم الترجمة على جهازك. يظهر النص الأصلي للغات غير المدعومة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনুবাদ আপনার ডিভাইসেই হয়। অসমর্থিত ভাষায় মূল লেখা দেখানো হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Übersetzung erfolgt auf deinem Gerät. Bei nicht unterstützten Sprachen wird das Original angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Translation happens on your device. Unsupported languages show the original text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La traducción se realiza en tu dispositivo. En los idiomas no compatibles se muestra el texto original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La traduction se fait sur votre appareil. Le texte original est affiché pour les langues non prises en charge."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुवाद आपके डिवाइस पर होता है। असमर्थित भाषाओं में मूल पाठ दिखता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳は端末上で行います。未対応の言語では原文を表示します。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tradução acontece no seu dispositivo. Idiomas não compatíveis mostram o texto original."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевод выполняется на устройстве. Для неподдерживаемых языков показывается оригинал."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çeviri cihazında yapılır. Desteklenmeyen dillerde orijinal metin gösterilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

    "Bağlantı ayarı tamamlandığında yakındaki postlar burada görünecek." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر المشاركات القريبة هنا عند اكتمال إعدادات الاتصال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংযোগ সেটিংস সম্পূর্ণ হলে কাছাকাছি পোস্ট এখানে প্রদর্শিত হবে."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald die Verbindungseinstellungen abgeschlossen sind, werden hier Beiträge in der Nähe angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nearby posts will appear here when the connection settings are complete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las publicaciones cercanas aparecerán aquí cuando se complete la configuración de la conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les publications à proximité apparaîtront ici lorsque les paramètres de connexion seront terminés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कनेक्शन सेटिंग पूरी होने पर आस-पास की पोस्टें यहां दिखाई देंगी."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続設定が完了すると、近くの投稿がここに表示されます。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As postagens próximas aparecerão aqui quando as configurações de conexão forem concluídas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соседние публикации появятся здесь после завершения настройки соединения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı ayarı tamamlandığında yakındaki postlar burada görünecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Konto kann bis zu 3 Codes vergeben. Jeder Code ist nur einmal verwendbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each account can give out up to 3 codes. Each code can be used once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cuenta puede dar hasta 3 códigos. Cada código es de un solo uso."

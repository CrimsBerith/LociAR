          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить электронное письмо. Пожалуйста, повторите попытку через минуту."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail konnte nicht gesendet werden. Bitte versuchen Sie es gleich noch einmal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールを送信できませんでした。しばらくしてからもう一度お試しください。"
          }

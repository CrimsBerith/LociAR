    "Postu aynı yüzeyde yeniden açabilmek için telefonu çevrede yavaşça gezdir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postu aynı yüzeyde yeniden açabilmek için telefonu çevrede yavaşça gezdir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the phone around slowly to reopen the post on the same surface."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓慢移动手机以在同一表面上重新打开帖子。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट को उसी सतह पर फिर से खोलने के लिए फ़ोन को धीरे-धीरे इधर-उधर घुमाएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueva el teléfono lentamente para volver a abrir la publicación en la misma superficie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez lentement le téléphone pour rouvrir la publication sur la même surface."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرك الهاتف ببطء لإعادة فتح المنشور على نفس السطح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একই পৃষ্ঠে পোস্টটি আবার খুলতে ফোনটিকে ধীরে ধীরে ঘুরান৷"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova o telefone lentamente para reabrir a postagem na mesma superfície."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно перемещайте телефон, чтобы снова открыть публикацию на той же поверхности."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegen Sie das Telefon langsam, um den Beitrag auf derselben Oberfläche erneut zu öffnen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "携帯電話をゆっくりと動かして、同じ面で投稿を再度開きます。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."

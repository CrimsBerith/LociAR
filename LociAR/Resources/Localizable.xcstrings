    "Devam etmek için telefonu dokulu yüzeyin çevresinde yavaşça gezdir ve ışığı artır." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للمتابعة، حرك الهاتف ببطء حول السطح المزخرف وقم بزيادة الضوء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চালিয়ে যেতে, আস্তে আস্তে ফোনটিকে টেক্সচারযুক্ত পৃষ্ঠের চারপাশে সরান এবং আলো বাড়ান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um fortzufahren, bewegen Sie das Telefon langsam über die strukturierte Oberfläche und erhöhen Sie die Lichtstärke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To continue, slowly move the phone around the textured surface and increase the light."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para continuar, mueva lentamente el teléfono por la superficie texturizada y aumente la luz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour continuer, déplacez lentement le téléphone autour de la surface texturée et augmentez la lumière."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जारी रखने के लिए, फ़ोन को बनावट वाली सतह के चारों ओर धीरे-धीरे घुमाएँ और रोशनी बढ़ाएँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続行するには、テクスチャ表面上で携帯電話をゆっくりと動かし、光を増やします。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para continuar, mova lentamente o telefone pela superfície texturizada e aumente a luz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы продолжить, медленно перемещайте телефон по текстурированной поверхности и увеличивайте освещенность."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

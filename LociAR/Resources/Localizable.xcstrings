          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your username, note and its location are shared immediately."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Benutzername, deine Notiz und ihr Standort werden sofort geteilt."
          }

    "Konum doğruluğu yayın için yeterli değil (%lld m). Açık bir alanda birkaç saniye bekleyip tekrar dene." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum doğruluğu yayın için yeterli değil (%lld m). Açık bir alanda birkaç saniye bekleyip tekrar dene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location accuracy isn’t good enough to publish (%lld m). Wait a few seconds in an open area and try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Standortgenauigkeit reicht zum Veröffentlichen nicht aus (%lld m). Warte im Freien ein paar Sekunden und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La precisión de la ubicación no es suficiente para publicar (%lld m). Espera unos segundos en un lugar abierto e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La précision de la position est insuffisante pour publier (%lld m). Attendez quelques secondes dans un espace dégagé et réessayez."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A precisão da localização não é suficiente para publicar (%lld m). Aguarde alguns segundos em uma área aberta e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точности местоположения недостаточно для публикации (%lld м). Подождите несколько секунд на открытом месте и повторите попытку."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دقة الموقع غير كافية للنشر (%lld م). انتظر بضع ثوانٍ في مكان مفتوح ثم حاول مرة أخرى."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रकाशित करने के लिए स्थान की सटीकता पर्याप्त नहीं है (%lld मी)। खुली जगह पर कुछ सेकंड रुकें और फिर से कोशिश करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রকাশের জন্য অবস্থানের নির্ভুলতা যথেষ্ট নয় (%lld মি)। খোলা জায়গায় কয়েক সেকেন্ড অপেক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報の精度が投稿に十分ではありません（%lld m）。開けた場所で数秒待ってから、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置精度不足以发布（%lld 米）。请在开阔处等待几秒后重试。"
          }
        }
      }
    },

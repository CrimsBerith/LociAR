    "Postlarınız ve sosyal verileriniz sunucudan silinir. Bu işlem geri alınamaz." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postlarınız ve sosyal verileriniz sunucudan silinir. Bu işlem geri alınamaz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your posts and social data are deleted from the server. This can’t be undone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Posts und sozialen Daten werden vom Server gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus publicaciones y datos sociales se eliminan del servidor. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos publications et données sociales sont supprimées du serveur. Cette action est irréversible."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas publicações e dados sociais são excluídos do servidor. Essa ação não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши посты и социальные данные удаляются с сервера. Это действие нельзя отменить."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحذف منشوراتك وبياناتك الاجتماعية من الخادم. لا يمكن التراجع عن ذلك."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी पोस्ट और सोशल डेटा सर्वर से हटा दिए जाते हैं। इसे पूर्ववत नहीं किया जा सकता।"

    "Caption veya geçerli bir sosyal bağlantı ekle.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caption veya geçerli bir sosyal bağlantı ekle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a caption or a valid social link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加说明或有效的社交链接。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्शन या मान्य सोशल लिंक जोड़ें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una descripción o un enlace social válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une légende ou un lien social valide."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف وصفًا أو رابطًا صالحًا لوسائل التواصل الاجتماعي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ক্যাপশন বা বৈধ সোশ্যাল লিঙ্ক যোগ করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma legenda ou um link social válido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте подпись или действительную ссылку на соцсеть."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie eine Beschreibung oder einen gültigen Link zu sozialen Medien hinzu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプションまたは有効なソーシャルリンクを追加してください。"
          }
        }
      }
    },

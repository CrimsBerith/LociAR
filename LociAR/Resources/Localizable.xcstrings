    "Profilin henüz hazırlanıyor. Post birazdan otomatik olarak yeniden denenecek." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profilin henüz hazırlanıyor. Post birazdan otomatik olarak yeniden denenecek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your profile is still being prepared. The post will be retried automatically shortly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Profil wird noch vorbereitet. Der Post wird gleich automatisch erneut versucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu perfil aún se está preparando. La publicación se reintentará automáticamente en breve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre profil est encore en préparation. La publication sera relancée automatiquement sous peu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu perfil ainda está sendo preparado. A publicação será tentada de novo automaticamente em breve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш профиль ещё готовится. Публикация будет автоматически повторена через некоторое время."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال ملفك الشخصي قيد التجهيز. ستُعاد محاولة نشر المنشور تلقائيًا بعد قليل."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी प्रोफ़ाइल अभी तैयार हो रही है। पोस्ट को जल्द ही अपने आप फिर से आज़माया जाएगा।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার প্রোফাইল এখনো প্রস্তুত হচ্ছে। পোস্টটি শিগগির আপনা থেকে আবার চেষ্টা করা হবে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールを準備中です。投稿はまもなく自動で再試行されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的个人资料仍在准备中。帖子稍后会自动重试发布。"
          }
        }
      }
    },

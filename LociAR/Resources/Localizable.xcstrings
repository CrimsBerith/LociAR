    "E-posta adresin henüz doğrulanmadı. Gelen kutundaki bağlantıya dokunduktan sonra tekrar giriş yap." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم التحقق من عنوان بريدك الإلكتروني بعد. اضغط على الرابط الموجود في صندوق الوارد الخاص بك، ثم قم بتسجيل الدخول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ইমেল ঠিকানা এখনও যাচাই করা হয়নি. আপনার ইনবক্সে লিঙ্কটি আলতো চাপুন, তারপর আবার লগ ইন করুন৷"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre E-Mail-Adresse wurde noch nicht bestätigt. Tippen Sie auf den Link in Ihrem Posteingang und melden Sie sich dann erneut an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your email address has not been verified yet. Tap the link in your inbox, then log in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su dirección de correo electrónico aún no ha sido verificada. Toque el enlace en su bandeja de entrada y luego inicie sesión nuevamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre adresse e-mail n'a pas encore été vérifiée. Appuyez sur le lien dans votre boîte de réception, puis reconnectez-vous."

    "Apple ile giriş tamamlanamadı." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ile giriş tamamlanamadı."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in with Apple couldn’t be completed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung mit Apple konnte nicht abgeschlossen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo completar el inicio de sesión con Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion avec Apple n’a pas pu aboutir."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível concluir o login com a Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось завершить вход через Apple."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إكمال تسجيل الدخول باستخدام Apple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple से साइन इन पूरा नहीं हो सका।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple দিয়ে সাইন ইন সম্পন্ন করা যায়নি।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleでサインインを完了できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法完成通过 Apple 登录。"
          }
        }
      }
    },
    "Apple ile giriş şu anda tamamlanamadı. Tekrar dene." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ile giriş şu anda tamamlanamadı. Tekrar dene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in with Apple couldn’t be completed right now. Try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung mit Apple konnte gerade nicht abgeschlossen werden. Versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo completar el inicio de sesión con Apple ahora. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {

    "Yüzey aranıyor. Kamerayı postun bırakıldığı yere doğrult ve yavaşça gezdir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüzey aranıyor. Kamerayı postun bırakıldığı yere doğrult ve yavaşça gezdir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looking for the surface. Point the camera where the post was left and move it slowly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fläche wird gesucht. Richte die Kamera auf die Stelle, an der der Post hinterlassen wurde, und bewege sie langsam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscando la superficie. Apunta la cámara donde se dejó la publicación y muévela despacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche de la surface. Pointez la caméra là où la publication a été laissée et déplacez-la lentement."

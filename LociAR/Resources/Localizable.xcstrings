    "İnternet bağlantısı yok. Post cihazda sıraya alındı ve bağlantı geri geldiğinde yeniden denenecek." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد اتصال بالإنترنت. يتم وضع المنشور في قائمة الانتظار على الجهاز وستتم تجربته مرة أخرى عند استعادة الاتصال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইন্টারনেট সংযোগ নেই। পোস্টটি ডিভাইসে সারিবদ্ধ আছে এবং সংযোগ পুনরুদ্ধার করা হলে আবার চেষ্টা করা হবে৷"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es besteht keine Internetverbindung. Der Beitrag wird auf dem Gerät in die Warteschlange gestellt und es wird erneut versucht, wenn die Verbindung wiederhergestellt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no internet connection. The post is queued on the device and will be tried again when the connection is restored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay conexión a Internet. La publicación está en cola en el dispositivo y se intentará nuevamente cuando se restablezca la conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a pas de connexion Internet. La publication est mise en file d'attente sur l'appareil et sera réessayée lorsque la connexion sera rétablie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई इंटरनेट कनेक्शन नहीं है. पोस्ट डिवाइस पर कतारबद्ध है और कनेक्शन बहाल होने पर फिर से प्रयास किया जाएगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネット接続がありません。投稿はデバイスのキューに入れられ、接続が復元されたときに再試行されます。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há conexão com a Internet. A postagem está na fila do dispositivo e será tentada novamente quando a conexão for restaurada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет подключения к Интернету. Публикация помещена в очередь на устройстве и будет повторена, когда соединение будет восстановлено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnternet bağlantısı yok. Post cihazda sıraya alındı ve bağlantı geri geldiğinde yeniden denenecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有互联网连接。该帖子在设备上排队，并在连接恢复后再次尝试。"
          }
        }
      }
    },
    "iOS arka plan çalışmasını sınırlayabilir. Uygulamayı zorla kapatırsan konum bildirimi gecikebilir veya gelmeyebilir." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يحدّ iOS من النشاط في الخلفية. إذا أغلقت التطبيق قسريًا، فقد تتأخر إشعارات الموقع أو لا تصل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS পটভূমির কার্যকলাপ সীমিত করতে পারে। অ্যাপ জোর করে বন্ধ করলে অবস্থানের বিজ্ঞপ্তি দেরিতে আসতে পারে বা নাও আসতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS kann die Hintergrundaktivität einschränken. Wenn du die App zwangsweise beendest, können Standortmitteilungen verspätet oder gar nicht eintreffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS may limit background activity. If you force quit the app, location notifications may be delayed or may not arrive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS puede limitar la actividad en segundo plano. Si fuerzas el cierre de la app, las notificaciones de ubicación pueden retrasarse o no llegar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS peut limiter l’activité en arrière-plan. Si vous forcez la fermeture de l’app, les notifications de position peuvent être retardées ou ne pas arriver."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS बैकग्राउंड गतिविधि सीमित कर सकता है। अगर आप ऐप को बलपूर्वक बंद करते हैं, तो स्थान सूचनाएँ देर से आ सकती हैं या नहीं आ सकतीं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS によりバックグラウンド動作が制限される場合があります。アプリを強制終了すると、位置情報の通知が遅れたり届かなかったりする場合があります。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS pode limitar a atividade em segundo plano. Se você fechar o app à força, as notificações de localização podem atrasar ou não chegar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS может ограничивать работу в фоне. Если принудительно закрыть приложение, уведомления о местоположении могут задержаться или не прийти."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS arka plan çalışmasını sınırlayabilir. Uygulamayı zorla kapatırsan konum bildirimi gecikebilir veya gelmeyebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 可能会限制后台运行。如果强制关闭应用，位置通知可能会延迟或无法送达。"
          }
        }
      }
    },

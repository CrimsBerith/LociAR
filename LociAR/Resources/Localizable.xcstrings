    "Panoda geçerli bir %@ paylaşım bağlantısı bulunamadı. İçerikte Paylaş → Bağlantıyı kopyala adımını kullan.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panoda geçerli bir %@ paylaşım bağlantısı bulunamadı. İçerikte Paylaş → Bağlantıyı kopyala adımını kullan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No valid %@ share link was found in the clipboard. Use Share → Copy link in the content’s app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在剪贴板中找不到有效的 %@ 共享链接。使用内容应用程序中的共享 → 复制链接。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिपबोर्ड में कोई वैध %@ शेयर लिंक नहीं मिला। सामग्री के ऐप में शेयर → लिंक कॉपी करें का उपयोग करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún enlace compartido %@ válido en el portapapeles. Utilice Compartir → Copiar enlace en la aplicación del contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun lien de partage %@ valide n'a été trouvé dans le presse-papiers. Utilisez Partager → Copier le lien dans l'application du contenu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على رابط مشاركة %@ صالح في الحافظة. استخدم مشاركة → نسخ الرابط في تطبيق المحتوى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্লিপবোর্ডে কোনো বৈধ %@ শেয়ার লিঙ্ক পাওয়া যায়নি। কন্টেন্ট অ্যাপে শেয়ার → কপি লিঙ্ক ব্যবহার করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum link de compartilhamento %@ válido foi encontrado na área de transferência. Use Compartilhar → Copiar link no aplicativo de conteúdo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В буфере обмена не найдена действительная ссылка общего доступа %@. Используйте «Поделиться» → «Скопировать ссылку» в приложении контента."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Zwischenablage wurde kein gültiger %@-Freigabelink gefunden. Verwenden Sie „Teilen“ → „Link kopieren“ in der App des Inhalts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な %@ 共有リンクがクリップボードに見つかりませんでした。コンテンツのアプリで [共有] → [リンクをコピー] を使用します。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

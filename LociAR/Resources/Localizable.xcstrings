          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете менять свое имя пользователя не чаще, чем каждые 30 дней."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تغيير اسم المستخدم مرة واحدة فقط كل 30 يومًا."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अधिकतम हर 30 दिन में अपना उपयोगकर्ता नाम बदल सकते हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি সর্বাধিক প্রতি 30 দিনে আপনার ব্যবহারকারীর নাম পরিবর্তন করতে পারেন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザー名の変更は30日に1回までです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您最多每 30 天可以更改一次用户名。"
          }
        }
      }
    },

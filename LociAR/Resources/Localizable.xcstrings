        }
      }
    },
    "Postlar yalnızca metin ve GIF içerebilir; fotoğraf, video, çizim ve bağlantı desteklenmiyor." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن تحتوي المنشورات على نص وصور GIF فقط؛ الصور ومقاطع الفيديو والرسومات والروابط غير مدعومة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পোস্টে শুধু পাঠ্য ও GIF থাকতে পারে; ফটো, ভিডিও, আঁকা ছবি ও লিঙ্ক সমর্থিত নয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiträge dürfen nur Text und GIFs enthalten; Fotos, Videos, Zeichnungen und Links werden nicht unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posts may contain only text and GIFs; photos, videos, drawings and links are not supported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las publicaciones solo pueden contener texto y GIF; no se admiten fotos, vídeos, dibujos ni enlaces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

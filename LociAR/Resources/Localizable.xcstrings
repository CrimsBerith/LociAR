    "Devam etmek için telefonu dokulu yüzeyin çevresinde yavaşça gezdir ve ışığı artır." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam etmek için telefonu dokulu yüzeyin çevresinde yavaşça gezdir ve ışığı artır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To continue, slowly move the phone around the textured surface and add more light."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege das Telefon langsam um die strukturierte Fläche und sorge für mehr Licht, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para continuar, mueve el teléfono despacio alrededor de la superficie con textura y añade más luz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour continuer, déplacez lentement le téléphone autour de la surface texturée et ajoutez de la lumière."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para continuar, mova o telefone devagar ao redor da superfície com textura e aumente a iluminação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы продолжить, медленно водите телефоном вокруг текстурированной поверхности и добавьте света."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للمتابعة، حرّك الهاتف ببطء حول السطح ذي التفاصيل وزِد الإضاءة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जारी रखने के लिए फ़ोन को बनावट वाली सतह के चारों ओर धीरे-धीरे घुमाएँ और रोशनी बढ़ाएँ।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চালিয়ে যেতে ফোনটি টেক্সচারযুক্ত পৃষ্ঠের চারপাশে ধীরে সরান এবং আলো বাড়ান।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続けるには、模様のある面の周りで電話をゆっくり動かし、明るくしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要继续，请绕着有纹理的表面缓慢移动手机，并增加光线。"
          }
        }
      }
    },

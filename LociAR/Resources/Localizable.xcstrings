        }
      }
    },
    "Bağlantı ayarları henüz tamamlanmadı. Uygulama yöneticisiyle iletişime geçin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تكتمل إعدادات الاتصال بعد. اتصل بمسؤول التطبيق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংযোগের সেটিংস এখনও সম্পন্ন হয়নি। অ্যাপের প্রশাসকের সাথে যোগাযোগ করুন।"

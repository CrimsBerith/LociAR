        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma superfície estável foi encontrada aqui. Mova o retículo central pela superfície ou escolha um posicionamento aproximado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устойчивой поверхности здесь обнаружено не было. Переместите центральную сетку по поверхности или выберите приблизительное расположение."

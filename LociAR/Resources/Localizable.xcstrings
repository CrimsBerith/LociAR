    "Telefonu sabit tut ve Yüzeye sabitle’ye dokun." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمسك الهاتف بثبات واضغط على «تثبيت على السطح»."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফোনটি স্থির রাখুন এবং «পৃষ্ঠে স্থির করুন»-এ ট্যাপ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie das Telefon ruhig und tippen Sie auf „An Oberfläche fixieren“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the phone steady and tap Anchor to surface."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el teléfono quieto y toca «Fijar a la superficie»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le téléphone immobile et appuyez sur «Ancrer à la surface»."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन को स्थिर रखें और «सतह पर स्थिर करें» पर टैप करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンを動かさずに持ち、「表面に固定」をタップしてください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure o telefone com firmeza e toque em Fixar na superfície."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите телефон неподвижно и нажмите «Закрепить на поверхности»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonu sabit tut ve Yüzeye sabitle’ye dokun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平稳握住手机并点击“固定到表面”。"
          }
        }
      }
    },
    "Telefonu yavaşça çevirmeye devam et; ±5 m’ye inince konum otomatik kullanılır." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واصل تدوير الهاتف ببطء؛ سيُستخدم الموقع تلقائيًا عندما تصل الدقة إلى ±5 م."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফোনটি ধীরে ধীরে ঘোরাতে থাকুন; ±5 মি-তে পৌঁছালে অবস্থানটি স্বয়ংক্রিয়ভাবে ব্যবহার হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drehe das Telefon weiter langsam; bei ±5 m wird die Position automatisch übernommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep turning the phone slowly; the position is used automatically once it reaches ±5 m."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue girando el teléfono despacio; la posición se usará automáticamente al llegar a ±5 m."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuez à tourner lentement le téléphone ; la position est utilisée automatiquement dès qu’elle atteint ±5 m."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन को धीरे-धीरे घुमाते रहें; ±5 मी तक पहुँचते ही लोकेशन अपने-आप इस्तेमाल होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンをゆっくり回し続けてください。±5 m になると位置が自動で使われます。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue girando o telefone devagar; a posição é usada automaticamente ao chegar a ±5 m."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжайте медленно поворачивать телефон; при точности ±5 м позиция будет использована автоматически."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonu yavaşça çevirmeye devam et; ±5 m’ye inince konum otomatik kullanılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续缓慢转动手机；精度达到 ±5 米时将自动使用该位置。"
          }
        }
      }
    },

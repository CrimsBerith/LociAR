    "AR oturumu beklenmedik şekilde durdu. Tekrar deneyin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AR oturumu beklenmedik şekilde durdu. Tekrar deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AR session stopped unexpectedly. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AR 会话意外停止。再试一次。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एआर सत्र अप्रत्याशित रूप से रुक गया। पुनः प्रयास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de AR se detuvo inesperadamente. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session AR s’est arrêtée de manière inattendue. Réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت جلسة AR بشكل غير متوقع. حاول ثانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এআর সেশন অপ্রত্যাশিতভাবে বন্ধ হয়ে গেছে। আবার চেষ্টা করুন"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão de AR parou inesperadamente. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс AR неожиданно прервался. Попробуйте еще раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die AR-Sitzung wurde unerwartet beendet. Versuchen Sie es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AR セッションが予期せず停止しました。もう一度やり直してください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "AR oturumu yeniden eşleştiriliyor.": {

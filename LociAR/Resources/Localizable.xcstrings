    "Not şu anda silinemiyor. Bağlantını kontrol edip tekrar dene." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not şu anda silinemiyor. Bağlantını kontrol edip tekrar dene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The note cannot be deleted at this time. Check your connection and try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notiz kann derzeit nicht gelöscht werden. Prüfe deine Verbindung und versuche es erneut."
          }

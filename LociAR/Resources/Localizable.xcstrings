    "Yerel yüzey kaydı boş veya 50 MB sınırını aşıyor." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel yüzey kaydı boş veya 50 MB sınırını aşıyor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local surface record is empty or exceeds the 50 MB limit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der lokale Oberflächendatensatz ist leer oder überschreitet die 50-MB-Grenze."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de superficie local está vacío o supera el límite de 50 MB."

    "Her hesap en fazla 3 kod verebilir. Her kod tek kullanımlıktır." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her hesap en fazla 3 kod verebilir. Her kod tek kullanımlıktır."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each account can give out up to 3 codes. Each code can be used once."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Konto kann bis zu 3 Codes vergeben. Jeder Code ist nur einmal verwendbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cuenta puede dar hasta 3 códigos. Cada código es de un solo uso."

    "Notların ve sosyal verilerin sunucudan silinir. Bu işlem geri alınamaz." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف ملاحظاتك وبياناتك الاجتماعية من الخادم. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার নোট ও সামাজিক তথ্য সার্ভার থেকে মুছে যাবে। এই কাজ পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Notizen und sozialen Daten werden vom Server gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your notes and social data will be deleted from the server. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus notas y datos sociales se eliminarán del servidor. Esta acción no se puede deshacer."

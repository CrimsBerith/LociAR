    "Kullanıcı adı 3–30 karakter olmalı; yalnızca küçük harf, rakam, alt çizgi ve nokta içerebilir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adı 3–30 karakter olmalı; yalnızca küçük harf, rakam, alt çizgi ve nokta içerebilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Username must be 3–30 characters; It can only contain lowercase letters, numbers, underscores, and periods."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名必须为 3-30 个字符；它只能包含小写字母、数字、下划线和句点。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोगकर्ता नाम 3–30 अक्षरों का होना चाहिए। इसमें केवल छोटे अक्षर, अंक, अंडरस्कोर और बिंदु हो सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de usuario debe tener entre 3 y 30 caracteres; Solo puede contener letras minúsculas, números, guiones bajos y puntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d'utilisateur doit comporter de 3 à 30 caractères ; Il ne peut contenir que des lettres minuscules, des chiffres, des traits de soulignement et des points."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يتكون اسم المستخدم من 3 إلى 30 حرفًا؛ يمكن أن يحتوي فقط على أحرف صغيرة وأرقام وشرطات سفلية ونقاط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যবহারকারীর নাম 3-30 অক্ষরের হতে হবে; এতে শুধুমাত্র ছোট হাতের অক্ষর, সংখ্যা, আন্ডারস্কোর এবং পিরিয়ড থাকতে পারে।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome de usuário deve ter de 3 a 30 caracteres; Ele só pode conter letras minúsculas, números, sublinhados e pontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя пользователя должно состоять из 3–30 символов; Он может содержать только строчные буквы, цифры, символы подчеркивания и точки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Benutzername muss 3–30 Zeichen lang sein. Er darf nur Kleinbuchstaben, Zahlen, Unterstriche und Punkte enthalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー名は 3 ～ 30 文字にする必要があります。小文字、数字、アンダースコア、ピリオドのみを含めることができます。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Kullanıcı adını en fazla 30 günde bir değiştirebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adını en fazla 30 günde bir değiştirebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change your username only once every 30 days."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您最多每 30 天可以更改一次用户名。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अधिकतम हर 30 दिन में अपना उपयोगकर्ता नाम बदल सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar tu nombre de usuario como máximo cada 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez changer votre nom d'utilisateur au maximum tous les 30 jours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تغيير اسم المستخدم مرة واحدة فقط كل 30 يومًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি সর্বাধিক প্রতি 30 দিনে আপনার ব্যবহারকারীর নাম পরিবর্তন করতে পারেন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode alterar seu nome de usuário no máximo a cada 30 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете менять свое имя пользователя не чаще, чем каждые 30 дней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können Ihren Benutzernamen höchstens alle 30 Tage ändern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー名の変更は30日に1回までです。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

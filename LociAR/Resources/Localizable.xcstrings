    "Çevre haritası henüz kaydedilemedi. Aynı yüzeyi biraz daha tarayıp tekrar deneyin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevre haritası henüz kaydedilemedi. Aynı yüzeyi biraz daha tarayıp tekrar deneyin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The environment map could not be saved yet. Scan the same surface some more and try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Umgebungskarte konnte noch nicht gespeichert werden. Scannen Sie dieselbe Oberfläche noch einmal und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa del entorno aún no se ha podido guardar. Escanee la misma superficie un poco más e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte de l'environnement n'a pas encore pu être enregistrée. Scannez encore la même surface et réessayez."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mapa ambiental ainda não pôde ser salvo. Digitalize mais um pouco a mesma superfície e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карту окружения пока не удалось сохранить. Просканируйте ту же поверхность еще раз и повторите попытку."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن حفظ خريطة البيئة بعد. قم بمسح نفس السطح أكثر وحاول مرة أخرى."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पर्यावरण मानचित्र अभी तक सहेजा नहीं जा सका. उसी सतह को कुछ और स्कैन करें और पुनः प्रयास करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিবেশ মানচিত্র এখনও সংরক্ষণ করা যায়নি. একই পৃষ্ঠটি আরও কিছু স্ক্যান করুন এবং আবার চেষ্টা করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "環境マップをまだ保存できませんでした。同じ表面をもう少しスキャンして、再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚无法保存环境贴图。多扫描同一表面，然后重试。"

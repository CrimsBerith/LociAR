    "Desteğinin %72’si yazara ayrılır. Kalan tutar ödeme ve platform masraflarını karşılar." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desteğinin %72’si yazara ayrılır. Kalan tutar ödeme ve platform masraflarını karşılar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "72% of your support goes to the writer. The remainder covers payment and platform costs."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "72% deiner Unterstützung gehen an den Verfasser. Der Rest deckt Zahlungs- und Plattformkosten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El 72% de tu apoyo corresponde al autor. El resto cubre los costes de pago y de la plataforma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "72% de votre soutien reviennent à l’auteur. Le reste couvre les frais de paiement et de plateforme."

    "Her hesap en fazla 3 kod verebilir. Her kod tek kullanımlıktır." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لكل حساب منح 3 رموز كحد أقصى. كل رمز صالح للاستخدام مرة واحدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি অ্যাকাউন্ট সর্বোচ্চ 3টি কোড দিতে পারে। প্রতিটি কোড একবারই ব্যবহার করা যায়।"

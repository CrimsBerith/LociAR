        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কিছু সংরক্ষিত পোস্ট লোড করা যায়নি। রিফ্রেশ করতে নিচে টানুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の保存した投稿を読み込めませんでした。下に引っ張って更新してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分收藏的帖子无法加载。下拉以刷新。"
          }
        }
      }
    },
    "Kaydedilen çevre aranıyor. Kamerayı postun sabitlendiği yüzeye doğru yavaşça gezdir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedilen çevre aranıyor. Kamerayı postun sabitlendiği yüzeye doğru yavaşça gezdir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looking for the saved surroundings. Slowly move the camera toward the surface where the post was pinned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Umgebung wird gesucht. Bewege die Kamera langsam zu der Fläche, an der der Post verankert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscando el entorno guardado. Mueve la cámara despacio hacia la superficie donde se fijó la publicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche de l’environnement enregistré. Déplacez lentement la caméra vers la surface où la publication a été fixée."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procurando o ambiente salvo. Mova a câmera devagar em direção à superfície onde a publicação foi fixada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поиск сохранённого окружения. Медленно ведите камерой к поверхности, где был закреплён пост."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ البحث عن البيئة المحفوظة. حرّك الكاميرا ببطء نحو السطح الذي ثُبّت عليه المنشور."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजा गया परिवेश खोजा जा रहा है। कैमरे को धीरे-धीरे उस सतह की ओर ले जाएँ जहाँ पोस्ट पिन की गई थी।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষিত পরিবেশ খোঁজা হচ্ছে। পোস্টটি যে পৃষ্ঠে পিন করা হয়েছিল, ক্যামেরাটি ধীরে সেদিকে সরান।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された周囲を探しています。投稿が固定された面に向けてカメラをゆっくり動かしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在寻找已保存的环境。请将相机缓慢移向帖子固定的表面。"
          }
        }
      }
    },
    "Kaydedilen çevre bulunamadı. Post desene değil konuma bağlı; mevcut yüzeye bağlanılıyor." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedilen çevre bulunamadı. Post desene değil konuma bağlı; mevcut yüzeye bağlanılıyor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The saved surroundings weren’t found. The post is tied to its location, not a pattern; attaching to the current surface."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherte Umgebung wurde nicht gefunden. Der Post hängt an seinem Ort, nicht an einem Muster; er wird an die aktuelle Fläche gebunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró el entorno guardado. La publicación depende de su ubicación, no de un patrón; se está vinculando a la superficie actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’environnement enregistré est introuvable. La publication est liée à son emplacement, pas à un motif ; rattachement à la surface actuelle."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ambiente salvo não foi encontrado. A publicação depende do local, não de um padrão; vinculando à superfície atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённое окружение не найдено. Пост привязан к месту, а не к узору; выполняется привязка к текущей поверхности."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم العثور على البيئة المحفوظة. المنشور مرتبط بموقعه لا بنمط؛ جارٍ ربطه بالسطح الحالي."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजा गया परिवेश नहीं मिला। पोस्ट पैटर्न से नहीं, अपनी जगह से जुड़ी है; मौजूदा सतह से जोड़ा जा रहा है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষিত পরিবেশ পাওয়া যায়নি। পোস্টটি প্যাটার্নের নয়, অবস্থানের সঙ্গে যুক্ত; বর্তমান পৃষ্ঠের সঙ্গে যুক্ত করা হচ্ছে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された周囲が見つかりません。投稿は模様ではなく場所に結びついているため、現在の面に関連付けています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未找到已保存的环境。帖子绑定的是位置而非图案；正在关联到当前表面。"
          }
        }
      }
    },

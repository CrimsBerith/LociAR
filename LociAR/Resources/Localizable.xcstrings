    "Post Keşfet, profil ve AR listesinden kaldırılır.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Post Keşfet, profil ve AR listesinden kaldırılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The post is removed from Discover, your profile, and the AR list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该帖子已从探索、个人资料和 AR 列表中删除。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट को एक्सप्लोर, प्रोफ़ाइल और AR सूची से हटा दिया गया है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La publicación se elimina de Descubrir, de tu perfil y de la lista AR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La publication est supprimée de Découvrir, de votre profil et de la liste AR."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم إزالة المنشور من «استكشف» وملفك الشخصي وقائمة الواقع المعزز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পোস্টটি এক্সপ্লোর, প্রোফাইল এবং এআর তালিকা থেকে সরানো হয়েছে।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A postagem é removida da lista Explorar, perfil e AR."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публикация удаляется из списка «Обзор», профиля и AR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beitrag wird aus „Entdecken“, Ihrem Profil und der AR-Liste entfernt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿は「見つける」、プロフィール、AR リストから削除されます。"

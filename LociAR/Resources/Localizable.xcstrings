    "Kameradan canlı görüntü alınamadı. Tekrar deneyin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameradan canlı görüntü alınamadı. Tekrar deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No live image could be obtained from the camera. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从相机获得实时图像。再试一次。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे से कोई सजीव छवि प्राप्त नहीं की जा सकी. पुनः प्रयास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener ninguna imagen en vivo de la cámara. Intentar otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune image en direct n'a pu être obtenue de la caméra. Essayer à nouveau."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الحصول على صورة حية من الكاميرا. حاول ثانية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরা থেকে কোনো লাইভ ছবি পাওয়া যায়নি। আবার চেষ্টা করুন"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma imagem ao vivo pôde ser obtida da câmera. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С камеры не удалось получить живое изображение. Попробуйте еще раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte kein Livebild von der Kamera erhalten werden. Versuchen Sie es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラからライブ画像を取得できませんでした。もう一度やり直してください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Kameran sadece yüzey algılamak, konumun ise yakındaki postları açmak için kullanılır. Gizliliğin daima koruma altında.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera AR yüzeylerini algılar; konum yakındaki postları göstermeye yardımcı olur. Google AR özellikleri için ayrıca onayın gerekir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera detects AR surfaces; location helps show nearby posts. Google AR features require your separate consent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机用于检测 AR 表面，位置信息用于显示附近的帖子。Google AR 功能需要您单独同意。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा AR सतहों का पता लगाता है और स्थान की जानकारी आस-पास की पोस्ट दिखाने में मदद करती है। Google AR सुविधाओं के लिए आपकी अलग सहमति आवश्यक है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara detecta superficies AR y la ubicación ayuda a mostrar publicaciones cercanas. Las funciones de Google AR requieren tu consentimiento por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra détecte les surfaces AR et la localisation aide à afficher les publications à proximité. Les fonctions Google AR nécessitent votre consentement distinct."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكتشف الكاميرا أسطح الواقع المعزز، ويساعد الموقع في عرض المنشورات القريبة. تتطلب ميزات Google AR موافقتك المنفصلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরা AR পৃষ্ঠ শনাক্ত করে এবং অবস্থানের তথ্য কাছাকাছি পোস্ট দেখাতে সাহায্য করে। Google AR সুবিধার জন্য আপনার আলাদা সম্মতি প্রয়োজন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera detecta superfícies AR, e a localização ajuda a mostrar postagens próximas. Os recursos do Google AR exigem seu consentimento separado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера распознаёт поверхности AR, а местоположение помогает показывать публикации рядом. Для функций Google AR требуется отдельное согласие."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera erkennt AR-Oberflächen; der Standort hilft, Beiträge in der Nähe anzuzeigen. Für Google-AR-Funktionen ist Ihre gesonderte Zustimmung erforderlich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラは AR の表面を検出し、位置情報は近くの投稿の表示に役立ちます。Google AR の機能には別途同意が必要です。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Kamerayı eğ": {

    "Tarama henüz hazır değil. Çevreyi taramaya devam edin veya yaklaşık yerleştirin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المسح ليس جاهزًا بعد. استمر في مسح المكان المحيط أو اختر موضعًا تقريبيًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্যান এখনও প্রস্তুত নয়। আশেপাশে স্ক্যান করা চালিয়ে যান বা আনুমানিক অবস্থানে রাখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Scan ist noch nicht bereit. Scannen Sie die Umgebung weiter oder wählen Sie eine ungefähre Platzierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scan is not ready yet. Continue scanning the surroundings or place approximately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El escaneo aún no está listo. Sigue escaneando el entorno o elige un posicionamiento aproximado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scan n’est pas encore prêt. Continuez à scanner l’environnement ou choisissez un placement approximatif."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कैन अभी तैयार नहीं है। आस-पास स्कैन करना जारी रखें या अनुमानित स्थान पर रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンの準備ができていません。周囲のスキャンを続けるか、おおよその配置を選んでください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A varredura ainda não está pronta. Continue examinando o ambiente ou escolha um posicionamento aproximado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скан ещё не готов. Продолжайте сканировать окружение или выберите приблизительное размещение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarama henüz hazır değil. Çevreyi taramaya devam edin veya yaklaşık yerleştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描尚未准备好。请继续扫描周围环境，或选择近似放置。"
          }
        }
      }
    },
    "Tarama netleşiyor; telefonu yavaş hareket ettirin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصبح المسح واضحا. حرك الهاتف ببطء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্যান পরিষ্কার হয়ে যায়; ফোনটা আস্তে আস্তে নাড়ান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Scan wird klar; Bewegen Sie das Telefon langsam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scan becomes clear; Move the phone slowly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exploración se vuelve clara; Mueve el teléfono lentamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scan devient clair ; Déplacez le téléphone lentement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कैन स्पष्ट हो जाता है; फोन को धीरे-धीरे हिलाएं."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンが鮮明になります。電話機をゆっくりと動かします。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A varredura fica clara; Mova o telefone lentamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скан становится четким; Медленно перемещайте телефон."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarama netleşiyor; telefonu yavaş hareket ettirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描变得清晰；慢慢移动手机。"
          }
        }
      }
    },

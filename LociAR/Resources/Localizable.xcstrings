    "Daha dokulu veya aydınlık bir yüzeye yönelin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha dokulu veya aydınlık bir yüzeye yönelin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point at a more textured or brighter surface."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte die Kamera auf eine strukturiertere oder hellere Fläche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta a una superficie con más textura o más iluminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visez une surface plus texturée ou mieux éclairée."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aponte para uma superfície com mais textura ou mais iluminada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите на более текстурированную или светлую поверхность."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وجّه الكاميرا إلى سطح أكثر تفاصيل أو أكثر إضاءة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादा बनावट वाली या ज़्यादा रोशनी वाली सतह की ओर रखें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আরও টেক্সচারযুক্ত বা আলোকিত পৃষ্ঠের দিকে তাক করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もっと模様のある面か明るい面に向けてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请对准纹理更多或更明亮的表面。"
          }
        }
      }
    },

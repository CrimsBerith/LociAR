    "Profil fotoğrafın otomatik güvenlik kontrolünden geçtikten sonra görünecek. Uygunsuz içerik reddedilir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil fotoğrafın otomatik güvenlik kontrolünden geçtikten sonra görünecek. Uygunsuz içerik reddedilir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your profile photo appears after passing an automatic safety check. Inappropriate content is rejected."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Profilfoto erscheint, nachdem es eine automatische Sicherheitsprüfung bestanden hat. Unangemessene Inhalte werden abgelehnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu foto de perfil aparecerá tras pasar un control de seguridad automático. Se rechaza el contenido inapropiado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre photo de profil apparaîtra après un contrôle de sécurité automatique. Les contenus inappropriés sont refusés."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua foto de perfil aparecerá depois de passar por uma verificação de segurança automática. Conteúdo impróprio é recusado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото профиля появится после автоматической проверки безопасности. Недопустимый контент отклоняется."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر صورة ملفك الشخصي بعد اجتياز فحص أمان تلقائي. يُرفض المحتوى غير اللائق."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी प्रोफ़ाइल फ़ोटो स्वचालित सुरक्षा जाँच पास करने के बाद दिखेगी। अनुचित सामग्री अस्वीकार कर दी जाती है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বয়ংক্রিয় নিরাপত্তা পরীক্ষা পেরোনোর পর আপনার প্রোফাইল ছবি দেখা যাবে। অনুপযুক্ত কনটেন্ট বাতিল করা হয়।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィール写真は自動の安全チェックに合格すると表示されます。不適切な内容は拒否されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的头像通过自动安全检查后才会显示。不当内容将被拒绝。"
          }
        }
      }
    },

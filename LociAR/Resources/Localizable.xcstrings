    "Beğendiğin veya kaydettiğin postları detayından bu koleksiyona ekleyebilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beğendiğin veya kaydettiğin postları detayından bu koleksiyona ekleyebilirsin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can add the posts you like or save to this collection from the details."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Beiträge, die Ihnen gefallen oder die Sie gespeichert haben, über die Detailansicht zu dieser Sammlung hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde los detalles, puedes añadir a esta colección las publicaciones que te gusten o que hayas guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depuis les détails d’une publication, vous pouvez ajouter à cette collection les publications que vous aimez ou avez enregistrées."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos detalhes, você pode adicionar a esta coleção as publicações de que gostou ou que salvou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте понравившиеся или сохранённые публикации в эту коллекцию со страницы публикации."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك من صفحة التفاصيل إضافة المنشورات التي أعجبتك أو حفظتها إلى هذه المجموعة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट के विवरण से अपनी पसंद की या सहेजी गई पोस्ट इस संग्रह में जोड़ सकते हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পোস্টের বিবরণ থেকে পছন্দের বা সংরক্ষিত পোস্ট এই সংগ্রহে যোগ করতে পারেন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿の詳細画面から、気に入った投稿や保存した投稿をこのコレクションに追加できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在帖子详情中，将喜欢或已保存的帖子添加到此收藏集。"
          }
        }
      }
    },

    "Postlar şu anda yüklenemiyor. Bağlantını kontrol edip tekrar dene." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تحميل المشاركات الآن. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পোস্ট এখন লোড করা যাবে না. আপনার সংযোগ পরীক্ষা করুন এবং আবার চেষ্টা করুন."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiträge können derzeit nicht geladen werden. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posts cannot be loaded right now. Check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las publicaciones no se pueden cargar en este momento. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les publications ne peuvent pas être chargées pour le moment. Vérifiez votre connexion et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट अभी लोड नहीं की जा सकतीं. अपना कनेक्शन जांचें और पुनः प्रयास करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在投稿を読み込むことができません。接続を確認して、もう一度試してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",

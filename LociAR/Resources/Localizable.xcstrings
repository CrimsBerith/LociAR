        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका ईमेल पता अभी तक सत्यापित नहीं किया गया है. अपने इनबॉक्स में लिंक पर टैप करें, फिर दोबारा लॉग इन करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのメールアドレスはまだ認証されていません。受信トレイのリンクをタップして、再度ログインします。"

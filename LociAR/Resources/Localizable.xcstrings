    "Daha iyi ışıkta dokulu yüzeyi farklı açılardan tara. Tekrar tara veya İptal et." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha iyi ışıkta dokulu yüzeyi farklı açılardan tara. Tekrar tara veya İptal et."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In better light, scan the textured surface from different angles. Rescan or Cancel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne die strukturierte Fläche bei besserem Licht aus verschiedenen Winkeln. Erneut scannen oder Abbrechen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con mejor luz, escanea la superficie con textura desde distintos ángulos. Vuelve a escanear o Cancela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec un meilleur éclairage, scannez la surface texturée sous différents angles. Rescanner ou Annuler."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com uma luz melhor, escaneie a superfície com textura de ângulos diferentes. Escaneie de novo ou Cancele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При лучшем освещении отсканируйте текстурированную поверхность с разных сторон. Сканировать снова или Отмена."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في إضاءة أفضل، امسح السطح ذا التفاصيل من زوايا مختلفة. أعد المسح أو ألغِ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेहतर रोशनी में बनावट वाली सतह को अलग-अलग कोणों से स्कैन करें। फिर से स्कैन करें या रद्द करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভালো আলোতে টেক্সচারযুক্ত পৃষ্ঠটি বিভিন্ন কোণ থেকে স্ক্যান করুন। আবার স্ক্যান করুন বা বাতিল করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明るい場所で、模様のある面をいろいろな角度からスキャンしてください。再スキャンまたはキャンセル。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在更好的光线下，从不同角度扫描有纹理的表面。重新扫描或取消。"
          }
        }
      }
    },

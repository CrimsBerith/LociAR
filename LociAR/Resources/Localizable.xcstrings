    "Silme isteğiniz alındı. İşlem arka planda tamamlanacak." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silme isteğiniz alındı. İşlem arka planda tamamlanacak."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your deletion request was accepted. It will finish in the background."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Löschanfrage wurde angenommen. Der Vorgang wird im Hintergrund abgeschlossen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha aceptado tu solicitud de eliminación. El proceso se completará en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre demande de suppression a été acceptée. Le traitement se terminera en arrière-plan."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua solicitação de exclusão foi aceita. O processo será concluído em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш запрос на удаление принят. Операция завершится в фоновом режиме."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم قبول طلب حذف حسابك. ستكتمل العملية في الخلفية."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका खाता मिटाने का अनुरोध स्वीकार कर लिया गया है। यह प्रक्रिया पृष्ठभूमि में पूरी होगी।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অ্যাকাউন্ট মুছে ফেলার অনুরোধ গ্রহণ করা হয়েছে। প্রক্রিয়াটি ব্যাকগ্রাউন্ডে সম্পন্ন হবে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント削除のリクエストを受け付けました。処理はバックグラウンドで完了します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已接受你的账户删除请求。删除操作将在后台完成。"
          }
        }
      }
    },

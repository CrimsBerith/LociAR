    "Yayınlamak için doğrulanmış Apple veya e-posta hesabı gerekiyor.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayınlamak için doğrulanmış Apple veya e-posta hesabı gerekiyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified Apple or email account required to publish."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要经过验证的 Apple 或电子邮件帐户才能发布。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रकाशित करने के लिए सत्यापित Apple या ईमेल खाता आवश्यक है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere una cuenta de Apple o de correo electrónico verificada para publicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte Apple ou compte de messagerie vérifié requis pour publier."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب حساب Apple أو بريد إلكتروني تم التحقق منه للنشر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রকাশ করার জন্য যাচাইকৃত Apple বা ইমেল অ্যাকাউন্ট প্রয়োজন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária uma conta Apple ou de e-mail verificada para publicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для публикации требуется подтвержденная учетная запись Apple или адрес электронной почты."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Veröffentlichung ist ein verifiziertes Apple- oder E-Mail-Konto erforderlich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開するには認証済みの Apple アカウントまたは電子メール アカウントが必要です。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Yayınlamak için geçerli GPS konumu gerekiyor. Konum iznini açıp tekrar deneyin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayınlamak için geçerli GPS konumu gerekiyor. Konum iznini açıp tekrar deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A valid GPS location is required to publish. Enable location access and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要有效的 GPS 位置才能发布。启用位置访问并重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रकाशित करने के लिए एक वैध जीपीएस स्थान आवश्यक है। स्थान पहुंच सक्षम करें और पुनः प्रयास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere una ubicación GPS válida para publicar. Habilite el acceso a la ubicación e inténtelo nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une localisation GPS valide est requise pour la publication. Activez l'accès à la localisation et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب موقع GPS صالح للنشر. قم بتمكين الوصول إلى الموقع وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রকাশ করার জন্য একটি বৈধ GPS অবস্থান প্রয়োজন৷ অবস্থান অ্যাক্সেস সক্ষম করুন এবং আবার চেষ্টা করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária uma localização GPS válida para publicar. Ative o acesso à localização e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для публикации требуется действительное местоположение GPS. Включите доступ к местоположению и повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Veröffentlichung ist ein gültiger GPS-Standort erforderlich. Aktivieren Sie den Standortzugriff und versuchen Sie es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開するには有効な GPS 位置情報が必要です。位置情報へのアクセスを有効にして、再試行してください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

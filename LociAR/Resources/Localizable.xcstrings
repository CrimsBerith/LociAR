        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भुगतान अभी सत्यापित नहीं हुआ है। दोबारा भुगतान करने से पहले उसकी स्थिति देखें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পেমেন্ট এখনও যাচাই করা হয়নি। আবার পেমেন্ট করার আগে অবস্থা দেখুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払いはまだ確認されていません。再度支払う前に状況を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付款尚未验证。再次付款前请先查看状态。"
          }
        }
      }
    },

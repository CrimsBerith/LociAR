    },
    "Kameran sadece yüzey algılamak, konumun ise yakındaki postları açmak için kullanılır. Gizliliğin daima koruma altında." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameran sadece yüzey algılamak, konumun ise yakındaki postları açmak için kullanılır. Gizliliğin daima koruma altında."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your camera is only used to detect surfaces, and your location to open nearby posts. Your privacy is always protected."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Kamera wird nur zum Erkennen von Flächen genutzt, dein Standort nur zum Öffnen von Posts in der Nähe. Deine Privatsphäre ist immer geschützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cámara solo se usa para detectar superficies y tu ubicación para abrir publicaciones cercanas. Tu privacidad siempre está protegida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre caméra sert uniquement à détecter les surfaces, et votre position à ouvrir les publications proches. Votre vie privée est toujours protégée."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua câmera é usada apenas para detectar superfícies, e sua localização para abrir publicações próximas. Sua privacidade está sempre protegida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера используется только для распознавания поверхностей, а местоположение — для открытия постов поблизости. Ваша конфиденциальность всегда защищена."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم الكاميرا فقط لاكتشاف الأسطح، والموقع لفتح المنشورات القريبة. خصوصيتك محمية دائمًا."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका कैमरा केवल सतहें पहचानने के लिए और आपका स्थान केवल आस-पास की पोस्ट खोलने के लिए इस्तेमाल होता है। आपकी गोपनीयता हमेशा सुरक्षित है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ক্যামেরা শুধু পৃষ্ঠ শনাক্ত করতে এবং অবস্থান শুধু কাছাকাছি পোস্ট খুলতে ব্যবহৃত হয়। আপনার গোপনীয়তা সবসময় সুরক্ষিত।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラは面の検出にのみ、位置情報は近くの投稿を開くためにのみ使われます。プライバシーは常に守られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机仅用于检测表面，位置仅用于打开附近的帖子。你的隐私始终受到保护。"
          }
        }
      }
    },
    "Kamerayı eğ" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {

            "value" : "Postlar yalnızca metin ve GIF içerebilir; fotoğraf, video, çizim ve bağlantı desteklenmiyor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posts may contain only text and GIFs; photos, videos, drawings and links are not supported."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiträge dürfen nur Text und GIFs enthalten; Fotos, Videos, Zeichnungen und Links werden nicht unterstützt."

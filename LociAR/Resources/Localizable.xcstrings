    "Hesap oluşturulamadı. E-posta kullanımda olabilir veya şifre yeterince güçlü değil.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap oluşturulamadı. E-posta kullanımda olabilir veya şifre yeterince güçlü değil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account could not be created. The email may be in use or the password is not strong enough."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建该帐户。该电子邮件可能正在使用或密码强度不够。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता नहीं बनाया जा सका. हो सकता है कि ईमेल उपयोग में हो या पासवर्ड पर्याप्त मजबूत न हो।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear la cuenta. Es posible que el correo electrónico esté en uso o que la contraseña no sea lo suficientemente segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte n'a pas pu être créé. L'e-mail est peut-être en cours d'utilisation ou le mot de passe n'est pas assez fort."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إنشاء الحساب. ربما يكون البريد الإلكتروني قيد الاستخدام أو أن كلمة المرور ليست قوية بدرجة كافية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্ট তৈরি করা যায়নি। ইমেল ব্যবহার করা হতে পারে বা পাসওয়ার্ড যথেষ্ট শক্তিশালী নয়।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A conta não pôde ser criada. O e-mail pode estar em uso ou a senha não é forte o suficiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать учетную запись. Возможно, адрес электронной почты используется или пароль недостаточно надежный."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Konto konnte nicht erstellt werden. Möglicherweise wird die E-Mail-Adresse verwendet oder das Passwort ist nicht sicher genug."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを作成できませんでした。電子メールが使用中であるか、パスワードが十分に強力ではない可能性があります。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

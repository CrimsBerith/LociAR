    "Bu sıradaki post farklı bir hesaba ait.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sıradaki post farklı bir hesaba ait."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This queued post belongs to another account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此排队帖子属于另一个帐户。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पंक्तिबद्ध पोस्ट किसी अन्य खाते से संबंधित है."
          }

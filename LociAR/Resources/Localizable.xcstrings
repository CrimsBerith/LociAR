    "Panoda geçerli bir %@ paylaşım bağlantısı bulunamadı. İçerikte Paylaş → Bağlantıyı kopyala adımını kullan." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panoda geçerli bir %@ paylaşım bağlantısı bulunamadı. İçerikte Paylaş → Bağlantıyı kopyala adımını kullan."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No valid %@ share link on the clipboard. In the app, use Share → Copy link."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Zwischenablage ist kein gültiger %@-Link. Nutze im Inhalt Teilen → Link kopieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay un enlace válido de %@ en el portapapeles. En el contenido, usa Compartir → Copiar enlace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun lien %@ valide dans le presse-papiers. Dans le contenu, utilisez Partager → Copier le lien."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há um link válido do %@ na área de transferência. No conteúdo, use Compartilhar → Copiar link."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В буфере обмена нет действительной ссылки %@. В приложении используйте «Поделиться → Скопировать ссылку»."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد رابط مشاركة صالح من %@ في الحافظة. في المحتوى، استخدم مشاركة ← نسخ الرابط."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्लिपबोर्ड पर कोई मान्य %@ शेयर लिंक नहीं मिला। सामग्री में शेयर करें → लिंक कॉपी करें का इस्तेमाल करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক্লিপবোর্ডে বৈধ কোনো %@ শেয়ার লিংক নেই। কনটেন্টে শেয়ার → লিংক কপি করুন ব্যবহার করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップボードに有効な %@ の共有リンクがありません。コンテンツで「共有 → リンクをコピー」を使ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪贴板中没有有效的 %@ 分享链接。请在内容中使用“分享 → 复制链接”。"
          }
        }
      }
    },

    "Kaydedilenler için sunucu bağlantısı gerekiyor.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilenler için sunucu bağlantısı gerekiyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A server connection is required to view saved posts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要服务器连接才能查看保存的帖子。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजे गए पोस्ट देखने के लिए सर्वर कनेक्शन आवश्यक है."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere una conexión al servidor para ver las publicaciones guardadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une connexion au serveur est requise pour afficher les publications enregistrées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب اتصال بالخادم لعرض المشاركات المحفوظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত পোস্ট দেখতে একটি সার্ভার সংযোগ প্রয়োজন."
          }
        },

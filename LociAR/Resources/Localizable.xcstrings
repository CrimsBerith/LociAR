    "Fiziksel AR yüzey kaydı eksik. Yüzeyi yeniden tarayıp kesin kilit oluşturun." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiziksel AR yüzey kaydı eksik. Yüzeyi yeniden tarayıp kesin kilit oluşturun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The physical AR surface record is missing. Rescan the surface to create a precise lock."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die physische AR-Flächenaufzeichnung fehlt. Scanne die Fläche erneut, um eine präzise Verankerung zu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el registro de la superficie AR física. Vuelve a escanear la superficie para crear un anclaje preciso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement de la surface RA physique est manquant. Scannez à nouveau la surface pour créer un ancrage précis."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registro da superfície física em RA está faltando. Escaneie a superfície de novo para criar uma ancoragem precisa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсутствует запись физической AR-поверхности. Отсканируйте поверхность заново, чтобы создать точную привязку."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجل السطح الفعلي للواقع المعزز مفقود. امسح السطح مجددًا لإنشاء تثبيت دقيق."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भौतिक AR सतह रिकॉर्ड मौजूद नहीं है। सटीक लॉक बनाने के लिए सतह को फिर से स्कैन करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভৌত AR পৃষ্ঠের রেকর্ড নেই। নির্ভুল লক তৈরি করতে পৃষ্ঠটি আবার স্ক্যান করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物理的なAR面の記録がありません。面をスキャンし直して正確なロックを作成してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缺少实体 AR 表面记录。请重新扫描表面以创建精确锁定。"
          }
        }
      }
    },

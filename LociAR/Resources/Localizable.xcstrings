    "Devam ederek gizlilik ve topluluk kurallarını kabul edersiniz." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالمتابعة، فإنك توافق على سياسة الخصوصية وقواعد المجتمع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চালিয়ে যাওয়ার মাধ্যমে আপনি গোপনীয়তা নীতি এবং সম্প্রদায়ের নিয়মাবলী গ্রহণ করছেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indem Sie fortfahren, akzeptieren Sie die Datenschutzrichtlinie und die Community-Regeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By continuing you accept the privacy policy and community rules."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al continuar, aceptas la política de privacidad y las normas de la comunidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En continuant, vous acceptez la politique de confidentialité et les règles de la communauté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जारी रखकर आप गोपनीयता नीति और सामुदायिक नियमों को स्वीकार करते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続行すると、プライバシーポリシーとコミュニティガイドラインに同意したことになります。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao continuar, você aceita a política de privacidade e as regras da comunidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжая, вы принимаете политику конфиденциальности и правила сообщества."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

    "Bildirimin incelemeye gönderildi. Teşekkürler.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimin incelemeye gönderildi. Teşekkürler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your report has been sent for review. Thank you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的举报已提交审核。谢谢。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी रिपोर्ट समीक्षा के लिए भेज दी गई है. धन्यवाद।"
          }
        },
        "es": {
          "stringUnit": {

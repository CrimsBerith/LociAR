    "Fotoğraf ve video içeren postlar artık desteklenmiyor. Postu metin olarak yeniden oluştur." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تعد المنشورات التي تحتوي على صور ومقاطع فيديو مدعومة. أعد إنشاء المنشور كنص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফটো এবং ভিডিও সম্বলিত পোস্ট আর সমর্থিত নয়। পোস্টটি পাঠ্য হিসেবে পুনরায় তৈরি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiträge mit Fotos und Videos werden nicht mehr unterstützt. Erstellen Sie den Beitrag als Text neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posts containing photos and videos are no longer supported. Recreate the post as text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no se admiten publicaciones que contengan fotos y vídeos. Recrea la publicación como texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les publications contenant des photos et des vidéos ne sont plus prises en charge. Recréez la publication sous forme de texte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोटो और वीडियो वाले पोस्ट अब समर्थित नहीं हैं। पोस्ट को टेक्स्ट के रूप में दोबारा बनाएं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真やビデオを含む投稿はサポートされなくなりました。テキストとして投稿を再作成してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postagens contendo fotos e vídeos não são mais suportadas. Recrie a postagem como texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Публикации с фотографиями и видео больше не поддерживаются. Создайте публикацию заново в виде текста."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraf ve video içeren postlar artık desteklenmiyor. Postu metin olarak yeniden oluştur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再支持包含照片和视频的帖子。请以文本形式重新创建帖子。"
          }
        }
      }
    },
    "Fotoğraflar yayınlanmadan önce otomatik olarak incelenir; çıplaklık, müstehcenlik veya şiddet içerenler reddedilir." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم مراجعة الصور تلقائيًا قبل النشر؛ سيتم رفض تلك التي تحتوي على العري أو الفحش أو العنف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রকাশের আগে ছবিগুলো স্বয়ংক্রিয়ভাবে পর্যালোচনা করা হয়। নগ্নতা, অশ্লীলতা বা সহিংসতা থাকলে ছবি বাতিল করা হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos werden vor der Veröffentlichung automatisch überprüft; Beiträge mit Nacktheit, Obszönität oder Gewalt werden abgelehnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos are automatically reviewed before publication; Those containing nudity, obscenity or violence will be rejected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos se revisan automáticamente antes de su publicación. Se rechazarán las que contengan desnudez, obscenidad o violencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos sont automatiquement examinées avant publication. Celles contenant de la nudité, des obscénités ou de la violence seront rejetées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रकाशन से पहले फ़ोटो की स्वचालित रूप से समीक्षा की जाती है; जिनमें नग्नता, अश्लीलता या हिंसा होगी, उन्हें अस्वीकार कर दिया जाएगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真は公開前に自動的に審査されます。ヌード、わいせつ、暴力を含むものは拒否されます。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos são analisadas automaticamente antes da publicação. As que contiverem nudez, obscenidade ou violência serão rejeitadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фотографии автоматически проверяются перед публикацией. Фотографии с наготой, непристойным содержимым или насилием будут отклонены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraflar yayınlanmadan önce otomatik olarak incelenir; çıplaklık, müstehcenlik veya şiddet içerenler reddedilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片在发布前会自动审核；含有裸露、淫秽或暴力内容的内容将被拒绝。"
          }
        }
      }
    },

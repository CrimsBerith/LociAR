        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাকাউন্ট তৈরি করা যায়নি। ইমেলটি হয়তো ব্যবহৃত হচ্ছে বা পাসওয়ার্ড যথেষ্ট শক্তিশালী নয়।"
          }

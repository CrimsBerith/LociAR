    "Bekleyen post cihazda güvende. Yayını tekrar deneyebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen post cihazda güvende. Yayını tekrar deneyebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pending post is safe on this device. You can try publishing again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待处理的帖子在此设备上是安全的。您可以尝试再次发布。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबित पोस्ट इस डिवाइस पर सुरक्षित है. आप पुनः प्रकाशन का प्रयास कर सकते हैं."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La publicación pendiente está segura en este dispositivo. Puedes intentar publicar nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La publication en attente est en sécurité sur cet appareil. Vous pouvez réessayer de publier."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المشاركة المعلقة آمنة على هذا الجهاز. يمكنك محاولة النشر مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মুলতুবি পোস্ট এই ডিভাইসে নিরাপদ. আপনি আবার প্রকাশ করার চেষ্টা করতে পারেন."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A postagem pendente está segura neste dispositivo. Você pode tentar publicar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

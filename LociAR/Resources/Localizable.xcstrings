    "Kayıttan sonra e-posta adresine gönderilen bağlantıyla hesabını doğrula." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد التسجيل، يرجى تأكيد حسابك عبر الرابط المرسل إلى بريدك الإلكتروني."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সাইন আপ করার পরে, আপনার ইমেলে পাঠানো লিঙ্কটি দিয়ে আপনার অ্যাকাউন্ট যাচাই করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätigen Sie Ihr Konto nach der Registrierung über den Link in Ihrer E-Mail."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After signing up, verify your account with the link sent to your email."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de registrarte, verifica tu cuenta con el enlace enviado a tu correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après votre inscription, vérifiez votre compte via le lien envoyé à votre e-mail."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन अप करने के बाद, अपने ईमेल पर भेजे गए लिंक से अपना खाता सत्यापित करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登録後、メールに届いたリンクからアカウントを確認してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após o cadastro, confirme sua conta com o link enviado para o seu e-mail."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После регистрации подтвердите учетную запись по ссылке, отправленной на вашу почту."

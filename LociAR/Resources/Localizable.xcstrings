          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo preparar una vista AR aproximada. Apunta la cámara en la dirección de la publicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de préparer la vue AR approximative. Pointez la caméra dans la direction de la publication."

        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পোস্টটি মেঝেতে আছে। নিশানা পৃষ্ঠে নামিয়ে মাঝখানে আনুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿は床にあります。照準を面まで下げて中央に入れてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帖子在地面上。请将准星下移到表面并居中。"
          }
        }
      }
    },
    "Post şu anda açılamadı. Bağlantını kontrol edip tekrar dene." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post şu anda açılamadı. Bağlantını kontrol edip tekrar dene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The post can’t be opened right now. Check your connection and try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Post kann gerade nicht geöffnet werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {

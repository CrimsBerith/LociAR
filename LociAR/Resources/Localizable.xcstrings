            "value": "هل يجب حذف هذه المشاركة؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পোস্ট মুছে ফেলা উচিত?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta postagem deve ser excluída?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

    "Fiziksel AR yüzey kaydı eksik. Yüzeyi yeniden tarayıp kesin kilit oluşturun." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خريطة سطح الواقع المعزز مفقودة. أعد مسح السطح لتثبيت المحتوى عليه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাস্তব AR পৃষ্ঠের মানচিত্র নেই। পৃষ্ঠে স্থির করতে আবার স্ক্যান করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die AR-Karte der physischen Oberfläche fehlt. Scannen Sie die Oberfläche erneut, um den Inhalt fest darauf zu verankern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The physical AR surface map is missing. Rescan the surface to establish a physical lock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el mapa físico de la superficie AR. Vuelva a escanear la superficie para establecer un bloqueo físico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte physique de la surface AR est manquante. Analysez à nouveau la surface pour établir un verrou physique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भौतिक AR सतह मानचित्र गायब है। भौतिक लॉक स्थापित करने के लिए सतह को दोबारा स्कैन करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物理的な AR サーフェス マップがありません。表面を再スキャンして物理的なロックを確立します。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mapa físico da superfície AR está faltando. Digitalize novamente a superfície para estabelecer um bloqueio físico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Физическая карта поверхности AR отсутствует. Повторно просканируйте поверхность, чтобы установить физическую блокировку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiziksel AR yüzey kaydı eksik. Yüzeyi yeniden tarayıp kesin kilit oluşturun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物理 AR 表面地图丢失。重新扫描表面以建立物理锁。"
          }
        }
      }
    },
    "Fiziksel çevre haritası kaydedilemedi. Dilersen 'Yaklaşık olarak devam et' ile postunu hemen oluşturabilir veya tekrar tarayabilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر حفظ خريطة البيئة الفعلية. اختر موضعًا تقريبيًا لإنشاء منشورك الآن، أو قم بالمسح الضوئي مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভৌত পরিবেশ মানচিত্র সংরক্ষণ করা যায়নি. এখন আপনার পোস্ট তৈরি করতে আনুমানিক স্থান নির্বাচন করুন, অথবা আবার স্ক্যান করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte der physischen Umgebung konnte nicht gespeichert werden. Wählen Sie jetzt die ungefähre Platzierung aus, um Ihren Beitrag zu erstellen, oder scannen Sie erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not save the physical environment map. Choose approximate placement to create your post now, or scan again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar el mapa del entorno físico. Elija la ubicación aproximada para crear su publicación ahora o escanee nuevamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer la carte de l’environnement physique. Choisissez un emplacement approximatif pour créer votre publication maintenant ou scannez à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भौतिक पर्यावरण मानचित्र सहेजा नहीं जा सका. अभी अपनी पोस्ट बनाने के लिए अनुमानित प्लेसमेंट चुनें, या फिर से स्कैन करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物理環境マップを保存できませんでした。おおよその配置を選択して今すぐ投稿を作成するか、もう一度スキャンしてください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar o mapa do ambiente físico. Escolha o posicionamento aproximado para criar sua postagem agora ou digitalize novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить карту физической среды. Выберите приблизительное размещение, чтобы создать публикацию сейчас, или отсканируйте еще раз."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiziksel çevre haritası kaydedilemedi. Dilersen 'Yaklaşık olarak devam et' ile postunu hemen oluşturabilir veya tekrar tarayabilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存物理环境地图。选择大致的位置立即创建您的帖子，或再次扫描。"
          }
        }
      }
    },

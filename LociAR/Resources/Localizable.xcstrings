        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थानीय सतह रिकॉर्ड खाली है या 50 एमबी की सीमा से अधिक है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্থানীয় পৃষ্ঠের রেকর্ড খালি বা 50 MB সীমা ছাড়িয়ে গেছে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカル サーフェス レコードが空であるか、50 MB の制限を超えています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地表面记录为空或超过 50 MB 限制。"
          }
        }
      }
    },

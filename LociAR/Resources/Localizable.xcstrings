    "Postların beğenildiğinde, yorum aldığında ve biri seni takip ettiğinde bildirim gönderilir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postların beğenildiğinde, yorum aldığında ve biri seni takip ettiğinde bildirim gönderilir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You get a notification when your posts are liked or commented on and when someone follows you."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst benachrichtigt, wenn deine Posts Likes oder Kommentare bekommen und wenn dir jemand folgt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibes una notificación cuando a alguien le gusta o comenta tu publicación y cuando alguien te sigue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous recevez une notification quand vos publications sont aimées ou commentées et quand quelqu’un vous suit."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você recebe uma notificação quando suas publicações são curtidas ou comentadas e quando alguém segue você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы получаете уведомление, когда ваши посты лайкают или комментируют и когда на вас подписываются."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصلك إشعار عندما يُعجب أحد بمنشوراتك أو يعلّق عليها وعندما يتابعك أحد."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आपकी पोस्ट पसंद की जाती है या उस पर टिप्पणी होती है और जब कोई आपको फ़ॉलो करता है, तब आपको सूचना मिलती है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার পোস্টে লাইক বা মন্তব্য পড়লে এবং কেউ আপনাকে অনুসরণ করলে বিজ্ঞপ্তি পাঠানো হয়।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿にいいねやコメントがついたとき、誰かにフォローされたときに通知が届きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你的帖子被点赞或评论，以及有人关注你时，你会收到通知。"
          }
        }
      }
    },

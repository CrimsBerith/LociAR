            "value": "Yaklaşık AR görünümü hazırlanamadı. Kamerayı postun yönüne tut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approximate AR view could not be prepared. Point the camera in the direction of the post."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备近似 AR 视图。请将相机对准帖子的方向。"
          }
        },
        "hi": {
          "stringUnit": {

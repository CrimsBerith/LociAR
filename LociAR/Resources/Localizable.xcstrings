        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع اختبار الجهاز مفعّل. تبقى عمليات الخادم محلية حتى يعود الاتصال."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिवाइस परीक्षण मोड चालू है। कनेक्शन वापस आने तक सर्वर कार्य स्थानीय रहते हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিভাইস পরীক্ষা মোড চালু আছে। সংযোগ ফিরে না আসা পর্যন্ত সার্ভারের কাজ স্থানীয় থাকে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイステストモードがオンです。接続が戻るまでサーバー処理はローカルに保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备测试模式已开启。在连接恢复前，服务器操作将保存在本地。"
          }
        }
      }

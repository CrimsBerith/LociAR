    "Konuma bağlı bildirimler için iOS Ayarları’nda Arka Planda Uygulama Yenile’yi aç." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل تحديث التطبيقات في الخلفية في إعدادات iOS لتلقي إشعارات الموقع."
          }
        },
        "bn" : {
          "stringUnit" : {

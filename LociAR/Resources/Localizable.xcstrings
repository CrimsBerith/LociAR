    "Konum henüz netleşmedi. İç mekânda biraz bekleyip tekrar dene veya Ayarlar’dan konum iznini kontrol et." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum henüz netleşmedi. İç mekânda biraz bekleyip tekrar dene veya Ayarlar’dan konum iznini kontrol et."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location isn’t clear yet. Wait a bit indoors and try again, or check location permission in Settings."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort ist noch ungenau. Warte drinnen etwas und versuche es erneut oder prüfe die Standortberechtigung in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación aún no es precisa. Espera un poco en interiores y vuelve a intentarlo, o revisa el permiso de ubicación en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position n’est pas encore précise. Patientez un peu à l’intérieur et réessayez, ou vérifiez l’autorisation de localisation dans Réglages."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua localização ainda não está precisa. Aguarde um pouco em ambiente fechado e tente novamente, ou verifique a permissão de localização em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Местоположение пока неточное. Подождите немного в помещении и повторите попытку или проверьте доступ к геолокации в Настройках."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موقعك غير واضح بعد. انتظر قليلًا في الداخل ثم حاول مرة أخرى، أو تحقّق من إذن الموقع في الإعدادات."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका स्थान अभी स्पष्ट नहीं है। अंदर कुछ देर रुककर फिर कोशिश करें या सेटिंग्स में स्थान अनुमति जाँचें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অবস্থান এখনো স্পষ্ট নয়। ভেতরে একটু অপেক্ষা করে আবার চেষ্টা করুন, অথবা সেটিংসে অবস্থানের অনুমতি পরীক্ষা করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置がまだ定まっていません。屋内で少し待ってからもう一度試すか、設定で位置情報の許可を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的位置尚不清晰。请在室内稍等后重试，或在“设置”中检查定位权限。"
          }
        }
      }
    },

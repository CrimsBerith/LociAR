    "Cihazı serin ve gölgeli bir yerde beklet. Sıcaklık normale dönünce AR taraması otomatik devam eder.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazı serin ve gölgeli bir yerde beklet. Sıcaklık normale dönünce AR taraması otomatik devam eder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the device in a cool and shaded place. When the temperature returns to normal, AR scanning continues automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将设备存放在阴凉处。当温度恢复正常时，AR 扫描会自动继续。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपकरण को ठंडी और छायादार जगह पर रखें। जब तापमान सामान्य हो जाता है, तो एआर स्कैनिंग स्वचालित रूप से जारी रहती है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga el dispositivo en un lugar fresco y sombreado. Cuando la temperatura vuelve a la normalidad, el escaneo AR continúa automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez l'appareil dans un endroit frais et ombragé. Lorsque la température revient à la normale, le balayage AR se poursuit automatiquement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بالجهاز في مكان بارد ومظلل. عندما تعود درجة الحرارة إلى وضعها الطبيعي، يستمر المسح بالواقع المعزز تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইসটি একটি শীতল এবং ছায়াযুক্ত জায়গায় রাখুন। যখন তাপমাত্রা স্বাভাবিক অবস্থায় ফিরে আসে, তখন AR স্ক্যানিং স্বয়ংক্রিয়ভাবে চলতে থাকে।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o dispositivo em local fresco e com sombra. Quando a temperatura volta ao normal, a varredura AR continua automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Храните устройство в прохладном и затененном месте. Когда температура вернется в норму, сканирование AR продолжится автоматически."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahren Sie das Gerät an einem kühlen und schattigen Ort auf. Wenn die Temperatur wieder normal ist, wird das AR-Scannen automatisch fortgesetzt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスは涼しい日陰の場所に保管してください。温度が正常に戻ると、AR スキャンは自動的に続行されます。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

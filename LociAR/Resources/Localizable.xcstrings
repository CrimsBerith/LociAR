    "Biraz daha tara veya açıkça yaklaşık yerleştirmeyi seç." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biraz daha tara veya açıkça yaklaşık yerleştirmeyi seç."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan a bit more or explicitly choose approximate placement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne noch etwas weiter oder wähle ausdrücklich die ungefähre Platzierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea un poco más o elige explícitamente la colocación aproximada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez encore un peu ou choisissez explicitement le placement approximatif."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie um pouco mais ou escolha explicitamente o posicionamento aproximado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте ещё немного или явно выберите примерное размещение."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح قليلًا أكثر أو اختر صراحةً الوضع التقريبي."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थोड़ा और स्कैन करें या स्पष्ट रूप से अनुमानित प्लेसमेंट चुनें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আরেকটু স্ক্যান করুন অথবা স্পষ্টভাবে আনুমানিক স্থাপন বেছে নিন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう少しスキャンするか、おおよその配置を明示的に選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再扫描一会儿，或明确选择大致放置。"
          }
        }
      }
    },

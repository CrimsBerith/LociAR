{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Gerçek mekânlara bağlı hikâyeler.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stories tied to real places."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与真实地点相连的故事。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वास्तविक स्थानों से जुड़ी कहानियाँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historias vinculadas a lugares reales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des histoires liées à des lieux réels."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قصص مرتبطة بأماكن حقيقية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাস্তব স্থানের সাথে সংযুক্ত গল্প।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Histórias ligadas a lugares reais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Истории, привязанные к реальным местам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschichten, die an reale Orte gebunden sind."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実在の場所と結びついたストーリー。"
          }
        }
      }
    },
    "Devam ederek gizlilik ve topluluk kurallarını kabul edersiniz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By continuing you accept the privacy policy and community rules."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续操作即表示您同意隐私政策和社区守则。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखकर आप गोपनीयता नीति और सामुदायिक नियमों को स्वीकार करते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar, aceptas la política de privacidad y las normas de la comunidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuant, vous acceptez la politique de confidentialité et les règles de la communauté."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالمتابعة، فإنك توافق على سياسة الخصوصية وقواعد المجتمع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালিয়ে যাওয়ার মাধ্যমে আপনি গোপনীয়তা নীতি এবং সম্প্রদায়ের নিয়মাবলী গ্রহণ করছেন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao continuar, você aceita a política de privacidade e as regras da comunidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжая, вы принимаете политику конфиденциальности и правила сообщества."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Indem Sie fortfahren, akzeptieren Sie die Datenschutzrichtlinie und die Community-Regeln."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行すると、プライバシーポリシーとコミュニティガイドラインに同意したことになります。"
          }
        }
      }
    },

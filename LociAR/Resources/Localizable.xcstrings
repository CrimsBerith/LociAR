    "Konum ±%lld m. Pini tam bulunduğun yere getirip tekrar Burada yayınla’ya bas." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموقع ±%lld م. ضع الدبوس في مكانك تمامًا ثم اضغط انشر هنا مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অবস্থান ±%lld মি। পিনটি ঠিক আপনার জায়গায় রাখুন, তারপর আবার এখানে পোস্ট করুন চাপুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standort ±%lld m. Setze die Nadel genau auf deinen Standort und tippe erneut auf „Hier veröffentlichen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location ±%lld m. Move the pin to exactly where you are, then tap Post here again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubicación ±%lld m. Coloca el pin justo donde estás y toca de nuevo Publicar aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Position ±%lld m. Place l’épingle exactement là où tu es, puis touche à nouveau Publier ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लोकेशन ±%lld मी। पिन को ठीक अपनी जगह पर रखें, फिर दोबारा यहाँ पोस्ट करें दबाएँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置の誤差 ±%lld m。ピンを今いる場所に合わせてから、もう一度「ここに投稿」をタップしてください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localização ±%lld m. Coloque o pino exatamente onde você está e toque de novo em Publicar aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точность ±%lld м. Поставьте метку точно туда, где вы, и снова нажмите «Опубликовать здесь»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum ±%lld m. Pini tam bulunduğun yere getirip tekrar Burada yayınla’ya bas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定位 ±%lld 米。请把图钉放到你所在的确切位置，然后再次点击“在这里发布”。"
          }
        }
      }
    },
    "Konum alanları iOS’a kaydedilemedi. Bildirimler gecikebilir; tekrar dene." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر تسجيل مناطق الموقع في iOS. قد تتأخر الإشعارات؛ حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS-এ অবস্থানের এলাকাগুলো নিবন্ধন করা যায়নি। বিজ্ঞপ্তি আসতে দেরি হতে পারে; আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Standortbereiche konnten nicht in iOS registriert werden. Benachrichtigungen können sich verzögern; versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location areas could not be registered with iOS. Notifications may be delayed; try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron registrar las zonas de ubicación en iOS. Las notificaciones pueden retrasarse; inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les zones de localisation n’ont pas pu être enregistrées dans iOS. Les notifications peuvent être retardées ; réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS में स्थान क्षेत्र दर्ज नहीं हो सके। सूचनाओं में देरी हो सकती है; फिर से कोशिश करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSに位置エリアを登録できませんでした。通知が遅れる場合があります。もう一度お試しください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível registrar as áreas de localização no iOS. As notificações podem atrasar; tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось зарегистрировать зоны местоположения в iOS. Уведомления могут задерживаться; повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum alanları iOS’a kaydedilemedi. Bildirimler gecikebilir; tekrar dene."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在 iOS 中注册位置区域。通知可能延迟，请重试。"
          }
        }
      }
    },
    "Konum alınamadı. Açık bir alanda kısa süre bekleyip tekrar deneyin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن الحصول على الموقع. انتظر لفترة قصيرة في منطقة مفتوحة وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অবস্থান পাওয়া যায়নি. খোলা জায়গায় কিছুক্ষণ অপেক্ষা করুন এবং আবার চেষ্টা করুন।"

            "value": "未找到与此帖子链接的表面地图。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पोस्ट से जुड़ा सतह मानचित्र नहीं मिला."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el mapa de superficie vinculado a esta publicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte de surface liée à ce post n'a pas été trouvée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على الخريطة السطحية المرتبطة بهذا المنشور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পোস্টের সাথে সংযুক্ত পৃষ্ঠ মানচিত্র পাওয়া যায়নি."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapa de superfície vinculado a esta postagem não foi encontrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не найдена карта поверхности, связанная с этой публикацией."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die mit diesem Beitrag verknüpfte Oberflächenkarte wurde nicht gefunden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この投稿にリンクされている地表マップは見つかりませんでした。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Postun yüzey içeriği hazırlanamadı.": {

          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تحميل المشاركات المحفوظة في هذا الوقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত পোস্ট এই সময়ে লোড করা যাবে না."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Postagens salvas não podem ser carregadas neste momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удалось загрузить сохранённые публикации."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Beiträge können derzeit nicht geladen werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",

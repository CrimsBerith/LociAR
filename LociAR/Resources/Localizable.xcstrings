    "Yüzey kilitli. Yeniden açılabilir kayıt için telefonu yüzeyin çevresinde yavaşça gezdir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

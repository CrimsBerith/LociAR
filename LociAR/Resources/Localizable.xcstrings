    "İçerikler şu anda yüklenemiyor. Biraz sonra tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçerikler şu anda yüklenemiyor. Biraz sonra tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contents cannot be loaded at this time. Try again in a little while."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此时无法加载内容。稍后再试一次。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समय सामग्री लोड नहीं की जा सकती. थोड़ी देर में पुनः प्रयास करें."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido no se puede cargar en este momento. Vuelve a intentarlo dentro de un rato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu ne peut pas être chargé pour le moment. Réessayez dans quelques instants."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تحميل المحتويات في هذا الوقت. حاول مرة أخرى بعد قليل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিষয়বস্তু এই সময়ে লোড করা যাবে না. কিছুক্ষণের মধ্যে আবার চেষ্টা করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo não pode ser carregado neste momento. Tente novamente daqui a pouco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настоящее время содержимое не может быть загружено. Повторите попытку через некоторое время."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt kann derzeit nicht geladen werden. Versuchen Sie es später noch einmal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在コンテンツをロードできません。しばらくしてからもう一度お試しください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "İçeriği aç, Paylaş menüsünden bağlantıyı kopyala ve bu ekrana dön. Tamam bağlantıyı doğrulayıp karta ekler.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçeriği aç, Paylaş menüsünden bağlantıyı kopyala ve bu ekrana dön. Tamam bağlantıyı doğrulayıp karta ekler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the content, copy its link from the Share menu, then return here. Tap OK to verify the link and add it to the card."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开内容，从「分享」菜单复制链接，然后返回此处。点击「好的」以验证链接并将其添加到卡片中。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामग्री खोलें, शेयर मेनू से उसका लिंक कॉपी करें, फिर यहां वापस आएं। लिंक को सत्यापित करने और इसे कार्ड में जोड़ने के लिए ओके पर टैप करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra el contenido, copie su enlace del menú Compartir y luego regrese aquí. Toque Aceptar para verificar el enlace y agregarlo a la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le contenu, copiez son lien depuis le menu Partager, puis revenez ici. Appuyez sur OK pour vérifier le lien et l'ajouter à la carte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح المحتوى، وانسخ الرابط الخاص به من قائمة المشاركة، ثم ارجع إلى هنا. انقر فوق \"موافق\" للتحقق من الرابط وإضافته إلى البطاقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিষয়বস্তু খুলুন, শেয়ার মেনু থেকে এর লিঙ্কটি অনুলিপি করুন, তারপরে এখানে ফিরে আসুন। লিঙ্কটি যাচাই করতে ও কার্ডে যোগ করতে ঠিক আছে আলতো চাপুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o conteúdo, copie o link do menu Compartilhar e volte aqui. Toque em OK para verificar o link e adicioná-lo ao cartão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте контент, скопируйте ссылку из меню «Поделиться», затем вернитесь сюда. Нажмите «ОК», чтобы проверить ссылку и добавить её в карточку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie den Inhalt, kopieren Sie den Link aus dem Menü „Teilen“ und kehren Sie dann hierher zurück. Tippen Sie auf OK, um den Link zu überprüfen und zur Karte hinzuzufügen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツを開き、[共有] メニューからリンクをコピーして、ここに戻ります。 [OK] をタップしてリンクを確認し、カードに追加します。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "İçeriğini ekleyebilir veya farklı bir yüzey seçebilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {

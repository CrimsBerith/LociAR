        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "72% do seu apoio vai para o autor. O restante cobre os custos de pagamento e da plataforma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "72% вашей поддержки получает автор. Остаток покрывает расходы на платежи и платформу."

    "Kaydedilen postların bir kısmı yüklenemedi. Yenilemek için aşağı çek." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedilen postların bir kısmı yüklenemedi. Yenilemek için aşağı çek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some saved posts couldn’t be loaded. Pull down to refresh."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige gespeicherte Posts konnten nicht geladen werden. Zum Aktualisieren nach unten ziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas publicaciones guardadas no se pudieron cargar. Desliza hacia abajo para actualizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines publications enregistrées n’ont pas pu être chargées. Tirez vers le bas pour actualiser."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",

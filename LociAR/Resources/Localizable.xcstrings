    "Bildirimler 24 saat içinde incelenir. İçeriği görmek istemiyorsan kullanıcıyı engelleyebilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم مراجعة التقارير خلال 24 ساعة. قم بحظر المستخدم إذا كنت لا تريد رؤية محتواه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রিপোর্ট 24 ঘন্টার মধ্যে পর্যালোচনা করা হয়. আপনি যদি ব্যবহারকারীর বিষয়বস্তু দেখতে না চান তাহলে তাকে ব্লক করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldungen werden innerhalb von 24 Stunden geprüft. Blockieren Sie den Nutzer, wenn Sie seine Inhalte nicht sehen möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports are reviewed within 24 hours. Block the user if you do not want to see their content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las denuncias se revisan en un plazo de 24 horas. Bloquea al usuario si no quieres ver su contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signalements sont examinés sous 24 heures. Bloquez la personne si vous ne souhaitez pas voir son contenu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 घंटे के भीतर रिपोर्ट की समीक्षा की जाती है। यदि आप उपयोगकर्ता की सामग्री नहीं देखना चाहते तो उसे ब्लॉक कर दें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "報告は24時間以内に確認されます。コンテンツを見たくない場合は、そのユーザーをブロックしてください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As denúncias são analisadas em até 24 horas. Bloqueie o usuário se não quiser ver seu conteúdo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жалобы рассматриваются в течение 24 часов. Заблокируйте пользователя, если не хотите видеть его контент."
          }
        },

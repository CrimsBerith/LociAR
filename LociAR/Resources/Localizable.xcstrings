          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The surface map has limited detail but is usable. Slowly move the phone for a stronger lock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa de superficie tiene pocos detalles, pero se puede usar. Mueve el teléfono lentamente para conseguir un anclaje más estable."

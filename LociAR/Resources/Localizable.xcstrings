    "Şehrinde yürürken diğer kaşiflerin bıraktığı mekânsal paylaşımları tam konumlarında AR kameranla keşfet.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şehrinde diğer kaşiflerin bıraktığı postları AR kameranla keşfet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the AR camera to discover posts other explorers have left around your city."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 AR 相机，发现其他探索者在您的城市中留下的帖子。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AR कैमरे से अपने शहर में दूसरे खोजकर्ताओं द्वारा छोड़ी गई पोस्ट खोजें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la cámara AR para descubrir las publicaciones que otros exploradores han dejado por tu ciudad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la caméra AR pour découvrir les publications laissées par d’autres explorateurs dans votre ville."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم كاميرا الواقع المعزز لاكتشاف المنشورات التي تركها مستكشفون آخرون في مدينتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "AR ক্যামেরা দিয়ে আপনার শহরে অন্য অনুসন্ধানকারীদের রেখে যাওয়া পোস্ট আবিষ্কার করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a câmera AR para descobrir as postagens que outros exploradores deixaram pela sua cidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте AR-камеру, чтобы находить публикации, оставленные другими исследователями в вашем городе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecken Sie mit der AR-Kamera Beiträge, die andere Entdecker in Ihrer Stadt hinterlassen haben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AR カメラで、他の探索者があなたの街に残した投稿を見つけましょう。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

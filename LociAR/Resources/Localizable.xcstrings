            "value" : "केवल आपके चुने गए प्लेटफ़ॉर्म का मान्य शेयर लिंक स्वीकार किया जाता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু আপনার বেছে নেওয়া প্ল্যাটফর্মের বৈধ শেয়ার লিংক গ্রহণ করা হয়।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したプラットフォームの有効な共有リンクのみ受け付けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只接受你所选平台的有效分享链接。"
          }
        }
      }
    },
    "Yalnız tahmini yüzey bulundu. Fiziksel kilit için düzlemi taramaya devam edin veya yaklaşık yerleştirmeyi açıkça seçin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnız tahmini yüzey bulundu. Fiziksel kilit için düzlemi taramaya devam edin veya yaklaşık yerleştirmeyi açıkça seçin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only an estimated surface was found. Keep scanning the plane for a physical lock or explicitly choose approximate placement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde nur eine geschätzte Fläche gefunden. Scanne die Ebene für eine physische Verankerung weiter oder wähle ausdrücklich die ungefähre Platzierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se encontró una superficie estimada. Sigue escaneando el plano para un anclaje físico o elige explícitamente la colocación aproximada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule une surface estimée a été trouvée. Continuez à scanner le plan pour un ancrage physique ou choisissez explicitement le placement approximatif."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só foi encontrada uma superfície estimada. Continue escaneando o plano para uma ancoragem física ou escolha explicitamente o posicionamento aproximado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдена только предполагаемая поверхность. Продолжайте сканировать плоскость для физической привязки или явно выберите приблизительное размещение."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم العثور على سطح تقديري فقط. واصل مسح المستوى لتثبيت فعلي أو اختر صراحةً الوضع التقريبي."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल अनुमानित सतह मिली। भौतिक लॉक के लिए समतल को स्कैन करते रहें या स्पष्ट रूप से अनुमानित प्लेसमेंट चुनें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু একটি আনুমানিক পৃষ্ঠ পাওয়া গেছে। ভৌত লকের জন্য তলটি স্ক্যান করতে থাকুন বা স্পষ্টভাবে আনুমানিক স্থাপন বেছে নিন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推定の面しか見つかりませんでした。物理的なロックのために平面のスキャンを続けるか、おおよその配置を明示的に選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只找到估计表面。请继续扫描平面以进行实体锁定，或明确选择大致放置。"
          }
        }
      }
    },

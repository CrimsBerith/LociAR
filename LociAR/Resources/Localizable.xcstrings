    "Yaklaşık konum izni açık. Notu doğru yere bırakmak için Ayarlar’dan Kesin Konum’u aç." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık konum izni açık. Notu doğru yere bırakmak için Ayarlar’dan Kesin Konum’u aç."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approximate location is on. To leave the note in the right spot, turn on Precise Location in Settings."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungefährer Standort ist aktiv. Damit die Notiz am richtigen Ort landet, aktiviere in den Einstellungen „Genauer Standort“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación aproximada está activada. Para dejar la nota en el lugar correcto, activa Ubicación exacta en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position approximative est activée. Pour placer la note au bon endroit, active Position exacte dans Réglages."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização aproximada está ativada. Para deixar a nota no lugar certo, ative Localização Precisa em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включена приблизительная геопозиция. Чтобы оставить заметку в нужном месте, включите «Точная геопозиция» в Настройках."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموقع التقريبي مفعّل. لترك الملاحظة في المكان الصحيح، فعّل الموقع الدقيق من الإعدادات."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमानित लोकेशन चालू है। नोट सही जगह छोड़ने के लिए सेटिंग्स में सटीक लोकेशन चालू करें।"
          }
        },
        "bn" : {
          "stringUnit" : {

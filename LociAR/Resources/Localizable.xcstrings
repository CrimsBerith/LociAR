        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अब आप इस लेखक के अनाम नोट नहीं देखेंगे। लेखक कौन है, यह आपको नहीं दिखाया जाएगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

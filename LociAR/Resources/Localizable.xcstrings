    "Apple ile giriş şu anda tamamlanamadı. Tekrar dene." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن إكمال تسجيل الدخول باستخدام Apple في الوقت الحالي. حاول ثانية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপলের সাথে সাইন ইন করা এই সময়ে সম্পূর্ণ করা যায়নি। আবার চেষ্টা করুন"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung mit Apple konnte derzeit nicht abgeschlossen werden. Versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing in with Apple could not be completed at this time. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo completar el inicio de sesión con Apple. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion avec Apple ne peut pas être finalisée pour le moment. Réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple के साथ साइन इन करना इस समय पूरा नहीं किया जा सका. पुनः प्रयास करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現時点では Apple でのサインインを完了できませんでした。もう一度やり直してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O login na Apple não pôde ser concluído neste momento. Tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В настоящее время не удалось выполнить вход в систему Apple. Попробуйте еще раз."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ile giriş şu anda tamamlanamadı. Tekrar dene."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法完成 Apple 登录。再试一次。"
          }
        }
      }
    },

    "Cihazı serin ve gölgeli bir yerde beklet. Sıcaklık normale dönünce AR taraması otomatik devam eder." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihazı serin ve gölgeli bir yerde beklet. Sıcaklık normale dönünce AR taraması otomatik devam eder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the device in a cool, shaded place. AR scanning resumes automatically once it cools down."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege das Gerät an einen kühlen, schattigen Ort. Der AR-Scan wird automatisch fortgesetzt, sobald es abgekühlt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja el dispositivo en un lugar fresco y a la sombra. El escaneo AR continuará automáticamente cuando se enfríe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez l’appareil dans un endroit frais et à l’ombre. Le scan RA reprendra automatiquement une fois refroidi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o dispositivo em um lugar fresco e à sombra. O escaneamento em RA continuará automaticamente quando esfriar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте устройство в прохладном, затенённом месте. AR-сканирование продолжится автоматически, когда оно остынет."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع الجهاز في مكان بارد ومظلل. سيستأنف مسح الواقع المعزز تلقائيًا عندما يبرد."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिवाइस को ठंडी, छायादार जगह पर रखें। ठंडा होने पर AR स्कैनिंग अपने आप जारी हो जाएगी।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিভাইসটি ঠান্ডা, ছায়াযুক্ত জায়গায় রাখুন। ঠান্ডা হলে AR স্ক্যানিং আপনা থেকেই আবার শুরু হবে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスを涼しい日陰に置いてください。温度が下がるとARスキャンが自動で再開します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请将设备放在阴凉处。降温后 AR 扫描会自动继续。"
          }
        }
      }
    },

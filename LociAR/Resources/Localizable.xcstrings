    "Yüzey kaydı sınırlı da olsa kullanılabilir. Daha sağlam kilit için telefonu yavaş gezdir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzey kaydı sınırlı da olsa kullanılabilir. Daha sağlam kilit için telefonu yavaş gezdir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The surface map has limited detail but is usable. Slowly move the phone for a stronger lock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表面贴图的细节有限，但可用。缓慢移动手机以获得更牢固的锁定。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सतह मानचित्र में सीमित विवरण है लेकिन यह प्रयोग योग्य है। मजबूत लॉक के लिए फोन को धीरे-धीरे घुमाएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mapa de superficie tiene pocos detalles, pero se puede usar. Mueve el teléfono lentamente para conseguir un anclaje más estable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte de surface est peu détaillée, mais utilisable. Déplacez lentement le téléphone pour un ancrage plus stable."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خريطة السطح قليلة التفاصيل، لكنها قابلة للاستخدام. حرك الهاتف ببطء للحصول على تثبيت أكثر استقرارًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পৃষ্ঠ মানচিত্রে সীমিত বিশদ আছে কিন্তু ব্যবহারযোগ্য। একটি শক্তিশালী লকের জন্য ফোনটি ধীরে ধীরে সরান৷"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapa de superfície tem poucos detalhes, mas pode ser usado. Mova o telefone lentamente para uma fixação mais estável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта поверхности содержит мало деталей, но пригодна для использования. Медленно перемещайте телефон для более надёжного закрепления."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Oberflächenkarte hat wenige Details, ist aber verwendbar. Bewegen Sie das Telefon langsam, um eine stabilere Verankerung zu erreichen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表面マップの詳細は限られていますが、使用できます。携帯電話をゆっくりと動かすと、ロックが強化されます。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

    "Post cihaz test modunda saklandı. Canlı backend bağlandığında yayınlanabilir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post cihaz test modunda saklandı. Canlı backend bağlandığında yayınlanabilir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The post was saved in device test mode. It can be published when the live backend is connected."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Beitrag wurde im Gerätetestmodus gespeichert. Er kann veröffentlicht werden, sobald die Verbindung zum Server besteht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La publicación se guardó en modo de prueba del dispositivo. Se puede publicar cuando el backend en vivo esté conectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La publication a été enregistrée en mode test de l’appareil. Elle pourra être publiée lorsque le serveur sera connecté."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A postagem foi salva no modo de teste do dispositivo. Ela poderá ser publicada quando o servidor estiver conectado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пост сохранен в режиме тестирования устройства. Его можно опубликовать при подключении живого бэкэнда."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ المنشور في وضع اختبار الجهاز. يمكن نشره عند توصيل الواجهة الخلفية المباشرة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट को डिवाइस परीक्षण मोड में सहेजा गया था. लाइव बैकएंड कनेक्ट होने पर इसे प्रकाशित किया जा सकता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পোস্টটি ডিভাইস টেস্ট মোডে সেভ করা হয়েছে। লাইভ ব্যাকএন্ড সংযুক্ত হলে এটি প্রকাশ করা যেতে পারে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿はデバイス テスト モードで保存されました。ライブ バックエンドが接続されている場合に公開できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该帖子是在设备测试模式下保存的。连接实时后端后即可发布。"
          }
        }
      }
    },
    "Post cihazda güvenle saklanamadı. Alanı boşaltıp tekrar deneyin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post cihazda güvenle saklanamadı. Alanı boşaltıp tekrar deneyin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not safely save the post on this device. Free some storage and try again."

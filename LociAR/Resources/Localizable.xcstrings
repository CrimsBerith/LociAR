    },
    "Profil fotoğrafın otomatik güvenlik kontrolünden geçtikten sonra görünecek. Uygunsuz içerik reddedilir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil fotoğrafın otomatik güvenlik kontrolünden geçtikten sonra görünecek. Uygunsuz içerik reddedilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile photo will appear after passing the automatic security check. Inappropriate content will be rejected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过自动安全检查后将显示您的个人资料照片。不适当的内容将被拒绝。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित सुरक्षा जांच पास करने के बाद आपकी प्रोफ़ाइल फ़ोटो दिखाई देगी. अनुचित सामग्री अस्वीकार कर दी जाएगी."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu foto de perfil aparecerá después de pasar el control de seguridad automático. Se rechazará el contenido inapropiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre photo de profil apparaîtra après avoir passé le contrôle de sécurité automatique. Le contenu inapproprié sera rejeté."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر صورة ملفك الشخصي بعد اجتياز فحص الأمان التلقائي. سيتم رفض المحتوى غير المناسب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বয়ংক্রিয় নিরাপত্তা পরীক্ষা পাস করার পরে আপনার প্রোফাইল ফটো প্রদর্শিত হবে। অনুপযুক্ত বিষয়বস্তু প্রত্যাখ্যান করা হবে."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto do seu perfil aparecerá após passar pela verificação automática de segurança. Conteúdo inapropriado será rejeitado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фотография вашего профиля появится после прохождения автоматической проверки безопасности. Неподходящий контент будет отклонен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Profilfoto erscheint nach bestandener automatischer Sicherheitsprüfung. Unangemessene Inhalte werden abgelehnt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動セキュリティチェックを通過すると、プロフィール写真が表示されます。不適切なコンテンツは拒否されます。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

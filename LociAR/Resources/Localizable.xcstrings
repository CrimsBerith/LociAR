      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harita hazır olmadı. Daha iyi ışıkta dokulu yüzeyi farklı açılardan tara; sonra Tekrar tara'yı seç veya Kapat ile iptal et."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The map isn’t ready. In better light, scan the textured surface from different angles; then choose Rescan or cancel with Close."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte ist nicht bereit. Scanne die strukturierte Fläche bei besserem Licht aus verschiedenen Winkeln; wähle dann Erneut scannen oder brich mit Schließen ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa no está listo. Con mejor luz, escanea la superficie con textura desde distintos ángulos; luego elige Volver a escanear o cancela con Cerrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte n’est pas prête. Avec un meilleur éclairage, scannez la surface texturée sous différents angles ; choisissez ensuite Rescanner ou annulez avec Fermer."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mapa não está pronto. Com uma luz melhor, escaneie a superfície com textura de ângulos diferentes; depois escolha Escanear de novo ou cancele em Fechar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта не готова. При лучшем освещении отсканируйте текстурированную поверхность с разных сторон; затем выберите «Сканировать снова» или отмените кнопкой «Закрыть»."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخريطة غير جاهزة. في إضاءة أفضل، امسح السطح ذا التفاصيل من زوايا مختلفة؛ ثم اختر «إعادة المسح» أو ألغِ عبر «إغلاق»."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैप तैयार नहीं है। बेहतर रोशनी में बनावट वाली सतह को अलग-अलग कोणों से स्कैन करें; फिर ‘फिर से स्कैन करें’ चुनें या ‘बंद करें’ से रद्द करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মানচিত্র প্রস্তুত হয়নি। ভালো আলোতে টেক্সচারযুক্ত পৃষ্ঠটি বিভিন্ন কোণ থেকে স্ক্যান করুন; তারপর ‘আবার স্ক্যান করুন’ বেছে নিন বা ‘বন্ধ করুন’ দিয়ে বাতিল করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップの準備ができていません。明るい場所で、模様のある面をいろいろな角度からスキャンし、「再スキャン」を選ぶか「閉じる」でキャンセルしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地图尚未就绪。请在更好的光线下从不同角度扫描有纹理的表面；然后选择“重新扫描”，或点按“关闭”取消。"
          }
        }
      }
    },
    "Harita, Keşfet, arama ve VoiceOver’da kullanılır." : {
      "extractionState" : "manual",

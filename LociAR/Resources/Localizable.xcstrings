    "Post zeminde. Nişanı yüzeye indir, ortala.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Post zeminde. Nişanı yüzeye indir, ortala."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The post is on the floor. Lower the reticle to the surface and center it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帖子在地板上。将十字线降低到表面并将其居中。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट फर्श पर है. रेटिकल को सतह पर नीचे लाएँ और उसे केन्द्रित करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La publicación está en el suelo. Baja la retícula a la superficie y céntrala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La publication est au sol. Abaissez le réticule vers la surface et centrez-le."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المنشور على الأرض. اخفض علامة التصويب إلى السطح وضعها في المنتصف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পোস্টটি মেঝেতে। জালিকাটিকে পৃষ্ঠের দিকে নিচু করুন এবং এটিকে কেন্দ্র করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A postagem está no chão. Abaixe o retículo até a superfície e centralize-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пост лежит на полу. Опустите сетку на поверхность и отцентрируйте ее."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beitrag liegt auf dem Boden. Senken Sie das Fadenkreuz auf die Oberfläche und zentrieren Sie es."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポストは床にあります。レティクルを表面まで下げて中央に配置します。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Post şu anda silinemiyor. Bağlantını kontrol edip tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Post şu anda silinemiyor. Bağlantını kontrol edip tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The post cannot be deleted at this time. Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法删除该帖子。检查您的连接并重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समय पोस्ट को हटाया नहीं जा सकता. अपना कनेक्शन जांचें और पुनः प्रयास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La publicación no se puede eliminar en este momento. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La publication ne peut pas être supprimée pour le moment. Vérifiez votre connexion et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن حذف المشاركة في هذا الوقت. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে পোস্ট মুছে ফেলা যাবে না. আপনার সংযোগ পরীক্ষা করুন এবং আবার চেষ্টা করুন."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A postagem não pode ser excluída neste momento. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На данный момент пост невозможно удалить. Проверьте подключение и повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beitrag kann derzeit nicht gelöscht werden. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現時点では投稿を削除できません。接続を確認して、もう一度試してください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Posta dokundun. Nokta atışı için kamerayı çevir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posta dokundun. Nokta atışı için kamerayı çevir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post selected. Turn the camera to begin aim guidance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帖子已选。转动相机开始瞄准引导。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोस्ट चयनित. लक्ष्य मार्गदर्शन शुरू करने के लिए कैमरा घुमाएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicación seleccionada. Gire la cámara para comenzar a apuntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Publication sélectionnée. Tournez la caméra pour commencer le guidage de visée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اختيار المشاركة. أدر الكاميرا لبدء توجيه الهدف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পোস্ট নির্বাচিত। লক্ষ্য নির্দেশিকা শুরু করতে ক্যামেরাটি ঘুরিয়ে দিন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Postagem selecionada. Gire a câmera para iniciar a orientação de mira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пост выбран. Поверните камеру, чтобы начать прицеливание."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beitrag ausgewählt. Drehen Sie die Kamera, um mit der Zielführung zu beginnen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿が選択されました。カメラを回転させて照準の誘導を開始します。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

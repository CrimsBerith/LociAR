    "Bu bölge veya hesap için yayın sınırına ulaşıldı. Daha sonra tekrar deneyin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bölge veya hesap için yayın sınırına ulaşıldı. Daha sonra tekrar deneyin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The posting limit for this area or account has been reached. Try again later."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Veröffentlichungslimit für dieses Gebiet oder dieses Konto wurde erreicht. Versuchen Sie es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha alcanzado el límite de publicación para esta área o cuenta. Vuelve a intentarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite de publication pour cette zone ou ce compte a été atteinte. Réessayez plus tard."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O limite de postagem para esta área ou conta foi atingido. Tente novamente mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достигнут лимит публикаций для этой области или аккаунта. Повторите попытку позже."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الوصول إلى حد النشر لهذه المنطقة أو الحساب. حاول مرة أخرى لاحقًا."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस क्षेत्र या खाते की पोस्ट सीमा पूरी हो चुकी है। बाद में फिर से प्रयास करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই এলাকা বা অ্যাকাউন্টের জন্য পোস্টিং সীমা পৌঁছে গেছে. পরে আবার চেষ্টা করুন."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエリアまたはアカウントの投稿制限に達しました。後でもう一度試してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已达到该区域或帐户的发帖限制。稍后再试。"
          }
        }
      }
    },

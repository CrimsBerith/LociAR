        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paiement n’a pas encore été vérifié. Vérifiez son statut avant de payer à nouveau."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pagamento ainda não foi verificado. Consulte o status antes de pagar novamente."
          }

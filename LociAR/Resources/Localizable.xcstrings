    "Güvenlik için hesabı silmeden önce yeniden doğrulama gerekiyor." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لأمانك، تحقّق من هويتك مجددًا قبل حذف حسابك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিরাপত্তার জন্য অ্যাকাউন্ট মুছে ফেলার আগে আবার পরিচয় যাচাই করতে হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige zu deiner Sicherheit erneut deine Identität, bevor du dein Konto löschst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For your security, verify your identity again before deleting your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por seguridad, vuelve a verificar tu identidad antes de eliminar la cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour votre sécurité, vérifiez à nouveau votre identité avant de supprimer votre compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सुरक्षा के लिए खाता मिटाने से पहले पहचान फिर से सत्यापित करना आवश्यक है।"
          }
        },
        "ja" : {
          "stringUnit" : {

    "Konum doğruluğu yayın için yeterli değil. Açık bir alanda tekrar deneyin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum doğruluğu yayın için yeterli değil. Açık bir alanda tekrar deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location accuracy is insufficient to publish. Try again in an open area."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置精度不够，无法发布。在空旷的地方再试一次。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रकाशित करने के लिए स्थान सटीकता अपर्याप्त है. किसी खुले क्षेत्र में पुनः प्रयास करें."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La precisión de la ubicación es insuficiente para publicar. Inténtalo de nuevo en un área abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La précision de la localisation est insuffisante pour publier. Réessayez dans un espace ouvert."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دقة الموقع غير كافية للنشر. حاول مرة أخرى في منطقة مفتوحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান নির্ভুলতা প্রকাশ করার জন্য অপর্যাপ্ত. একটি খোলা এলাকায় আবার চেষ্টা করুন."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A precisão da localização é insuficiente para publicar. Tente novamente em uma área aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точность определения местоположения недостаточна для публикации. Попробуйте еще раз на открытой местности."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standortgenauigkeit reicht für die Veröffentlichung nicht aus. Versuchen Sie es erneut in einem offenen Bereich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報の精度が不足しているため、公開できません。開けた場所でもう一度試してください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Konum henüz netleşmedi. İç mekânda biraz bekleyip tekrar dene veya Ayarlar’dan konum iznini kontrol et.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum henüz netleşmedi. İç mekânda biraz bekleyip tekrar dene veya Ayarlar’dan konum iznini kontrol et."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The location is not clear yet. Wait indoors for a while and try again, or check location permission in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置还不清楚。请在室内等待一段时间后重试，或检查“设置”中的位置权限。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी स्थान स्पष्ट नहीं है. कुछ देर घर के अंदर प्रतीक्षा करें और पुनः प्रयास करें, या सेटिंग्स में स्थान अनुमति की जांच करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación aún no está clara. Espere un momento en el interior e inténtelo de nuevo, o verifique el permiso de ubicación en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement n'est pas encore clair. Attendez un moment à l'intérieur et réessayez, ou vérifiez l'autorisation de localisation dans les paramètres."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموقع ليس واضحا بعد. انتظر في الداخل لبعض الوقت وحاول مرة أخرى، أو تحقق من إذن الموقع في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান এখনও পরিষ্কার নয়। কিছুক্ষণ বাড়ির ভিতরে অপেক্ষা করুন এবং আবার চেষ্টা করুন বা সেটিংসে অবস্থানের অনুমতি পরীক্ষা করুন৷"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização ainda não está clara. Aguarde um pouco dentro de casa e tente novamente ou verifique a permissão de localização em Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местоположение пока не ясно. Подождите некоторое время в помещении и повторите попытку или проверьте разрешение на определение местоположения в настройках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort ist noch nicht klar. Warten Sie eine Weile drinnen und versuchen Sie es erneut, oder überprüfen Sie die Standortberechtigung in den Einstellungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所はまだ明らかではありません。屋内でしばらく待ってから再試行するか、設定で位置情報の許可を確認してください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Konum izni gerekli. Ayarlar'dan konum erişimini açın.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum izni gerekli. Ayarlar'dan konum erişimini açın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission required. Turn on location access from Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要位置许可。从“设置”中打开位置访问。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान की अनुमति आवश्यक है. सेटिंग्स से लोकेशन एक्सेस चालू करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso de ubicación. Active el acceso a la ubicación desde Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation de localisation requise. Activez l'accès à la localisation à partir des paramètres."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن الموقع مطلوب. قم بتشغيل الوصول إلى الموقع من الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান অনুমতি প্রয়োজন. সেটিংস থেকে অবস্থান অ্যাক্সেস চালু করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária permissão de localização. Ative o acesso à localização em Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется разрешение на доступ к местоположению. Включите его в настройках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standortgenehmigung erforderlich. Aktivieren Sie den Standortzugriff in den Einstellungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報の許可が必要です。設定から位置情報へのアクセスをオンにします。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Konum izni kapalı. Ayarlar’dan LociAR için konumu açın.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum izni kapalı. Ayarlar’dan LociAR için konumu açın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission is turned off. Turn on location for LociAR from Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置权限已关闭。从“设置”中打开 LociAR 的位置。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान अनुमति बंद है. सेटिंग्स से LociAR के लिए स्थान चालू करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de ubicación está desactivado. Active la ubicación para LociAR desde Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation de localisation est désactivée. Activez la localisation pour LociAR à partir des paramètres."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف إذن تحديد الموقع. قم بتشغيل موقع LociAR من الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থানের অনুমতি বন্ধ করা হয়েছে। সেটিংস থেকে LociAR-এর জন্য অবস্থান চালু করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de localização está desativada. Ative a localização do LociAR em Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на определение местоположения отключено. Включите местоположение для LociAR в настройках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standortberechtigung ist deaktiviert. Aktivieren Sie den Standort für LociAR in den Einstellungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報の許可がオフになっています。 [設定] から LociAR の位置情報をオンにします。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Konum servisine ulaşılamıyor. Bağlantınızı kontrol edin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",

    "Daha dokulu veya aydınlık bir yüzeye yönelin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha dokulu veya aydınlık bir yüzeye yönelin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at a brighter or more textured surface."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将相机对准更明亮或纹理更丰富的表面。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे को किसी उजली या अधिक बनावट वाली सतह पर इंगित करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunte la cámara hacia una superficie más brillante o con más textura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez l'appareil photo vers une surface plus lumineuse ou plus texturée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتوجيه الكاميرا نحو سطح أكثر سطوعًا أو مزخرفًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরাটিকে একটি উজ্জ্বল বা আরও টেক্সচারযুক্ত পৃষ্ঠের দিকে নির্দেশ করুন৷"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte a câmera para uma superfície mais brilhante ou com mais textura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите камеру на более яркую или текстурированную поверхность."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richten Sie die Kamera auf eine hellere oder strukturiertere Oberfläche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より明るい表面またはよりテクスチャーのある表面にカメラを向けます。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preparing world position. The post isn’t tied to a pattern."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weltposition wird vorbereitet. Der Post ist nicht an ein Muster gebunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preparando la posición en el mundo. La publicación no depende de un patrón."
          }

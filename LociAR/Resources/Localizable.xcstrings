    "Cihaz test modu açık. Sunucu işlemleri bağlantı yeniden kurulana kadar yerel tutulur." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cihaz test modu açık. Sunucu işlemleri bağlantı yeniden kurulana kadar yerel tutulur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Device test mode is on. Server actions stay local until the connection is restored."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gerätetestmodus ist an. Serveraktionen bleiben lokal, bis die Verbindung wiederhergestellt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم العثور على سطح ثابت هنا. حرّك الحلقة المركزية فوق سطح أو اختر الوضع التقريبي."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ कोई स्थिर सतह नहीं मिली। बीच वाले रिंग को किसी सतह पर ले जाएँ या अनुमानित प्लेसमेंट चुनें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখানে কোনো স্থির পৃষ্ঠ পাওয়া যায়নি। মাঝের রিংটি কোনো পৃষ্ঠের ওপর সরান বা আনুমানিক স্থাপন বেছে নিন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでは安定した面が見つかりません。中央のリングを面の上に動かすか、おおよその配置を選んでください。"

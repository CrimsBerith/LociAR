    "Post zeminde. Nişanı yüzeye indir, ortala." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post zeminde. Nişanı yüzeye indir, ortala."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The post is on the floor. Lower your aim to the surface and center it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Post ist auf dem Boden. Senke das Fadenkreuz auf die Fläche und zentriere sie."

    "E-posta adresin henüz doğrulanmadı. Gelen kutundaki bağlantıya dokunduktan sonra tekrar giriş yap." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-posta adresin henüz doğrulanmadı. Gelen kutundaki bağlantıya dokunduktan sonra tekrar giriş yap."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your email address isn’t verified yet. Tap the link in your inbox, then sign in again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine E-Mail-Adresse ist noch nicht bestätigt. Tippe auf den Link in deinem Posteingang und melde dich dann erneut an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu correo aún no está verificado. Toca el enlace de tu bandeja de entrada y vuelve a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre adresse e-mail n’est pas encore vérifiée. Touchez le lien dans votre boîte de réception, puis reconnectez-vous."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu e-mail ainda não foi verificado. Toque no link da sua caixa de entrada e entre novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш адрес эл. почты ещё не подтверждён. Нажмите ссылку во входящих и войдите снова."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم التحقق من بريدك الإلكتروني بعد. اضغط على الرابط في صندوق الوارد ثم سجّل الدخول مجددًا."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका ईमेल पता अभी सत्यापित नहीं है। इनबॉक्स में दिए लिंक पर टैप करें, फिर दोबारा साइन इन करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ইমেল ঠিকানা এখনো যাচাই হয়নি। ইনবক্সের লিংকে ট্যাপ করে আবার সাইন ইন করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールアドレスがまだ確認されていません。受信トレイのリンクをタップしてから、もう一度サインインしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的电子邮件地址尚未验证。请轻点收件箱中的链接，然后重新登录。"
          }
        }
      }
    },
    "E-posta gönderilemedi. Lütfen biraz sonra tekrar deneyin." : {

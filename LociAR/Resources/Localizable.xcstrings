    "Bekleyen not cihazda güvende. Yayını tekrar deneyebilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملاحظة المعلقة آمنة على هذا الجهاز. يمكنك محاولة النشر مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুলতুবি নোট এই ডিভাইসে নিরাপদ. আপনি আবার প্রকাশ করার চেষ্টা করতে পারেন."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausstehende Notiz ist sicher auf diesem Gerät gespeichert. Sie können die Veröffentlichung erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pending note is safe on this device. You can try publishing again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

    "%lld post şu anda yüklenemedi. Yenilemek için aşağı çek.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld post şu anda yüklenemedi. Yenilemek için aşağı çek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld posts could not be loaded. Pull down to refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载 %lld 个帖子。请下拉刷新。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld पोस्ट लोड नहीं की जा सकीं. ताज़ा करने के लिए नीचे खींचें."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar %lld publicaciones. Desliza hacia abajo para actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger %lld publications. Faites glisser vers le bas pour actualiser."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل %lld منشورات. اسحب للأسفل للتحديث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld পোস্ট লোড করা যায়নি। রিফ্রেশ করতে নিচে টানুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar %lld postagens. Puxe para baixo para atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить публикаций: %lld. Потяните вниз, чтобы обновить."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Beiträge konnten nicht geladen werden. Zum Aktualisieren nach unten ziehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 投稿を読み込めませんでした。プルダウンして更新します。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Bu oturumu çalıştırmak için Google, sensör verilerini (ör. kamera ve konum) işler.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oturumu çalıştırmak için Google, sensör verilerini (ör. kamera ve konum) işler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To power this session, Google will process sensor data (e.g., camera and location)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为支持此会话，Google 将处理传感器数据（例如摄像头和位置信息）。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सत्र को चलाने के लिए Google सेंसर डेटा (जैसे कैमरा और स्थान) संसाधित करेगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ejecutar esta sesión, Google procesará datos de sensores (por ejemplo, de la cámara y la ubicación)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour faire fonctionner cette session, Google traitera des données de capteurs (par exemple, de la caméra et de localisation)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتشغيل هذه الجلسة، ستعالج Google بيانات المستشعرات (مثل الكاميرا والموقع)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সেশন চালাতে Google সেন্সরের ডেটা (যেমন ক্যামেরা ও অবস্থান) প্রক্রিয়া করবে।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para executar esta sessão, o Google processará dados de sensores (por exemplo, câmera e localização)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для работы этого сеанса Google будет обрабатывать данные датчиков (например, камеры и местоположения)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Sitzung verarbeitet Google Sensordaten (z. B. Kamera- und Standortdaten)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションを実行するために、Google はセンサーデータ（カメラや位置情報など）を処理します。"
          }
        }
      },
      "comment": "UI terms reviewed in context in all supported languages, 2026-10-04. Confirm wrapping, VoiceOver and RTL on device before release."
    },

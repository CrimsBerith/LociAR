    "Yüzey aranıyor. Kamerayı postun bırakıldığı yere doğrult ve yavaşça gezdir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzey aranıyor. Kamerayı postun bırakıldığı yere doğrult ve yavaşça gezdir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching for the surface. Point the camera where the post was placed and move it slowly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在寻找表面。将相机对准帖子的放置位置并缓慢移动。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सतह की तलाश. कैमरे को उस स्थान पर रखें जहां पोस्ट रखी गई थी और उसे धीरे-धीरे घुमाएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando la superficie. Apunta la cámara al lugar donde se colocó la publicación y muévela lentamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de la surface. Pointez la caméra vers l’endroit où la publication a été placée et déplacez-la lentement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث عن السطح. قم بتوجيه الكاميرا حيث تم وضع المنشور وحركه ببطء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পৃষ্ঠের জন্য অনুসন্ধান করা হচ্ছে. ক্যামেরাটি যেখানে পোস্টটি স্থাপন করা হয়েছিল সেটিকে নির্দেশ করুন এবং ধীরে ধীরে সরান।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Procurando pela superfície. Aponte a câmera para onde o post foi colocado e mova-a lentamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск поверхности. Направьте камеру туда, где была размещена публикация, и медленно перемещайте телефон."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Oberfläche wird gesucht. Richten Sie die Kamera auf die Stelle, an der der Beitrag platziert wurde, und bewegen Sie sie langsam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表面を探しています。ポストが置かれている場所にカメラを向けて、ゆっくりと動かします。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

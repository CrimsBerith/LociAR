          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set location permission to Always for arrival notifications in the background."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle die Standortberechtigung auf Immer, um Ankunftsmitteilungen im Hintergrund zu erhalten."

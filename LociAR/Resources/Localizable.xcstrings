    "Bu yazarın anonim notları yalnız senin için gizlenir. Yazarın kimliği gösterilmez." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yazarın anonim notları yalnız senin için gizlenir. Yazarın kimliği gösterilmez."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will no longer see this author’s anonymous notes. Who the author is stays hidden from you."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du siehst die anonymen Notizen dieser Person nicht mehr. Wer sie verfasst hat, wird dir nicht angezeigt."

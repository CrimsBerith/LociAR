    "Postlar yalnızca metin ve sosyal medya bağlantısı içerebilir; fotoğraf ve video desteklenmiyor." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postlar yalnızca metin ve sosyal medya bağlantısı içerebilir; fotoğraf ve video desteklenmiyor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posts may contain only text and social media links; photos and videos are not supported."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beiträge dürfen nur Text und Links zu sozialen Medien enthalten; Fotos und Videos werden nicht unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las publicaciones pueden contener solo texto y enlaces a redes sociales; No se admiten fotos ni vídeos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les publications ne peuvent contenir que du texte et des liens vers les réseaux sociaux ; les photos et les vidéos ne sont pas prises en charge."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As postagens podem conter apenas texto e links de mídias sociais; fotos e vídeos não são suportados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщения могут содержать только текст и ссылки на социальные сети; фото и видео не поддерживаются."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تحتوي المنشورات على روابط نصية وروابط لوسائل التواصل الاجتماعي فقط؛ الصور ومقاطع الفيديو غير مدعومة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट में केवल टेक्स्ट और सोशल मीडिया लिंक हो सकते हैं; फ़ोटो और वीडियो समर्थित नहीं हैं."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পোস্টগুলিতে শুধুমাত্র পাঠ্য এবং সামাজিক মিডিয়া লিঙ্ক থাকতে পারে; ফটো এবং ভিডিও সমর্থিত নয়।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿にはテキストとソーシャルメディアリンクのみを含めることができます。写真やビデオはサポートされていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帖子可能仅包含文本和社交媒体链接；不支持照片和视频。"
          }
        }
      }
    },

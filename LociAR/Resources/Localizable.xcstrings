        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المنشور على الأرضية. اخفض المؤشر إلى السطح وضعه في المنتصف."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट फ़र्श पर है। निशाना सतह पर नीचे लाएँ और बीच में रखें।"

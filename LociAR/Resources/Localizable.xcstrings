    "Cihaz sıcaklığı yüksek; AR geçici olarak duraklatıldı.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz sıcaklığı yüksek; AR geçici olarak duraklatıldı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device temperature is high; AR has been temporarily paused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备温度高； AR 已暂时暂停。"

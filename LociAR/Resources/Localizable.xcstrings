          "stringUnit" : {
            "state" : "translated",
            "value" : "我把城市中被遗忘的故事留在它的表面上。"
          }
        }
      }
    },
    "Şehrinde yürürken diğer kaşiflerin bıraktığı mekânsal paylaşımları tam konumlarında AR kameranla keşfet." : {
      "extractionState" : "manual",

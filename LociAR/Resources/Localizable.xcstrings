          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn %lld° left toward the direction you faced when sharing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreh dich %lld° nach links in die Richtung, in die du beim Teilen geschaut hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত পরিবেশ পাওয়া যায়নি। এর আনুমানিক অবস্থানের দিকে আপনাকে গাইড করছে।"

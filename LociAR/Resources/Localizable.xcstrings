    "Banka aktarımı, ödeme hesabı ve mutabakat kurulumu tamamlandığında açılacak." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتاح التحويلات البنكية بعد إعداد حساب استلام الأموال وإتمام المطابقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পেমেন্ট গ্রহণের অ্যাকাউন্ট সেটআপ ও হিসাব মেলানো শেষ হলে ব্যাংক ট্রান্সফার চালু হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banküberweisungen sind nach Einrichtung des Auszahlungskontos und Abschluss der Abrechnung verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bank transfers will be available once payout account setup and reconciliation are complete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las transferencias bancarias estarán disponibles tras configurar la cuenta de cobro y completar la conciliación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les virements seront disponibles après la configuration du compte de versement et le rapprochement des paiements."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भुगतान खाता सेटअप और मिलान पूरा होने के बाद बैंक ट्रांसफ़र उपलब्ध होंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "振込先口座の設定と決済の照合が完了すると、銀行振込が利用可能になります。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As transferências bancárias estarão disponíveis após a configuração da conta de recebimento e a conciliação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Банковские переводы станут доступны после настройки счёта для выплат и сверки платежей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banka aktarımı, ödeme hesabı ve mutabakat kurulumu tamamlandığında açılacak."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成收款账户设置和对账后，将开放银行转账。"
          }
        }
      }
    },
    "Başka bir kelimeyle ara." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {

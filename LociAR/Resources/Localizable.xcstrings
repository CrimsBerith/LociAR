          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location service is unavailable. Check your connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位服务不可用。检查您的连接。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान सेवा उपलब्ध नहीं है. अपना कनेक्शन जांचें."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de ubicación no está disponible. Comprueba tu conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de localisation n'est pas disponible. Vérifiez votre connexion."

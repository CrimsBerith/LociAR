        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为您的帐户设置至少 8 个字符的新密码。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने खाते के लिए कम से कम 8 अक्षरों वाला एक नया पासवर्ड सेट करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establezca una nueva contraseña para su cuenta con al menos 8 caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un nouveau mot de passe pour votre compte avec au moins 8 caractères."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتعيين كلمة مرور جديدة لحسابك مكونة من 8 أحرف على الأقل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্তত 8টি অক্ষর সহ আপনার অ্যাকাউন্টের জন্য একটি নতুন পাসওয়ার্ড সেট করুন৷"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina uma nova senha para sua conta com pelo menos 8 caracteres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите новый пароль для своей учетной записи длиной не менее 8 символов."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie für Ihr Konto ein neues Passwort mit mindestens 8 Zeichen fest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの新しいパスワードを 8 文字以上で設定します。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Hesabın oluşturuldu. E-postandaki doğrulama bağlantısına dokun, ardından giriş yap.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabın oluşturuldu. E-postandaki doğrulama bağlantısına dokun, ardından giriş yap."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account has been created. Tap the verification link in your email, then sign in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的帐户已创建。点击电子邮件中的验证链接，然后登录。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका अकाउंट बन गया है. अपने ईमेल में सत्यापन लिंक पर टैप करें, फिर साइन इन करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cuenta ha sido creada. Toca el enlace de verificación en tu correo electrónico y luego inicia sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte a été créé. Appuyez sur le lien de vérification dans votre e-mail, puis connectez-vous."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إنشاء حسابك. اضغط على رابط التحقق الموجود في بريدك الإلكتروني، ثم قم بتسجيل الدخول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাকাউন্ট তৈরি করা হয়েছে. আপনার ইমেলে যাচাইকরণ লিঙ্কটি আলতো চাপুন, তারপর সাইন ইন করুন৷"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta foi criada. Toque no link de verificação em seu e-mail e faça login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша учетная запись создана. Нажмите ссылку подтверждения в своем электронном письме, затем войдите в систему."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto wurde erstellt. Tippen Sie auf den Bestätigungslink in Ihrer E-Mail und melden Sie sich an."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントが作成されました。メール内の確認リンクをタップして、サインインします。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

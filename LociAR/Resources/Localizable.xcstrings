    "Hesabın oluşturuldu. E-postandaki doğrulama bağlantısına dokun, ardından giriş yap." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabın oluşturuldu. E-postandaki doğrulama bağlantısına dokun, ardından giriş yap."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account has been created. Tap the verification link in your email, then sign in."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Konto wurde erstellt. Tippen Sie auf den Bestätigungslink in Ihrer E-Mail und melden Sie sich an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su cuenta ha sido creada. Toca el enlace de verificación en tu correo electrónico y luego inicia sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

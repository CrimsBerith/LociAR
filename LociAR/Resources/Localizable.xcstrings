        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة الموقع غير متوفرة. تحقق من اتصالك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান পরিষেবা অনুপলব্ধ. আপনার সংযোগ পরীক্ষা করুন."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de localização não está disponível. Verifique sua conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба определения местоположения недоступна. Проверьте свое соединение."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standortdienst ist nicht verfügbar. Überprüfen Sie Ihre Verbindung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報サービスは利用できません。接続を確認してください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Konum şu anda alınamıyor. Biraz sonra tekrar deneyin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum şu anda alınamıyor. Biraz sonra tekrar deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The location cannot be retrieved at this time. Try again in a little while."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法检索该位置。稍后再试一次。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस समय स्थान पुनर्प्राप्त नहीं किया जा सकता. थोड़ी देर में पुनः प्रयास करें."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación no se puede recuperar en este momento. Vuelve a intentarlo dentro de un rato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement ne peut pas être récupéré pour le moment. Réessayez dans quelques instants."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استرداد الموقع في هذا الوقت. حاول مرة أخرى بعد قليل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সময়ে অবস্থান পুনরুদ্ধার করা যাবে না. কিছুক্ষণের মধ্যে আবার চেষ্টা করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização não pode ser recuperada neste momento. Tente novamente daqui a pouco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настоящее время невозможно получить местоположение. Повторите попытку через некоторое время."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort kann derzeit nicht abgerufen werden. Versuchen Sie es später noch einmal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現時点では場所を取得できません。しばらくしてからもう一度お試しください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

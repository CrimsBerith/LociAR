    "Not bırakmak ve yorum yapmak için Apple veya e-posta ile devam edebilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not bırakmak ve yorum yapmak için Apple veya e-posta ile devam edebilirsin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue with Apple or email to leave notes and comments."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fahre mit Apple oder E-Mail fort, um Notizen und Kommentare zu schreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continúa con Apple o correo electrónico para dejar notas y comentarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuez avec Apple ou par e-mail pour laisser des notes et des commentaires."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue com Apple ou e-mail para deixar notas e comentários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжите через Apple или электронную почту, чтобы оставлять заметки и комментарии."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع باستخدام Apple أو البريد الإلكتروني لترك ملاحظات وتعليقات."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट और टिप्पणियाँ लिखने के लिए Apple या ईमेल से जारी रखें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নোট ও মন্তব্য লিখতে Apple বা ইমেইল দিয়ে চালিয়ে যান।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノートやコメントを書くにはAppleまたはメールで続けてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Apple 或电子邮件继续，以发布笔记和评论。"
          }
        }
      }
    },

    "Daha iyi ışıkta dokulu yüzeyi farklı açılardan tara. Tekrar tara veya İptal et." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha iyi ışıkta dokulu yüzeyi farklı açılardan tara. Tekrar tara veya İptal et."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the textured surface from different angles in better light. Rescan or Cancel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannen Sie die strukturierte Oberfläche aus verschiedenen Winkeln bei besserem Licht. Erneut scannen oder abbrechen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanee la superficie texturizada desde diferentes ángulos con mejor luz. Volver a escanear o cancelar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez la surface texturée sous différents angles sous un meilleur éclairage. Nouvelle analyse ou Annulation."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitalize a superfície texturizada de diferentes ângulos com melhor iluminação. Digitalizar novamente ou cancelar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканируйте текстурированную поверхность под разными углами при лучшем освещении. Пересканировать или отменить."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح السطح الغني بالتفاصيل من زوايا مختلفة في إضاءة أفضل. أعد المسح أو ألغِ العملية."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेहतर रोशनी में बनावट वाली सतह को विभिन्न कोणों से स्कैन करें। पुनः स्कैन करें या रद्द करें."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভাল আলোতে বিভিন্ন কোণ থেকে টেক্সচার্ড পৃষ্ঠটি স্ক্যান করুন। রিস্ক্যান বা বাতিল করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明るい光の下で、さまざまな角度からテクスチャ表面をスキャンします。再スキャンまたはキャンセル。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在更好的光线下从不同角度扫描纹理表面。重新扫描或取消。"
          }
        }
      }
    },

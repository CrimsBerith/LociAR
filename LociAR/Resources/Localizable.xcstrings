    "Bu notun paylaşım kimliği değiştirilemez. Yeni bir not oluştur." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تغيير هوية نشر هذه الملاحظة. أنشئ ملاحظة جديدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই নোটের প্রকাশনার পরিচয় বদলানো যাবে না। নতুন নোট তৈরি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Veröffentlichungsidentität dieser Notiz kann nicht geändert werden. Erstelle eine neue Notiz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This note’s publishing identity cannot change. Create a new note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede cambiar la identidad de publicación de esta nota. Crea una nueva nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’identité de publication de cette note ne peut pas changer. Créez une nouvelle note."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस नोट की प्रकाशन पहचान नहीं बदल सकती। नया नोट बनाएँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このノートの公開時の名前表示は変更できません。新しいノートを作成してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",

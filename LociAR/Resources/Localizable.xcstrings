        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পৃষ্ঠ খোঁজা হচ্ছে। পোস্টটি যেখানে রাখা হয়েছিল সেদিকে ক্যামেরা তাক করে ধীরে সরান।"

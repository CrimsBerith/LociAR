            "state" : "translated",
            "value" : "无法发送链接。检查您的电子邮件地址和连接。"
          }
        }
      }
    },
    "Bağlantı kurulamadı. Biraz sonra tekrar dene." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {

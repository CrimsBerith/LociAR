    "Şehrin unutulan hikâyelerini yüzeylere bırakıyorum." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şehrin unutulan hikâyelerini yüzeylere bırakıyorum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I leave the city’s forgotten stories on its surfaces."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich hinterlasse die vergessenen Geschichten der Stadt auf ihren Flächen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejo las historias olvidadas de la ciudad en sus superficies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je laisse les histoires oubliées de la ville sur ses surfaces."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixo as histórias esquecidas da cidade nas suas superfícies."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я оставляю забытые истории города на его поверхностях."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أترك قصص المدينة المنسية على أسطحها."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं शहर की भूली-बिसरी कहानियाँ उसकी सतहों पर छोड़ता/छोड़ती हूँ।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমি শহরের ভুলে যাওয়া গল্পগুলো তার পৃষ্ঠে রেখে যাই।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "街の忘れられた物語を、その面に残しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我把城市中被遗忘的故事留在它的表面上。"
          }
        }
      }
    },
    "Şehrinde yürürken diğer kaşiflerin bıraktığı mekânsal paylaşımları tam konumlarında AR kameranla keşfet." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şehrinde yürürken diğer kaşiflerin bıraktığı mekânsal paylaşımları tam konumlarında AR kameranla keşfet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As you walk your city, discover spatial posts left by other explorers at their exact locations with your AR camera."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entdecke beim Spaziergang durch deine Stadt räumliche Posts anderer Entdecker genau an ihrem Ort – mit deiner AR-Kamera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras recorres tu ciudad, descubre con tu cámara AR las publicaciones espaciales que otros exploradores dejaron en su ubicación exacta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En marchant dans votre ville, découvrez avec votre caméra RA les publications spatiales laissées par d’autres explorateurs, à leur emplacement exact."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao caminhar pela sua cidade, descubra com a câmera de RA as publicações espaciais deixadas por outros exploradores no local exato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гуляя по городу, находите с помощью AR-камеры пространственные посты других исследователей точно там, где их оставили."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثناء تجوالك في مدينتك، اكتشف بكاميرا الواقع المعزز المنشورات المكانية التي تركها مستكشفون آخرون في مواقعها الدقيقة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने शहर में घूमते हुए, AR कैमरे से दूसरे खोजकर्ताओं की छोड़ी गई स्थानिक पोस्ट उनकी सटीक जगह पर खोजें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিজের শহরে হাঁটার সময় AR ক্যামেরা দিয়ে অন্য অভিযাত্রীদের রেখে যাওয়া স্থানিক পোস্টগুলো ঠিক তাদের জায়গায় খুঁজে নিন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "街を歩きながら、ほかの探検者が残した空間投稿をARカメラでその場所ちょうどに見つけましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "漫步城市时，用 AR 相机在精确位置发现其他探索者留下的空间帖子。"
          }
        }
      }
    },

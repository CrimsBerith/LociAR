    "Bu korumalı bölgede post yayınlanamaz.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu korumalı bölgede post yayınlanamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posts cannot be published in this protected area."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能在此保护区发布帖子。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस संरक्षित क्षेत्र में पोस्ट प्रकाशित नहीं की जा सकतीं."
          }
        },
        "es": {

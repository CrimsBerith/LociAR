    "Paylaşılanlar: cihaz türü, iOS ve uygulama sürümü, dil, saat dilimi, rastgele kurulum kimliği, bağlantı IP adresi ve kullanım zamanları. Yetkili yöneticiler görebilir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşılanlar: cihaz türü, iOS ve uygulama sürümü, dil, saat dilimi, rastgele kurulum kimliği, bağlantı IP adresi ve kullanım zamanları. Yetkili yöneticiler görebilir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shared data: device type, iOS and app version, language, time zone, random installation ID, connection IP address and usage times. Authorized administrators can view it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geteilte Daten: Gerätetyp, iOS- und App-Version, Sprache, Zeitzone, zufällige Installations-ID, Verbindungs-IP und Nutzungszeiten. Berechtigte Administratoren können sie einsehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos compartidos: tipo de dispositivo, versiones de iOS y de la app, idioma, zona horaria, ID de instalación aleatorio, IP de conexión y horarios de uso. Los administradores autorizados pueden verlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données partagées : type d’appareil, versions d’iOS et de l’app, langue, fuseau horaire, identifiant d’installation aléatoire, adresse IP de connexion et heures d’utilisation. Les administrateurs autorisés peuvent les consulter."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados compartilhados: tipo de dispositivo, versões do iOS e do app, idioma, fuso horário, ID de instalação aleatório, IP da conexão e horários de uso. Administradores autorizados podem vê-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передаются: тип устройства, версии iOS и приложения, язык, часовой пояс, случайный ID установки, IP-адрес подключения и время использования. Уполномоченные администраторы могут их просматривать."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البيانات المشتركة: نوع الجهاز وإصدارات iOS والتطبيق واللغة والمنطقة الزمنية ومعرّف تثبيت عشوائي وعنوان IP للاتصال وأوقات الاستخدام. يمكن للمسؤولين المخوّلين الاطلاع عليها."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साझा डेटा: डिवाइस का प्रकार, iOS और ऐप संस्करण, भाषा, समय क्षेत्र, रैंडम इंस्टॉलेशन ID, कनेक्शन का IP पता और उपयोग का समय। अधिकृत व्यवस्थापक इसे देख सकते हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শেয়ার করা ডেটা: ডিভাইসের ধরন, iOS ও অ্যাপ সংস্করণ, ভাষা, সময় অঞ্চল, এলোমেলো ইনস্টলেশন ID, সংযোগের IP ঠিকানা ও ব্যবহারের সময়। অনুমোদিত প্রশাসকেরা দেখতে পারেন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有されるデータ：端末の種類、iOSとアプリのバージョン、言語、タイムゾーン、ランダムなインストールID、接続IPアドレス、利用時間。権限のある管理者が閲覧できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享的数据：设备类型、iOS 和应用版本、语言、时区、随机安装 ID、连接 IP 地址及使用时间。获授权的管理员可以查看。"
          }
        }
      }
    },

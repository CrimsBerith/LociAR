      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu giriş yöntemi artık desteklenmiyor. E-posta ve şifre ya da Apple ile giriş yap."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sign-in method is no longer supported. Sign in with email and password or with Apple."
          }

    "Kullanıcı adı 3–30 karakter olmalı; yalnızca küçük harf, rakam, alt çizgi ve nokta içerebilir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcı adı 3–30 karakter olmalı; yalnızca küçük harf, rakam, alt çizgi ve nokta içerebilir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usernames must be 3–30 characters and can contain only lowercase letters, numbers, underscores and periods."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzernamen müssen 3–30 Zeichen lang sein und dürfen nur Kleinbuchstaben, Ziffern, Unterstriche und Punkte enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de usuario debe tener 3–30 caracteres y solo puede contener minúsculas, números, guion bajo y punto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom d’utilisateur doit comporter 3 à 30 caractères et ne contenir que des minuscules, chiffres, tirets bas et points."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome de usuário deve ter de 3 a 30 caracteres e só pode conter letras minúsculas, números, sublinhado e ponto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя пользователя должно содержать 3–30 символов: только строчные буквы, цифры, подчёркивание и точку."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يتكون اسم المستخدم من 3 إلى 30 حرفًا، وأن يحتوي فقط على أحرف إنجليزية صغيرة وأرقام وشرطة سفلية ونقطة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपयोगकर्ता नाम 3–30 अक्षरों का होना चाहिए और उसमें केवल छोटे अंग्रेज़ी अक्षर, अंक, अंडरस्कोर और बिंदु हो सकते हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যবহারকারী নাম ৩–৩০ অক্ষরের হতে হবে এবং এতে শুধু ইংরেজি ছোট হাতের অক্ষর, সংখ্যা, আন্ডারস্কোর ও ডট থাকতে পারে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザー名は3〜30文字で、英小文字、数字、アンダースコア、ピリオドのみ使用できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户名须为 3–30 个字符，只能包含小写字母、数字、下划线和句点。"
          }
        }
      }
    },
    "Kullanıcı adını en fazla 30 günde bir değiştirebilirsin." : {

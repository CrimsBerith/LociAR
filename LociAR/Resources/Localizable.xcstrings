    "Hesap şu anda silinemiyor. Biraz sonra tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap şu anda silinemiyor. Biraz sonra tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account cannot be deleted right now. Try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法删除账号。请稍后重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी खाता मिटाया नहीं जा सकता। कुछ देर बाद फिर प्रयास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta no se puede eliminar ahora. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte ne peut pas être supprimé pour le moment. Réessayez bientôt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذّر حذف حسابك حاليًا. حاول مجددًا بعد قليل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন অ্যাকাউন্ট মুছে ফেলা যাচ্ছে না। কিছুক্ষণ পরে আবার চেষ্টা করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível excluir sua conta agora. Tente novamente em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удаётся удалить аккаунт. Повторите попытку позже."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto kann gerade nicht gelöscht werden. Versuche es gleich noch einmal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在アカウントを削除できません。しばらくしてから再試行してください。"
          }
        }
      }
    },
    "Güvenlik için hesabı silmeden önce yeniden doğrulama gerekiyor.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik için hesabı silmeden önce yeniden doğrulama gerekiyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your security, verify your identity again before deleting your account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为保障安全，删除账号前需要重新验证身份。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सुरक्षा के लिए खाता मिटाने से पहले पहचान फिर से सत्यापित करना आवश्यक है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por seguridad, vuelve a verificar tu identidad antes de eliminar la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour votre sécurité, vérifiez à nouveau votre identité avant de supprimer votre compte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأمانك، تحقّق من هويتك مجددًا قبل حذف حسابك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিরাপত্তার জন্য অ্যাকাউন্ট মুছে ফেলার আগে আবার পরিচয় যাচাই করতে হবে।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por segurança, verifique sua identidade novamente antes de excluir a conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для безопасности подтвердите личность ещё раз перед удалением аккаунта."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige zu deiner Sicherheit erneut deine Identität, bevor du dein Konto löschst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全のため、アカウントを削除する前に再度本人確認が必要です。"
          }
        }
      }
    },
    "Hesabı silmek için Apple ile yeniden doğrulama gerekiyor.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabı silmek için Apple ile yeniden doğrulama gerekiyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify with Apple again to delete your account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除账号需要重新通过 Apple 验证。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता मिटाने के लिए Apple से फिर सत्यापन करना आवश्यक है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a verificar con Apple para eliminar la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez à nouveau avec Apple pour supprimer votre compte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق باستخدام Apple مجددًا لحذف حسابك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্ট মুছতে Apple দিয়ে আবার যাচাই করতে হবে।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique novamente com Apple para excluir a conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите личность через Apple ещё раз для удаления аккаунта."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige dich erneut mit Apple, um dein Konto zu löschen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの削除にはAppleでの再確認が必要です。"
          }
        }
      }
    },
    "Apple oturum izni geri alınamadı, hesabın silinmedi. Biraz sonra tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple oturum izni geri alınamadı, hesabın silinmedi. Biraz sonra tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple access could not be revoked. Your account was not deleted. Try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法撤销 Apple 授权，账号未被删除。请稍后重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple की अनुमति वापस नहीं ली जा सकी। आपका खाता नहीं मिटाया गया। कुछ देर बाद फिर प्रयास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo revocar el acceso de Apple. La cuenta no se ha eliminado. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès Apple n’a pas pu être révoqué. Votre compte n’a pas été supprimé. Réessayez bientôt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إلغاء إذن Apple. لم يُحذف حسابك. حاول مجددًا بعد قليل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-এর অনুমতি বাতিল করা যায়নি। আপনার অ্যাকাউন্ট মুছে যায়নি। কিছুক্ষণ পরে আবার চেষ্টা করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível revogar o acesso da Apple. Sua conta não foi excluída. Tente novamente em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отозвать доступ Apple. Аккаунт не удалён. Повторите попытку позже."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",

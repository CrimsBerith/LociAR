    "Paylaşırken baktığın yöne %lld° sağa dön.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşırken baktığın yöne %lld° sağa dön."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn %lld° right toward the direction you faced when posting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向右旋转 %lld°，对准发布帖子时的朝向。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld° को उस दिशा की ओर दाईं ओर मोड़ें जिसका सामना आपने पोस्ट करते समय किया था।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire %lld° a la derecha en la dirección en la que miraba al publicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez de %lld° vers la droite pour retrouver l’orientation de la publication."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدر %lld° يمينًا في الاتجاه الذي واجهته عند النشر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld° ডানদিকে ঘুরুন যে দিকে পোস্ট করার সময় আপনি মুখোমুখি হয়েছিলেন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vire %lld° à direita na direção que você olhou ao postar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверните %lld° вправо в том направлении, в котором вы смотрели при публикации."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehen Sie %lld° nach rechts in die Richtung, in die Sie beim Posten blickten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿時に向いていた方向へ、右に %lld° 回してください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Paylaşırken baktığın yöne %lld° sola dön.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşırken baktığın yöne %lld° sola dön."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn %lld° left toward the direction you faced when posting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向左旋转 %lld°，对准发布帖子时的朝向。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld° को उस दिशा की ओर बाईं ओर मोड़ें जिसका सामना आपने पोस्ट करते समय किया था।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire %lld° a la izquierda hacia la dirección en la que miraba al publicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez de %lld° vers la gauche pour retrouver l’orientation de la publication."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انعطف %lld° يسارًا باتجاه الاتجاه الذي واجهته عند النشر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld° বাম দিকে ঘুরুন যে দিকে আপনি পোস্ট করার সময় মুখোমুখি হয়েছিলেন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vire %lld° à esquerda na direção que você olhou ao postar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверните %lld° влево в направлении, в котором вы смотрели при публикации."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehen Sie %lld° nach links in die Richtung, in die Sie beim Posten blickten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿時に向いていた方向へ、左に %lld° 回してください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "%lld yayın var. Birine dokun, sonra nokta atışı yönlendirme başlar.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld yayın var. Birine dokun, sonra nokta atışı yönlendirme başlar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are %lld posts. Tap one to start aim guidance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个帖子。点击其中一个以开始瞄准引导。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld पोस्ट हैं। लक्ष्य मार्गदर्शन शुरू करने के लिए एक टैप करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay %lld publicaciones. Toca una para iniciar la guía de puntería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a %lld publications. Appuyez sur l’une d’elles pour démarrer le guidage de visée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك %lld منشورات. اضغط على أحدها لبدء إرشادات التصويب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld পোস্ট আছে। লক্ষ্য নির্দেশিকা শুরু করতে একটি আলতো চাপুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Há %lld postagens. Toque em uma para iniciar a orientação de mira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно публикаций: %lld. Нажмите на одну, чтобы начать наведение."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt %lld Beiträge. Tippen Sie auf einen, um die Zielführung zu starten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld の投稿があります。いずれかをタップすると照準誘導が始まります。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Bağlantı kurulamadı. Biraz sonra tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı kurulamadı. Biraz sonra tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect. Try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接。稍后再试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्ट नहीं हो सका. शीघ्र ही पुनः प्रयास करें."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar. Vuelve a intentarlo en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de se connecter. Réessayez sous peu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الاتصال. حاول مرة أخرى قريبا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংযোগ করা যায়নি। শীঘ্রই আবার চেষ্টা করুন."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conectar. Tente novamente em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться. Повторите попытку через некоторое время."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte keine Verbindung hergestellt werden. Versuchen Sie es in Kürze noch einmal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できませんでした。しばらくしてからもう一度お試しください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Dikey yüzeyde AR görünümü açılamadı. Tekrar dene.": {

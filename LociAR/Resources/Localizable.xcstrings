    "Yerel yüzey kaydı boş veya 50 MB sınırını aşıyor.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel yüzey kaydı boş veya 50 MB sınırını aşıyor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local surface record is empty or exceeds the 50 MB limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地表面记录为空或超过 50 MB 限制。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय सतह रिकॉर्ड खाली है या 50 एमबी की सीमा से अधिक है।"
          }
        },
        "es": {
          "stringUnit": {

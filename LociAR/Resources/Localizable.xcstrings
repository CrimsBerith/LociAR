    "Yerel yüzey kaydı boş veya 50 MB sınırını aşıyor." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السجل السطحي المحلي فارغ أو يتجاوز الحد الأقصى وهو 50 ميجابايت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্থানীয় পৃষ্ঠের রেকর্ড খালি বা 50 MB সীমা ছাড়িয়ে গেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der lokale Oberflächendatensatz ist leer oder überschreitet die 50-MB-Grenze."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local surface record is empty or exceeds the 50 MB limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de superficie local está vacío o supera el límite de 50 MB."

    "İçerikler şu anda yüklenemiyor. Biraz sonra tekrar dene." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçerikler şu anda yüklenemiyor. Biraz sonra tekrar dene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content can’t be loaded right now. Try again in a little while."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhalte können gerade nicht geladen werden. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido no se puede cargar ahora. Inténtalo de nuevo en un rato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les contenus ne peuvent pas être chargés pour le moment. Réessayez dans un moment."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível carregar o conteúdo agora. Tente novamente daqui a pouco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас не удаётся загрузить контент. Попробуйте чуть позже."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تحميل المحتوى الآن. حاول مرة أخرى بعد قليل."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामग्री अभी लोड नहीं हो पा रही। थोड़ी देर बाद फिर कोशिश करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কনটেন্ট এখন লোড করা যাচ্ছে না। একটু পরে আবার চেষ্টা করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在コンテンツを読み込めません。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法加载内容。请稍后重试。"
          }
        }
      }
    },
    "İçeriği aç, Paylaş menüsünden bağlantıyı kopyala ve bu ekrana dön. Tamam bağlantıyı doğrulayıp karta ekler." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçeriği aç, Paylaş menüsünden bağlantıyı kopyala ve bu ekrana dön. Tamam bağlantıyı doğrulayıp karta ekler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the content, copy the link from the Share menu and come back to this screen. OK verifies the link and adds it to the card."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne den Inhalt, kopiere den Link über das Teilen-Menü und kehre zu diesem Bildschirm zurück. OK prüft den Link und fügt ihn der Karte hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el contenido, copia el enlace desde el menú Compartir y vuelve a esta pantalla. Aceptar verifica el enlace y lo añade a la tarjeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez le contenu, copiez le lien depuis le menu Partager et revenez sur cet écran. OK vérifie le lien et l’ajoute à la carte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o conteúdo, copie o link no menu Compartilhar e volte para esta tela. O OK verifica o link e o adiciona ao cartão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте контент, скопируйте ссылку в меню «Поделиться» и вернитесь на этот экран. «ОК» проверит ссылку и добавит её в карточку."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح المحتوى وانسخ الرابط من قائمة المشاركة ثم عد إلى هذه الشاشة. يتحقق «حسنًا» من الرابط ويضيفه إلى البطاقة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामग्री खोलें, शेयर मेनू से लिंक कॉपी करें और इस स्क्रीन पर लौटें। ठीक है लिंक की जाँच करके उसे कार्ड में जोड़ता है।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কনটেন্টটি খুলুন, শেয়ার মেনু থেকে লিংক কপি করুন এবং এই স্ক্রিনে ফিরে আসুন। ‘ঠিক আছে’ লিংকটি যাচাই করে কার্ডে যোগ করে।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテンツを開き、共有メニューからリンクをコピーしてこの画面に戻ってください。OKでリンクを確認してカードに追加します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开内容，从“分享”菜单复制链接，然后回到此屏幕。轻点“好”即可验证链接并将其添加到卡片。"
          }
        }
      }
    },

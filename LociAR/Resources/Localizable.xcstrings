    "Merkez halkayı masa, zemin veya duvar üzerinde gezdir." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkez halkayı masa, zemin veya duvar üzerinde gezdir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move the center ring over a table, floor or wall."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege den Mittelring über einen Tisch, Boden oder eine Wand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve el anillo central sobre una mesa, el suelo o una pared."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez l’anneau central sur une table, le sol ou un mur."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mova o anel central sobre uma mesa, o piso ou uma parede."

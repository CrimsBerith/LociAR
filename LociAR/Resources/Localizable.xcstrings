    "Şehrin unutulan hikâyelerini yüzeylere bırakıyorum." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أترك قصص المدينة المنسية على أسطحها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমি শহরের ভুলে যাওয়া গল্পগুলো তার পৃষ্ঠে রেখে যাই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich hinterlasse die vergessenen Geschichten der Stadt auf ihren Flächen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I leave the city’s forgotten stories on its surfaces."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejo las historias olvidadas de la ciudad en sus superficies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je laisse les histoires oubliées de la ville sur ses surfaces."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं शहर की भूली-बिसरी कहानियाँ उसकी सतहों पर छोड़ता/छोड़ती हूँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "街の忘れられた物語を、その面に残しています。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixo as histórias esquecidas da cidade nas suas superfícies."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я оставляю забытые истории города на его поверхностях."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şehrin unutulan hikâyelerini yüzeylere bırakıyorum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我把城市中被遗忘的故事留在它的表面上。"
          }
        }
      }
    },

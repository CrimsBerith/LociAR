    "Bu kullanıcının postlarını ve yorumlarını görmezsin; seni takip edemez, postlarına yorum yapamaz." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kullanıcının postlarını ve yorumlarını görmezsin; seni takip edemez, postlarına yorum yapamaz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You won’t see this user’s posts or comments; they can’t follow you or comment on your posts."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du siehst keine Posts und Kommentare dieses Nutzers; er kann dir nicht folgen und deine Posts nicht kommentieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No verás las publicaciones ni los comentarios de este usuario; no podrá seguirte ni comentar tus publicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne verrez plus les publications ni les commentaires de cet utilisateur ; il ne pourra ni vous suivre ni commenter vos publications."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não verá as publicações nem os comentários deste usuário; ele não poderá seguir você nem comentar suas publicações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не увидите посты и комментарии этого пользователя; он не сможет подписаться на вас и комментировать ваши посты."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن ترى منشورات هذا المستخدم أو تعليقاته؛ ولن يتمكن من متابعتك أو التعليق على منشوراتك."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको इस उपयोगकर्ता की पोस्ट और टिप्पणियाँ नहीं दिखेंगी; वे आपको फ़ॉलो नहीं कर पाएँगे और आपकी पोस्ट पर टिप्पणी नहीं कर पाएँगे।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি এই ব্যবহারকারীর পোস্ট ও মন্তব্য দেখবেন না; তিনি আপনাকে অনুসরণ বা আপনার পোস্টে মন্তব্য করতে পারবেন না।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このユーザーの投稿やコメントは表示されなくなり、相手はあなたをフォローしたり投稿にコメントしたりできなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

    "Postlarınız ve sosyal verileriniz sunucudan silinir. Bu işlem geri alınamaz.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postlarınız ve sosyal verileriniz sunucudan silinir. Bu işlem geri alınamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your posts and social data will be deleted from the server. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的帖子和社交数据将从服务器删除。此操作无法撤销。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पोस्ट और सामाजिक डेटा सर्वर से मिटा दिए जाएँगे। यह कार्रवाई वापस नहीं ली जा सकती।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus publicaciones y datos sociales se eliminarán del servidor. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos publications et données sociales seront supprimées du serveur. Cette action est irréversible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف منشوراتك وبياناتك الاجتماعية من الخادم. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পোস্ট ও সামাজিক তথ্য সার্ভার থেকে মুছে যাবে। এই কাজ পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas publicações e dados sociais serão excluídos do servidor. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши публикации и социальные данные будут удалены с сервера. Это действие нельзя отменить."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Beiträge und sozialen Daten werden vom Server gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿とソーシャルデータがサーバーから削除されます。この操作は取り消せません。"
          }
        }
      }
    },
    "Hesabı silmeden önce kimliğini doğrula.": {

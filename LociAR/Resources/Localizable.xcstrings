        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই মুহূর্তে নোট মুছে ফেলা যাবে না. আপনার সংযোগ পরীক্ষা করুন এবং আবার চেষ্টা করুন."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現時点ではノートを削除できません。接続を確認して、もう一度試してください。"

    "Yüzey bulundu ancak içerik çizilemedi. Tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzey bulundu ancak içerik gösterilemedi. Tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The surface was found, but the content could not be displayed. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到表面，但无法显示内容。请重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सतह मिल गई, लेकिन सामग्री नहीं दिखाई जा सकी। फिर से प्रयास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró la superficie, pero no se pudo mostrar el contenido. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La surface a été trouvée, mais le contenu n’a pas pu être affiché. Réessayez."
          }

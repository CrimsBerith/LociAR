        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to log in. Check your email and password."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录失败。请检查您的电子邮件和密码。"

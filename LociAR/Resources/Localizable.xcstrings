    "Bu noktada kararlı yüzey bulunamadı. Merkez halkayı yüzey üzerinde gezdirin veya yaklaşık yerleştirmeyi seçin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu noktada kararlı yüzey bulunamadı. Merkez halkayı yüzey üzerinde gezdirin veya yaklaşık yerleştirmeyi seçin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No stable surface found here. Move the center ring over a surface or choose approximate placement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An dieser Stelle wurde keine stabile Fläche gefunden. Bewege den Mittelring über eine Fläche oder wähle die ungefähre Platzierung."

    "Giriş bağlantısı tamamlanamadı. Bağlantını kontrol edip tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş bağlantısı tamamlanamadı. Bağlantını kontrol edip tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not complete the sign-in link. Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成登录链接操作。请检查连接后重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन-इन लिंक पूरा नहीं किया जा सका। कनेक्शन जाँचें और फिर से प्रयास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar el enlace de inicio de sesión. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de finaliser le lien de connexion. Vérifiez votre connexion et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إكمال رابط تسجيل الدخول. تحقق من اتصالك وحاول مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইন-ইন লিঙ্ক সম্পন্ন করা যায়নি। সংযোগ পরীক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir o link de login. Verifique sua conexão e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить вход по ссылке. Проверьте соединение и повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anmeldelink konnte nicht abgeschlossen werden. Verbindung prüfen und erneut versuchen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインリンクの処理を完了できませんでした。接続を確認して再試行してください。"
          }
        }
      }
    },
    "Profil güncellenemedi. Bağlantını kontrol edip tekrar dene.": {

    "Yüzey kaydı henüz hazır değil. Çevreyi yavaşça tarayın.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzey kaydı henüz hazır değil. Çevreyi yavaşça tarayın."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The surface map is not ready yet. Slowly scan the surroundings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表面地图尚未准备好。慢慢扫视周围。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सतही नक्शा अभी तैयार नहीं है. धीरे-धीरे आस-पास का निरीक्षण करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mapa de superficie aún no está listo. Escanee lentamente los alrededores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte de surface n'est pas encore prête. Scannez lentement les environs."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخريطة السطحية ليست جاهزة بعد. قم بمسح المناطق المحيطة ببطء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পৃষ্ঠ মানচিত্র এখনও প্রস্তুত নয়. ধীরে ধীরে চারপাশ স্ক্যান করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapa de superfície ainda não está pronto. Examine lentamente os arredores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта поверхности еще не готова. Медленно сканируйте окрестности."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Oberflächenkarte ist noch nicht fertig. Scannen Sie langsam die Umgebung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地表マップはまだ準備ができていません。周囲をゆっくりと観察します。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

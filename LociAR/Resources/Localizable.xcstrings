        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইমেল পাঠানো যায়নি. অনুগ্রহ করে কিছুক্ষণের মধ্যে আবার চেষ্টা করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",

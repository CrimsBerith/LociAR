    "Kartı açmak için kamerayı dokulu bir duvar, masa veya zemin üzerinde yavaşça gezdir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartı açmak için kamerayı dokulu bir duvar, masa veya zemin üzerinde yavaşça gezdir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the camera slowly across a textured wall, table, or floor to open the card."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将相机对准有纹理的墙壁、桌面或地面并缓慢移动，以打开卡片。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड खोलने के लिए कैमरे को बनावट वाली दीवार, टेबल या फर्श पर धीरे-धीरे ले जाएं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve la cámara lentamente sobre una pared, mesa o suelo con textura para abrir la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez lentement la caméra sur un mur, une table ou un sol texturé pour ouvrir la carte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرك الكاميرا ببطء عبر جدار أو طاولة أو أرضية مزخرفة لفتح البطاقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্ড খুলতে একটি টেক্সচার্ড দেয়াল, টেবিল বা মেঝে জুড়ে ধীরে ধীরে ক্যামেরা সরান।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova a câmera lentamente sobre uma parede, mesa ou chão texturizado para abrir o cartão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно перемещайте камеру вдоль стены, стола или пола с выраженной текстурой, чтобы открыть карточку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegen Sie die Kamera langsam über eine strukturierte Wand, einen Tisch oder einen Boden, um die Karte zu öffnen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テクスチャのある壁、テーブル、床の上でカメラをゆっくりと移動して、カードを開きます。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয় পৃষ্ঠের রেকর্ড খালি বা 50 MB সীমা ছাড়িয়ে গেছে।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro de superfície local está vazio ou excede o limite de 50 MB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная поверхностная запись пуста или превышает ограничение в 50 МБ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Oberflächendatensatz ist leer oder überschreitet die 50-MB-Grenze."

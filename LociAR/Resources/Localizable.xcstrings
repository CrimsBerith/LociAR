        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी नोट और सामाजिक डेटा सर्वर से मिटा दिए जाएँगे। यह कार्रवाई वापस नहीं ली जा सकती।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノートとソーシャルデータがサーバーから削除されます。この操作は取り消せません。"

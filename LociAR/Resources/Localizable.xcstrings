    "Postlar yalnızca metin ve sosyal medya bağlantısı içerebilir; fotoğraf ve video desteklenmiyor." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postlar yalnızca metin ve sosyal medya bağlantısı içerebilir; fotoğraf ve video desteklenmiyor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posts can contain only text and a social media link; photos and videos aren’t supported."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posts dürfen nur Text und einen Social-Media-Link enthalten; Fotos und Videos werden nicht unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las publicaciones solo pueden incluir texto y un enlace de redes sociales; no se admiten fotos ni vídeos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les publications ne peuvent contenir que du texte et un lien de réseau social ; les photos et vidéos ne sont pas prises en charge."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As publicações só podem conter texto e um link de rede social; fotos e vídeos não são compatíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посты могут содержать только текст и ссылку на соцсеть; фото и видео не поддерживаются."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن تحتوي المنشورات على نص ورابط تواصل اجتماعي فقط؛ الصور ومقاطع الفيديو غير مدعومة."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट में केवल टेक्स्ट और एक सोशल मीडिया लिंक हो सकता है; फ़ोटो और वीडियो समर्थित नहीं हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পোস্টে শুধু টেক্সট ও একটি সোশ্যাল মিডিয়া লিংক থাকতে পারে; ছবি ও ভিডিও সমর্থিত নয়।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿に含められるのはテキストとソーシャルメディアのリンクのみです。写真と動画はサポートされていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帖子只能包含文字和一个社交媒体链接；不支持照片和视频。"
          }
        }
      }
    },

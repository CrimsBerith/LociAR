    "Çok sık fotoğraf yükledin. Bir saat sonra tekrar dene.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok sık fotoğraf yükledin. Bir saat sonra tekrar dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You upload photos too often. Try again in an hour."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您上传照片过于频繁。一小时后重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने बहुत बार फ़ोटो अपलोड की हैं। एक घंटे बाद फिर से प्रयास करें।"
          }
        },
        "es": {

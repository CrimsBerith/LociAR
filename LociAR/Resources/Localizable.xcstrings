        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённая среда не найдена. Показываем направление к её примерному местоположению."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Umgebung nicht gefunden. Führt Sie zu seinem ungefähren Standort."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された環境が見つかりません。おおよその位置をご案内します。"
          }
        }

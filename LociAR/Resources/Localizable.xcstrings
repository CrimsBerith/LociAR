    "Konumuna göre kampanya ve teklif bildirimleri al. Bu tercih isteğe bağlıdır." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصل على إشعارات الحملات والعروض حسب موقعك. هذا الخيار اختياري."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অবস্থান অনুযায়ী প্রচার ও অফারের বিজ্ঞপ্তি পান। এটি ঐচ্ছিক।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte standortbezogene Mitteilungen zu Aktionen und Angeboten. Dies ist freiwillig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get campaign and offer notifications based on your location. This is optional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe notificaciones de campañas y ofertas según tu ubicación. Es opcional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez des notifications de campagnes et d’offres selon votre position. Ce choix est facultatif."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी लोकेशन के आधार पर अभियान और ऑफ़र की सूचनाएँ पाएँ। यह वैकल्पिक है।"

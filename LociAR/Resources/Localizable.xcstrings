        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कैन साफ़ हो रहा है; फ़ोन को धीरे-धीरे हिलाएँ।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্যান স্পষ্ট হচ্ছে; ফোনটি ধীরে সরান।"

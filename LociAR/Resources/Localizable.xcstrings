    "Bildirimler 24 saat içinde incelenir. İçeriği görmek istemiyorsan kullanıcıyı engelleyebilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimler 24 saat içinde incelenir. İçeriği görmek istemiyorsan kullanıcıyı engelleyebilirsin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports are reviewed within 24 hours. If you don’t want to see this content, you can block the user."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldungen werden innerhalb von 24 Stunden geprüft. Wenn du den Inhalt nicht sehen möchtest, kannst du den Nutzer blockieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las denuncias se revisan en un plazo de 24 horas. Si no quieres ver el contenido, puedes bloquear al usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signalements sont examinés sous 24 heures. Si vous ne voulez pas voir ce contenu, vous pouvez bloquer l’utilisateur."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As denúncias são analisadas em até 24 horas. Se não quiser ver o conteúdo, você pode bloquear o usuário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жалобы проверяются в течение 24 часов. Если не хотите видеть этот контент, заблокируйте пользователя."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم مراجعة البلاغات خلال 24 ساعة. إذا كنت لا تريد رؤية المحتوى، يمكنك حظر المستخدم."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिपोर्ट की समीक्षा 24 घंटे के भीतर होती है। अगर आप यह सामग्री नहीं देखना चाहते, तो उपयोगकर्ता को ब्लॉक कर सकते हैं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রিপোর্ট ২৪ ঘণ্টার মধ্যে পর্যালোচনা করা হয়। কনটেন্ট দেখতে না চাইলে ব্যবহারকারীকে ব্লক করতে পারেন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "報告は24時間以内に審査されます。コンテンツを見たくない場合は、ユーザーをブロックできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "举报会在 24 小时内审核。如果你不想看到该内容，可以屏蔽该用户。"
          }
        }
      }
    },

    "Konum alınamadı. Açık bir alanda kısa süre bekleyip tekrar deneyin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum alınamadı. Açık bir alanda kısa süre bekleyip tekrar deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location could not be obtained. Wait a short time in an open area and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取位置。在空旷区域等待片刻，然后重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान प्राप्त नहीं हो सका. किसी खुले क्षेत्र में थोड़ी देर प्रतीक्षा करें और पुनः प्रयास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener la ubicación. Espere un momento en un área abierta y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement n'a pas pu être obtenu. Attendez quelques instants dans un espace ouvert et réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الحصول على الموقع. انتظر لفترة قصيرة في منطقة مفتوحة وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান পাওয়া যায়নি. খোলা জায়গায় কিছুক্ষণ অপেক্ষা করুন এবং আবার চেষ্টা করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter a localização. Aguarde um pouco em uma área aberta e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить местоположение. Подождите немного на открытом месте и повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort konnte nicht ermittelt werden. Warten Sie kurz an einem offenen Ort und versuchen Sie es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報を取得できませんでした。開けた場所でしばらく待ってから、もう一度試してください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

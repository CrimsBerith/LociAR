    "Cihaz test modu açık. Sunucu işlemleri bağlantı yeniden kurulana kadar yerel tutulur.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz test modu açık. Sunucu işlemleri bağlantı yeniden kurulana kadar yerel tutulur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device test mode is on. Server processes are kept local until the connection is reestablished."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备测试模式已开启。服务器进程保持本地状态，直到重新建立连接。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस परीक्षण मोड चालू है. कनेक्शन पुनः स्थापित होने तक सर्वर प्रक्रियाओं को स्थानीय रखा जाता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de prueba del dispositivo está activado. Los procesos del servidor se mantienen locales hasta que se restablece la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode test de l'appareil est activé. Les processus du serveur restent locaux jusqu'à ce que la connexion soit rétablie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وضع اختبار الجهاز قيد التشغيل. يتم الاحتفاظ بعمليات الخادم محليًا حتى تتم إعادة تأسيس الاتصال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইস পরীক্ষা মোড চালু আছে। সংযোগ পুনঃস্থাপিত না হওয়া পর্যন্ত সার্ভার প্রক্রিয়া স্থানীয় রাখা হয়."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de teste do dispositivo está ativado. Os processos do servidor são mantidos locais até que a conexão seja restabelecida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим тестирования устройства включен. Серверные процессы остаются локальными до тех пор, пока соединение не будет восстановлено."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gerätetestmodus ist aktiviert. Serverprozesse bleiben lokal, bis die Verbindung wiederhergestellt ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイステストモードがオンになっています。サーバー プロセスは、接続が再確立されるまでローカルに保持されます。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },
    "Cihazı daha yavaş hareket ettirin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {

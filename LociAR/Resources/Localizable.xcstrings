            "value" : "लंबित पोस्ट इस डिवाइस पर सुरक्षित है. आप पुनः प्रकाशन का प्रयास कर सकते हैं."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুলতুবি পোস্ট এই ডিভাইসে নিরাপদ. আপনি আবার প্রকাশ করার চেষ্টা করতে পারেন."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留中の投稿はこのデバイスでは安全です。もう一度公開してみることができます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待处理的帖子在此设备上是安全的。您可以尝试再次发布。"
          }
        }
      }
    },

    "Kamera pozu alınamadı. Tekrar deneyin.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameranın konumu ve yönü belirlenemedi. Tekrar deneyin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not determine the camera position and orientation. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定相机的位置和朝向。请重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे की स्थिति और दिशा निर्धारित नहीं की जा सकी। फिर से प्रयास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron determinar la posición y la orientación de la cámara. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déterminer la position et l’orientation de la caméra. Réessayez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحديد موضع الكاميرا واتجاهها. حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরার অবস্থান ও দিক নির্ধারণ করা যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível determinar a posição e a orientação da câmera. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить положение и ориентацию камеры. Попробуйте ещё раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Position und Ausrichtung der Kamera konnten nicht ermittelt werden. Versuchen Sie es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの位置と向きを取得できませんでした。もう一度お試しください。"
          }
        }
      },
      "comment": "Translated and editorially checked against the English UI meaning, 2026-10-04. Verify compiled resources, VoiceOver, wrapping and RTL in native QA."
    },

    "Postların beğenildiğinde, yorum aldığında ve biri seni takip ettiğinde bildirim gönderilir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postların beğenildiğinde, yorum aldığında ve biri seni takip ettiğinde bildirim gönderilir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You receive notifications when someone likes or comments on your posts or follows you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人赞你的帖子、发表评论或关注你时，你会收到通知。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई आपकी पोस्ट पसंद करता है, टिप्पणी करता है या आपको फ़ॉलो करता है, तो आपको सूचना मिलती है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibes notificaciones cuando alguien da me gusta o comenta tus publicaciones, o te sigue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevez une notification lorsqu’une personne aime ou commente vos publications, ou vous suit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصلك إشعارات عندما يعجب شخص بمنشوراتك أو يعلق عليها أو يتابعك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেউ আপনার পোস্টে লাইক বা মন্তব্য করলে অথবা আপনাকে অনুসরণ করলে বিজ্ঞপ্তি পাবেন।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você recebe notificações quando alguém curte ou comenta suas publicações ou segue você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получаете уведомления, когда кто-то ставит отметку «Нравится», комментирует ваши публикации или подписывается на вас."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erhältst Mitteilungen, wenn jemand deine Beiträge mit „Gefällt mir“ markiert, kommentiert oder dir folgt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿にいいねやコメントが付いたとき、またはフォローされたときに通知を受け取ります。"
          }
        }
      }
    },

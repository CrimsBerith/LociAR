    "Tarama henüz hazır değil. Çevreyi taramaya devam edin veya yaklaşık yerleştirin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarama henüz hazır değil. Çevreyi taramaya devam edin veya yaklaşık yerleştirin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scan isn’t ready yet. Keep scanning the surroundings or place approximately."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Scan ist noch nicht bereit. Scanne die Umgebung weiter oder platziere ungefähr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El escaneo aún no está listo. Sigue escaneando el entorno o coloca de forma aproximada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scan n’est pas encore prêt. Continuez à scanner les environs ou placez de façon approximative."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escaneamento ainda não está pronto. Continue escaneando o ambiente ou posicione de forma aproximada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканирование ещё не готово. Продолжайте сканировать окружение или разместите приблизительно."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المسح غير جاهز بعد. واصل مسح المكان أو ضع المحتوى تقريبيًا."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कैन अभी तैयार नहीं है। आस-पास स्कैन करते रहें या अनुमानित रूप से रखें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্যান এখনো প্রস্তুত নয়। চারপাশ স্ক্যান করতে থাকুন বা আনুমানিকভাবে স্থাপন করুন।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンの準備がまだできていません。周囲のスキャンを続けるか、おおよそで配置してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描尚未就绪。请继续扫描周围环境，或以大致位置放置。"
          }
        }
      }
    },
    "Tarama netleşiyor; telefonu yavaş hareket ettirin." : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarama netleşiyor; telefonu yavaş hareket ettirin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scan is sharpening; move the phone slowly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Scan wird schärfer; bewege das Telefon langsam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El escaneo se está afinando; mueve el teléfono despacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scan s’affine ; déplacez le téléphone lentement."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escaneamento está ficando nítido; mova o telefone devagar."

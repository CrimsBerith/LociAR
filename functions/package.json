{
  "name": "lociar-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-lociar \"node --test test/rules/*.test.mjs\"",
    "test:emulator": "npm run build && firebase emulators:exec --only auth,firestore,storage,functions --project demo-lociar \"node --test test/integration/*.test.mjs\""
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.7",
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0",
    "google-auth-library": "^10.9.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.10.0",
    "firebase": "^12.3.0",
    "firebase-tools": "^15.31.0",
    "typescript": "^5.9.2"
  }
}

// Firebase client identifiers (Firebase console → Project settings → Your apps → iOS).
// Real values go in Config/Local.xcconfig, which is git-ignored.
LOCIAR_FIREBASE_API_KEY =
LOCIAR_FIREBASE_GOOGLE_APP_ID =
LOCIAR_FIREBASE_GCM_SENDER_ID =
LOCIAR_FIREBASE_PROJECT_ID =
LOCIAR_FIREBASE_STORAGE_BUCKET =
LOCIAR_FIREBASE_FUNCTIONS_REGION = us-central1
LOCIAR_EMULATOR_HOST =
// App Check debug token for this machine's Debug builds. Set it in Config/Local.xcconfig; it is a
// credential and must not be committed. Only Debug builds carry it into Info.plist.
LOCIAR_APPCHECK_DEBUG_TOKEN =
LOCIAR_APPCHECK_DEBUG_TOKEN_DEBUG_ONLY =
LOCIAR_APPCHECK_DEBUG_TOKEN_DEBUG_ONLY[config=Debug] = $(LOCIAR_APPCHECK_DEBUG_TOKEN)
LOCIAR_PRIVACY_URL = https:/$()/locidrop.com/privacy
LOCIAR_TERMS_URL = https:/$()/locidrop.com/terms
LOCIAR_SUPPORT_URL = https:/$()/locidrop.com/support

// Machine-local credentials. This file is intentionally excluded from source control.
#include? "Local.xcconfig"

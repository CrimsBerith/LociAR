// Copy to Config/Local.xcconfig (git-ignored) and fill with the values from
// Firebase console → Project settings → General → Your apps → iOS app (com.khankartal.lociar).
// They match the keys inside GoogleService-Info.plist:
//   API_KEY → LOCIAR_FIREBASE_API_KEY, GOOGLE_APP_ID → LOCIAR_FIREBASE_GOOGLE_APP_ID,
//   GCM_SENDER_ID → LOCIAR_FIREBASE_GCM_SENDER_ID, PROJECT_ID → LOCIAR_FIREBASE_PROJECT_ID,
//   STORAGE_BUCKET → LOCIAR_FIREBASE_STORAGE_BUCKET
LOCIAR_FIREBASE_API_KEY = AIzaYOUR-API-KEY
LOCIAR_FIREBASE_GOOGLE_APP_ID = 1:000000000000:ios:YOUR-APP-ID
LOCIAR_FIREBASE_GCM_SENDER_ID = 000000000000
LOCIAR_FIREBASE_PROJECT_ID = YOUR-PROJECT-ID
LOCIAR_FIREBASE_STORAGE_BUCKET = YOUR-PROJECT-ID.firebasestorage.app
// Must match the region the Cloud Functions are deployed to (functions/src/core.ts).
LOCIAR_FIREBASE_FUNCTIONS_REGION = us-central1

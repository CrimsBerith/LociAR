{
  "name": "lociar-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:emulator": "../functions/node_modules/.bin/firebase emulators:exec --config ../firebase.json --only auth,firestore,storage --project demo-lociar \"node --conditions=react-server --import ./tests/register-typescript.mjs --test --test-concurrency=1 tests/integration/*.test.mjs\"",
    "build:ci": "node scripts/build-ci.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.7",
    "firebase": "^12.3.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tldts": "7.4.22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    },
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "google-gax": {
      "uuid": "^11.1.1"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    },
    "glob": "^14.0.3",
    "minimatch": "^11.0.3",
    "re2js": "^2.9.1"
  }
}

# Browser (public client identifiers from Firebase console → Project settings → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=AIza-your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:your-app-id

# Server-only. Never prefix these with NEXT_PUBLIC_.
# Service account JSON (Project settings → Service accounts → Generate new private key),
# either raw JSON on one line or base64-encoded.
FIREBASE_SERVICE_ACCOUNT_JSON=base64-or-json
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_FUNCTIONS_REGION=us-central1

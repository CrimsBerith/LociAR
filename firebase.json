{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".*", "*.local", ".env*", ".secret*", "*.log", "*.tsbuildinfo", "*.credentials.json", "*.pem", "*.key", "*.p8", "*.p12", "src", "test", "scripts", "tsconfig.json"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "apphosting": [
    {
      "backendId": "lociar-admin",
      "rootDir": "admin",
      "ignore": ["node_modules", ".git", ".next", "artifacts", "e2e", "tests", "*.local", ".env*"],
      "alwaysDeployFromSource": true
    }
  ],
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "storage": { "host": "127.0.0.1", "port": 9199 },
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}

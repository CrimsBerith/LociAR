rules_version = '2';

// LociAR Firestore rules — server-authoritative design.
// Posts, profiles (creation), counters, activity, analytics and admin data are written only by
// Cloud Functions / Admin SDK (which bypass these rules). Clients write only their own social
// edges, comments and collections, always bound to the `luid` custom claim that the
// `ensureProfile` callable sets.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.luid is string; }
    function me() { return request.auth.token.luid; }
    // Guests (Firebase anonymous auth) may browse, like, save, follow, block and report. Writing
    // comments needs a verified Apple or email identity (App Store 1.2; owner decision 17 Oct
    // 2026). Mirrors identityVerified() in functions/src/core.ts.
    function verifiedIdentity() {
      let firebase = request.auth.token.get('firebase', {});
      return request.auth.token.get('email_verified', false) == true
        || firebase.get('sign_in_provider', '') == 'apple.com'
        || 'apple.com' in firebase.get('identities', {});
    }
    // The persistent server-only fence survives profile/Auth removal and rejects stale tokens.
    function activeAccount(luid) {
      let profile = get(/databases/$(database)/documents/profiles/$(luid)).data;
      return profile != null && profile.get('deleted_at', null) == null
        && !exists(/databases/$(database)/documents/account_deletion_jobs/$(luid));
    }
    function mayWrite() { return signedIn() && activeAccount(me()); }
    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys) && request.resource.data.keys().hasAll(keys); }
    function createdNow() { return request.resource.data.created_at == request.time; }
    function postExists(postId) { return post(postId) != null; }
    function post(postId) { return get(/databases/$(database)/documents/posts/$(postId)).data; }
    function postIsPublicActive(postId) {
      return post(postId).status == 'active' && post(postId).visibility == 'public'
        && post(postId).get('age_rating', 'all') != '18_plus' && post(postId).get('deleted_at', null) == null
        && activeAccount(post(postId).creator_id);
    }
    // Suspended accounts keep read access and can still file reports, but cannot interact.
    function notSuspended() {
      return get(/databases/$(database)/documents/profiles/$(me())).data.get('suspended', false) != true;
    }
    // An identity block between the caller and `owner`, in either direction (profile "Block").
    // Anonymous mutes (anonymous_blocks) are server-only and never change what rules allow: a
    // denied write would otherwise reveal who wrote an anonymous note (functions/src/visibility.ts).
    function blockedBy(owner) {
      return exists(/databases/$(database)/documents/user_blocks/$(owner + '_' + me()))
        || exists(/databases/$(database)/documents/user_blocks/$(me() + '_' + owner));
    }
    // Identity blocks fence attributed posts only. An anonymous post behaves the same for every
    // viewer, so a failed like or comment cannot identify its author.
    function blockedOnPost(postId) {
      return post(postId).get('is_anonymous', false) != true && blockedBy(post(postId).creator_id);
    }
    function collectionDescriptionOk(data) {
      return !('description' in data) || data.description == null
        || (data.description is string && data.description.size() <= 500);
    }
    function avatarPreset(value) {
      return value == null || value in ['hare', 'tortoise', 'cat', 'dog', 'bear', 'bird', 'fish', 'leaf', 'star', 'moon', 'sun', 'bolt'];
    }

    match /profiles/{luid} {
      // Signed-in (guest or account) reads only: no anonymous bulk scraping of every profile.
      allow read: if signedIn();
      allow create, delete: if false;
      // Handles change only through the updateHandle callable (uniqueness); photo avatars are set
      // only by the moderation function. The owner may pick a preset or remove the photo.
      allow update: if mayWrite() && me() == luid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['avatar_url', 'avatar_preset', 'bio', 'display_name', 'updated_at'])
        && request.resource.data.updated_at == request.time
        && (!('avatar_url' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.avatar_url == null)
        && (!('avatar_preset' in request.resource.data) || avatarPreset(request.resource.data.avatar_preset))
        // Length limits apply only to fields this update changes, so an older over-long value
        // never locks the owner out of editing something else.
        && (!('bio' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.bio == null
            || (request.resource.data.bio is string && request.resource.data.bio.size() <= 300))
        && (!('display_name' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.display_name == null
            || (request.resource.data.display_name is string && request.resource.data.display_name.size() <= 60))
;
    }

    match /users_private/{luid} {
      allow read: if signedIn() && me() == luid;
      allow write: if false;
    }

    match /posts/{postId} {
      allow get: if (resource.data.get('is_anonymous', false) != true
          && resource.data.status == 'active' && resource.data.visibility == 'public'
          && resource.data.get('age_rating', 'all') != '18_plus' && resource.data.get('deleted_at', null) == null
          && activeAccount(resource.data.creator_id) && (!signedIn() || !blockedBy(resource.data.creator_id)))
        || (signedIn() && resource.data.creator_id == me() && activeAccount(me()));
      // Public feeds use readPublicContent so account fences and bidirectional blocks do not
      // exceed Firestore's per-query document access budget or omit qualifying later pages.
      allow list: if signedIn() && resource.data.creator_id == me() && activeAccount(me());
      allow write: if false;
    }

    match /likes/{likeId} {
      allow get: if signedIn() && (resource == null || resource.data.user_id == me());
      allow list: if signedIn() && resource.data.user_id == me();
      allow create: if mayWrite()
        && likeId == request.resource.data.post_id + '_' + me()
        && onlyKeys(['post_id', 'user_id', 'created_at'])
        && request.resource.data.user_id == me()
        && createdNow()
        && postIsPublicActive(request.resource.data.post_id)
        && !blockedOnPost(request.resource.data.post_id)
        && notSuspended();
      allow update: if false;
      allow delete: if mayWrite() && (resource == null || resource.data.user_id == me());
    }

    match /post_saves/{saveId} {
      allow get: if signedIn() && (resource == null || resource.data.user_id == me());
      allow list: if signedIn() && resource.data.user_id == me();
      allow create: if mayWrite()
        && saveId == me() + '_' + request.resource.data.post_id
        && onlyKeys(['post_id', 'user_id', 'created_at'])
        && request.resource.data.user_id == me()
        && createdNow()
        && postIsPublicActive(request.resource.data.post_id)
        && !blockedOnPost(request.resource.data.post_id)
        && notSuspended();
      allow update: if false;
      allow delete: if mayWrite() && (resource == null || resource.data.user_id == me());
    }

    match /follows/{followId} {
      // Only edges that involve the caller; counts come from server-maintained profile fields.
      allow get: if signedIn() && (resource == null || resource.data.follower_id == me() || resource.data.following_id == me());
      allow list: if signedIn() && (resource.data.follower_id == me() || resource.data.following_id == me());
      allow create: if mayWrite()
        && onlyKeys(['follower_id', 'following_id', 'created_at'])
        && request.resource.data.follower_id == me()
        && request.resource.data.following_id is string
        && request.resource.data.following_id != me()
        && activeAccount(request.resource.data.following_id)
        && followId == me() + '_' + request.resource.data.following_id
        && createdNow()
        && !blockedBy(request.resource.data.following_id)
        && notSuspended();
      allow update: if false;
      allow delete: if mayWrite() && (resource == null || resource.data.follower_id == me());
    }

    match /user_blocks/{blockId} {
      allow get: if signedIn() && (resource == null || resource.data.blocker_id == me());
      allow list: if signedIn() && resource.data.blocker_id == me();
      allow create: if mayWrite()
        && onlyKeys(['blocker_id', 'blocked_id', 'created_at'])
        && request.resource.data.blocker_id == me()
        && request.resource.data.blocked_id is string
        && request.resource.data.blocked_id != me()
        && activeAccount(request.resource.data.blocked_id)
        && blockId == me() + '_' + request.resource.data.blocked_id
        && createdNow();
      allow update: if false;
      allow delete: if mayWrite() && (resource == null || resource.data.blocker_id == me());
    }

    match /comments/{commentId} {
      // Only comments of public, active posts are readable, and only while signed in.
      allow read: if signedIn()
        && postIsPublicActive(resource.data.post_id)
        && !blockedOnPost(resource.data.post_id);
      // `username` is not accepted from clients: onCommentCreated fills it from the profile.
      allow create: if mayWrite()
        && onlyKeys(['id', 'post_id', 'user_id', 'text', 'created_at'])
        && request.resource.data.id == commentId
        && request.resource.data.user_id == me()
        && request.resource.data.post_id is string
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && verifiedIdentity()
        && createdNow()
        && postIsPublicActive(request.resource.data.post_id)
        && !blockedOnPost(request.resource.data.post_id)
        && notSuspended();
      allow update: if false;
      // The author, or the owner of the post it was left on, may remove a comment.
      allow delete: if mayWrite()
        && (resource.data.user_id == me() || post(resource.data.post_id).creator_id == me());
    }

    match /collections/{collectionId} {
      allow read: if signedIn() && resource.data.owner_id == me();
      allow create: if mayWrite()
        && request.resource.data.keys().hasOnly(['id', 'owner_id', 'title', 'description', 'visibility', 'created_at', 'updated_at'])
        && request.resource.data.id == collectionId
        && request.resource.data.owner_id == me()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 80
        && collectionDescriptionOk(request.resource.data)
        && request.resource.data.visibility in ['private', 'public']
        && createdNow() && request.resource.data.updated_at == request.time;
      // NOTE: `visibility: 'public'` collections are still readable only by their owner
      // (product decision pending in issue #19); the field is stored but not yet honoured.
      allow update: if mayWrite() && resource.data.owner_id == me()
        && request.resource.data.owner_id == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'visibility', 'updated_at'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 80
        && collectionDescriptionOk(request.resource.data)
        && request.resource.data.visibility in ['private', 'public']
        && request.resource.data.updated_at == request.time;
      allow delete: if mayWrite() && resource.data.owner_id == me();
    }

    match /collection_items/{itemId} {
      // The client checks the deterministic item ID before its first create. Missing documents
      // contain no data; existing items and collection queries remain owner-only.
      allow get: if signedIn() && (resource == null || resource.data.owner_id == me());
      allow list: if signedIn() && resource.data.owner_id == me();
      allow create: if mayWrite()
        && onlyKeys(['collection_id', 'post_id', 'owner_id', 'sort_order', 'created_at'])
        && request.resource.data.owner_id == me()
        && itemId == request.resource.data.collection_id + '_' + request.resource.data.post_id
        && request.resource.data.sort_order is int
        && createdNow()
        && request.resource.data.post_id is string
        && !blockedOnPost(request.resource.data.post_id)
        && (postIsPublicActive(request.resource.data.post_id) || post(request.resource.data.post_id).creator_id == me())
        && get(/databases/$(database)/documents/collections/$(request.resource.data.collection_id)).data.owner_id == me();
      allow update: if false;
      allow delete: if mayWrite() && (resource == null || resource.data.owner_id == me());
    }

    match /moderation_flags/{flagId} {
      // submitReport binds trusted target metadata, idempotency and quotas in one transaction.
      allow read, write: if false;
    }

    match /activity_events/{eventId} {
      allow read: if signedIn() && resource.data.recipient_id == me()
        && resource.data.get('anonymous', false) != true;
      // Read state is written by markActivityRead; clients cannot alter server activity.
      allow create, update, delete: if false;
    }

    // Curated landmarks (functions/scripts/import-places.mjs); public read, operator-written only.
    match /places/{placeId} {
      allow read: if true;
      allow write: if false;
    }

    match /protected_zones/{zoneId} {
      allow read: if true;
      allow write: if false;
    }

    // analytics_events, admin_*, users_private writes, rate limits … server only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
